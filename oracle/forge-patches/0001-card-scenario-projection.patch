+        private void assertConsumed() {
+            assertTrue(outsideGameChoices.isEmpty(), "unconsumed outside-game choices for " + player.getName());
+            assertTrue(
+                    manaChoices.isEmpty(),
+                    "unconsumed mana payments for " + player.getName() + ": " + manaChoices);
+            Deque<Player> opponentChoices = opponentChoicesByChooser.get(player);
+            assertTrue(
