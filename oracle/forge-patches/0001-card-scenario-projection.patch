+    private void loadScript(
+            JsonObject scenario,
+            Map<String, Card> labels,
+            ScriptedController controller0,
+            ScriptedController controller1,
+            Player castingPlayer) {
+        for (JsonElement value : scenario.getAsJsonArray("script")) {
+            JsonObject action = value.getAsJsonObject();
+            if ("cast".equals(action.get("action").getAsString())
+                    && "Extrapolate the Impossible".equals(action.get("card").getAsString())) {
+                if (castingPlayer.getOpponents().size() != 1) {
+                    throw new IllegalStateException("ambiguous scripted opponent");
+                }
+                ScriptedController castingController = castingPlayer == controller0.getPlayer()
+                        ? controller0 : controller1;
+                castingController.addOpponentChoice(
+                        castingPlayer, castingPlayer.getOpponents().get(0));
+            }
+        }
+        for (JsonElement value : scenario.getAsJsonArray("script")) {
+            JsonObject action = value.getAsJsonObject();
+            String actionName = requiredString(action, "action");
+            if ("choose_outside_game".equals(actionName)) {
+                ScriptedController chooser = controllerFor(action, controller0, controller1);
+                List<String> choices = new ArrayList<>();
+                for (JsonElement label : action.getAsJsonArray("cards")) {
+                    Card card = labels.get(label.getAsString());
+                    if (card == null) {
+                        throw new IllegalArgumentException("unknown sideboard label " + label);
+                    }
+                    choices.add(card.getName());
+                }
+                boolean accept = action.get("accept").getAsBoolean();
+                if (accept && choices.isEmpty()) {
+                    chooser.expectNoOutsideGameChoice();
+                } else {
+                    chooser.addOutsideGameChoice(accept, choices);
+                }
+            } else if ("choose_mana".equals(actionName)) {
+                ScriptedController chooser = controllerFor(action, controller0, controller1);
+                List<String> sources = new ArrayList<>();
+                for (JsonElement source : action.getAsJsonArray("sources")) {
+                    sources.add(source.getAsString());
+                }
+                chooser.addManaChoices(sources);
+            }
+        }
+    }
+
+    private ScriptedController controllerFor(
+            JsonObject action, ScriptedController controller0, ScriptedController controller1) {
+        return switch (requiredString(action, "player")) {
+            case "P0" -> controller0;
+            case "P1" -> controller1;
+            default -> throw new IllegalArgumentException("choice player must be P0 or P1");
+        };
+    }
+
+    private void cast(Player player, String cardName, Map<String, Card> labels) {
+        Card card = player.getZone(ZoneType.Hand).getCards().stream()
+                .filter(candidate -> candidate.getName().equals(cardName))
+                .findFirst()
+                .orElseThrow(() -> new IllegalArgumentException("card not in hand: " + cardName));
+        SpellAbility spell = card.getSpellAbilities().stream()
+                .filter(SpellAbility::isSpell)
+                .findFirst()
+                .orElseThrow(() -> new IllegalArgumentException("no spell ability: " + cardName));
+        assertTrue(spell.canPlay(), cardName + " should be castable");
+        ScriptedController controller = (ScriptedController) player.getController();
+        Map<Integer, Integer> manaBefore = controller.hasManaChoices()
+                ? controller.manaSourceCounts() : null;
+        assertTrue(PlaySpellAbility.playSpellAbility(controller, player, spell));
+        if (manaBefore != null) controller.verifyManaSourcesSpent(manaBefore);
+    }
