+    private JsonArray battlefield(Game game, Map<String, Card> labels) {
+        List<JsonObject> permanents = new ArrayList<>();
+        for (Player player : game.getPlayers()) {
+            for (Card card : player.getZone(ZoneType.Battlefield).getCards()) {
+                JsonObject permanent = new JsonObject();
+                String label = labelForCard(card, labels);
+                if (label == null) permanent.add("label", com.google.gson.JsonNull.INSTANCE);
+                else permanent.addProperty("label", label);
+                permanent.addProperty("name", card.getName());
+                permanent.addProperty("token", card.isToken());
+                permanent.addProperty(
+                        "controller", "P" + game.getPlayers().indexOf(card.getController()));
+                permanent.addProperty("tapped", card.isTapped());
+                permanent.add("types", sortedStrings(card.getType().getCoreTypes().stream()
+                        .map(type -> type.name()).toList()));
+                permanent.add("subtypes", sortedStrings(card.getType().getSubtypes()));
+                permanent.add("colors", colors(card));
+                permanent.addProperty("damage", card.getDamage());
+                JsonObject counters = new JsonObject();
+                card.getCounters().entrySet().stream()
+                        .sorted(Comparator.comparing(entry -> projectedCounterName(entry.getElement())))
+                        .forEach(entry -> counters.addProperty(
+                                projectedCounterName(entry.getElement()), entry.getCount()));
+                permanent.add("counters", counters);
+                permanent.add(
+                        "power",
+                        card.isCreature()
+                                ? new com.google.gson.JsonPrimitive(card.getNetPower())
+                                : com.google.gson.JsonNull.INSTANCE);
+                permanent.add(
+                        "toughness",
+                        card.isCreature()
+                                ? new com.google.gson.JsonPrimitive(card.getNetToughness())
+                                : com.google.gson.JsonNull.INSTANCE);
+                int loyalty = card.getCounters(CounterEnumType.LOYALTY);
+                if (loyalty == 0) permanent.add("loyalty", com.google.gson.JsonNull.INSTANCE);
+                else permanent.addProperty("loyalty", loyalty);
+                permanents.add(permanent);
+            }
+        }
+        permanents.sort(Comparator.comparing(
+                permanent -> permanent.get("label").isJsonNull()
+                        ? "" : permanent.get("label").getAsString()));
+        JsonArray result = new JsonArray();
+        permanents.forEach(result::add);
+        return result;
+    }
+
+    private String labelForCard(Card target, Map<String, Card> labels) {
+        return labels.entrySet().stream()
+                .filter(entry -> entry.getValue() == target)
+                .map(Map.Entry::getKey)
+                .findFirst()
+                .orElse(null);
+    }
+
+    private JsonArray sortedStrings(Iterable<String> values) {
+        List<String> sorted = new ArrayList<>();
+        values.forEach(sorted::add);
+        sorted.sort(String::compareTo);
+        JsonArray result = new JsonArray();
+        sorted.forEach(result::add);
+        return result;
+    }
+
+    private JsonArray colors(Card card) {
+        List<String> colors = new ArrayList<>();
+        if (card.getColor().hasWhite()) colors.add("W");
+        if (card.getColor().hasBlue()) colors.add("U");
+        if (card.getColor().hasBlack()) colors.add("B");
+        if (card.getColor().hasRed()) colors.add("R");
+        if (card.getColor().hasGreen()) colors.add("G");
+        return sortedStrings(colors);
+    }
