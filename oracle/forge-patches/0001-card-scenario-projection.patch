+                throw failClosed("unscripted discard choice");
+            }
+            if (scripted.size() < min || scripted.size() > max) {
+                throw failClosed(
+                        "scripted discard count " + scripted.size() + " is outside " + min + ".." + max);
+            }
+            CardCollection selected = new CardCollection();
+            Set<Card> uniqueCards = java.util.Collections.newSetFromMap(new IdentityHashMap<>());
+            for (String label : scripted) {
