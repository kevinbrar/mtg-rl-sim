+public final class CardScenarioProjectionTest extends AITest {
+    private static final Gson GSON = new GsonBuilder().serializeNulls().create();
+    private static final String RESULT_PREFIX = "CARD_SCENARIO_RESULT:";
+    private static final String PROMPT_FAILURE_PREFIX = "CARD_SCENARIO_PROMPT_FAILURE:";
+
+    @Test
+    public void projectScenarios() throws IOException {
+        String specPath = System.getProperty("oracleScenarioSpec");
+        if (specPath == null || specPath.isBlank()) {
+            throw new IllegalArgumentException("-DoracleScenarioSpec is required");
+        }
+        JsonObject spec;
+        try (var reader = Files.newBufferedReader(Path.of(specPath))) {
+            spec = JsonParser.parseReader(reader).getAsJsonObject();
+        }
+        JsonArray scenarios = spec.getAsJsonArray("scenarios");
+        if (scenarios == null || scenarios.isEmpty()) {
+            throw new IllegalArgumentException("scenario spec must contain scenarios");
+        }
+        for (JsonElement value : scenarios) {
+            JsonObject scenario = value.getAsJsonObject();
+            try {
+                runScenario(scenario);
+            } catch (IllegalStateException error) {
+                if (!"unexpected Extrapolate outside-game prompt".equals(error.getMessage())) {
+                    throw error;
+                }
+                JsonObject failure = new JsonObject();
+                failure.addProperty("scenario", requiredString(scenario, "name"));
+                failure.addProperty("prompt", "outside_game");
+                System.out.println(PROMPT_FAILURE_PREFIX + GSON.toJson(failure));
+            }
+        }
+    }
+
+    private void runScenario(JsonObject scenario) {
+        int activePlayer = scenario.has("active_player")
+                ? scenario.get("active_player").getAsInt() : 0;
+        if (activePlayer < 0 || activePlayer > 1) {
+            throw new IllegalArgumentException("active_player must be 0 or 1");
+        }
+        if (!"precombat_main".equals(scenario.has("step")
+                ? scenario.get("step").getAsString() : "precombat_main")) {
+            throw new IllegalArgumentException("unsupported Forge scenario step");
+        }
+        validateSetup(scenario.getAsJsonObject("setup"));
+        MyRandom.setRandom(new Random(0xF04E));
+        long randomCalls = MyRandom.callCount();
+        Game game = initAndCreateGame();
+        Player p0 = game.getPlayers().get(0);
+        Player p1 = game.getPlayers().get(1);
+        game.getPhaseHandler().devModeSet(PhaseType.MAIN1, game.getPlayers().get(activePlayer));
+        game.getPhaseHandler().onStackResolved();
+
+        Map<String, Card> labels = new java.util.LinkedHashMap<>();
+        addSetup(game, scenario, labels);
+        ScriptedController controller0 = new ScriptedController(game, p0, p0.getLobbyPlayer(), labels);
+        ScriptedController controller1 = new ScriptedController(game, p1, p1.getLobbyPlayer(), labels);
+        p0.dangerouslySetController(controller0);
+        p1.dangerouslySetController(controller1);
+        loadScript(scenario, labels, controller0, controller1);
+
+        for (JsonElement value : scenario.getAsJsonArray("script")) {
+            JsonObject action = value.getAsJsonObject();
+            switch (requiredString(action, "action")) {
+                case "cast" -> cast(game.getPlayers().get(activePlayer), requiredString(action, "card"));
+                case "choose_outside_game", "choose_mana" -> { }
+                case "pass_until_resolved" -> {
+                    controller0.setPassingPriority(true);
+                    controller1.setPassingPriority(true);
+                    resolve(game);
+                    controller0.setPassingPriority(false);
+                    controller1.setPassingPriority(false);
+                }
+                default -> throw new IllegalArgumentException(
+                        "unsupported Forge scenario action " + action.get("action"));
+            }
+        }
+
+        controller0.assertConsumed();
+        controller1.assertConsumed();
+        assertEquals(MyRandom.callCount(), randomCalls, "scenario consumed Forge RNG");
+        boolean reached = checkReach(scenario, game);
+        JsonObject projection = projection(game, labels, reached);
+        JsonObject result = new JsonObject();
+        result.addProperty("scenario", requiredString(scenario, "name"));
+        result.add("projection", projection);
+        result.addProperty("reach", reached);
+        System.out.println(RESULT_PREFIX + GSON.toJson(result));
+        assertTrue(reached, "Forge reach assertions failed for " + scenario.get("name"));
+    }
