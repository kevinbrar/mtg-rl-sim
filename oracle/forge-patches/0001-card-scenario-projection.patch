+    private void addSetup(Game game, JsonObject scenario, Map<String, Card> labels) {
+        JsonObject setup = scenario.getAsJsonObject("setup");
+        for (int index = 0; index < 2; index++) {
+            Player player = game.getPlayers().get(index);
+            JsonObject playerSetup = setup.getAsJsonObject("P" + index);
+            if (playerSetup == null) continue;
+            if (playerSetup.has("life")) {
+                player.setStartingLife(exactInteger(
+                        playerSetup.get("life"), "setup.P" + index + ".life"));
+            }
+            addCards(player, playerSetup.getAsJsonArray("hand"), ZoneType.Hand, labels);
+            addCards(player, playerSetup.getAsJsonArray("library_top"), ZoneType.Library, labels);
+            addCards(player, playerSetup.getAsJsonArray("graveyard"), ZoneType.Graveyard, labels);
+            addCards(player, playerSetup.getAsJsonArray("sideboard"), ZoneType.Sideboard, labels);
+            addCards(player, playerSetup.getAsJsonArray("battlefield"), ZoneType.Battlefield, labels);
+            addCards(player, playerSetup.getAsJsonArray("exile"), ZoneType.Exile, labels);
+            addMana(player, playerSetup.getAsJsonArray("mana_pool"), labels);
+        }
+    }
+
+    private void addCards(Player player, JsonArray values, ZoneType zone, Map<String, Card> labels) {
+        if (values == null) return;
+        for (JsonElement value : values) {
+            JsonObject item = value.isJsonObject() ? value.getAsJsonObject() : null;
+            String cardName = item == null ? value.getAsString() : requiredString(item, "card");
+            Card card = addCardToZone(cardName, player, zone);
+            if (item != null && item.has("label")) {
+                labels.put(requiredString(item, "label"), card);
+            }
+            if (item != null && zone == ZoneType.Battlefield) {
+                if (item.has("tapped")) {
+                    card.setTapped(item.get("tapped").getAsBoolean());
+                }
+                if (item.has("counters")) {
+                    for (Map.Entry<String, JsonElement> counter
+                            : item.getAsJsonObject("counters").entrySet()) {
+                        card.setCounters(
+                                CounterType.getType(counter.getKey()),
+                                exactInteger(counter.getValue(), "battlefield counter"));
+                    }
+                }
+            }
+        }
+    }
+
+    private void addMana(Player player, JsonArray values, Map<String, Card> labels) {
+        if (values == null) return;
+        for (JsonElement value : values) {
+            JsonObject unit = value.getAsJsonObject();
+            if (unit.size() != 2 || !unit.has("color") || !unit.has("source")) {
+                throw new IllegalArgumentException("mana_pool entries need color and source");
+            }
+            String sourceLabel = requiredString(unit, "source");
+            Card source = labels.get(sourceLabel);
+            if (source == null || source.getController() != player || !source.isInPlay()) {
+                throw new IllegalArgumentException("mana_pool source is not on this player's battlefield: "
+                        + sourceLabel);
+            }
+            byte color = switch (requiredString(unit, "color")) {
+                case "W" -> (byte) ManaAtom.WHITE;
+                case "U" -> (byte) ManaAtom.BLUE;
+                case "B" -> (byte) ManaAtom.BLACK;
+                case "R" -> (byte) ManaAtom.RED;
+                case "G" -> (byte) ManaAtom.GREEN;
+                case "C" -> (byte) ManaAtom.COLORLESS;
+                default -> throw new IllegalArgumentException("unsupported mana_pool color");
+            };
+            player.getManaPool().addMana(new Mana(color, source, null, player));
+        }
+    }
