+        private boolean hasManaChoices() {
+            return !manaChoices.isEmpty();
+        }
+
+        private Map<Integer, Integer> manaSourceCounts() {
+            Map<Integer, Integer> counts = new java.util.HashMap<>();
+            for (Mana mana : player.getManaPool()) {
+                Card source = mana.getSourceCard();
+                if (source == null) throw new IllegalStateException("mana source is not a card");
+                counts.merge(source.getId(), 1, Integer::sum);
+            }
+            return counts;
+        }
+
+        private void verifyManaSourcesSpent(Map<Integer, Integer> before) {
+            ManaScriptPayment payment = manaChoices.removeFirst();
+            Map<Integer, Integer> after = manaSourceCounts();
+            Set<String> spent = new LinkedHashSet<>();
+            for (Map.Entry<Integer, Integer> entry : before.entrySet()) {
+                if (entry.getValue() <= after.getOrDefault(entry.getKey(), 0)) continue;
+                String label = labels.entrySet().stream()
+                        .filter(candidate -> candidate.getValue().getId() == entry.getKey())
+                        .map(Map.Entry::getKey)
+                        .findFirst()
+                        .orElseThrow(() -> new IllegalStateException("spent mana source is not labeled"));
+                spent.add(label);
+            }
+            assertEquals(spent, payment.expectedSources, "scripted mana sources spent");
+        }
