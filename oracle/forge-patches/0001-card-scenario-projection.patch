+        @Override
+        public Mana chooseManaFromPool(List<Mana> choices) {
+            if (manaChoices.isEmpty()) {
+                throw new IllegalStateException("unscripted mana choice");
+            }
+            ManaScriptPayment payment = manaChoices.peekFirst();
+            List<String> offeredSources = choices.stream()
+                    .map(Mana::getSourceCard)
+                    .map(this::labelForSource)
+                    .filter(java.util.Objects::nonNull)
+                    .distinct()
+                    .toList();
+            boolean wholeSetOffered = offeredSources.containsAll(payment.expectedSources);
+            System.out.println("CARD_SCENARIO_MANA_PROMPT: shape="
+                    + (wholeSetOffered ? "whole-set" : "partial-set")
+                    + " scripted=" + payment.sourceOrder + " offered=" + offeredSources);
+            if (payment.nextSource >= payment.sourceOrder.size()) {
+                throw new IllegalStateException("unscripted mana choice after scripted sources were used");
+            }
+            String sourceLabel = payment.sourceOrder.get(payment.nextSource);
+            Card source = labels.get(sourceLabel);
+            if (source == null) {
+                throw new IllegalStateException("unknown mana source label: " + sourceLabel);
+            }
+            Mana selected = choices.stream()
+                    .filter(mana -> mana.getSourceCard() != null
+                            && source.getId() == mana.getSourceCard().getId())
+                    .findFirst()
+                    .orElseThrow(() -> new IllegalStateException(
+                            "scripted mana source was not offered: " + sourceLabel));
+            payment.nextSource++;
+            return selected;
+        }
