+        private static final class ManaScriptPayment {
+            private final List<String> sourceOrder;
+            private final Set<String> expectedSources;
+            private int nextSource;
+
+            private ManaScriptPayment(List<String> sources) {
+                this.sourceOrder = List.copyOf(sources);
+                this.expectedSources = new LinkedHashSet<>(sources);
+                if (sources.isEmpty() || expectedSources.size() != sources.size()) {
+                    throw new IllegalArgumentException("mana sources must be non-empty and unique");
+                }
+            }
+        }
+
+        private void addOutsideGameChoice(boolean accept, List<String> cards) {
+            outsideGameChoices.addLast(new OutsideGameChoice(accept, cards));
+        }
+
+        private void addOpponentChoice(Player chooser, Player opponent) {
+            opponentChoicesByChooser.computeIfAbsent(chooser, ignored -> new ArrayDeque<>())
+                    .addLast(opponent);
+        }
+
+        private Player consumeScriptedOpponent(Player chooser) {
+            if (chooser.getOpponents().size() != 1) {
+                throw new IllegalStateException("ambiguous scripted opponent");
+            }
+            Player opponent = chooser.getOpponents().get(0);
+            Deque<Player> choices = opponentChoicesByChooser.get(chooser);
+            if (choices == null || choices.isEmpty()) {
+                throw new IllegalStateException("unscripted opponent selection");
+            }
+            if (choices.peekFirst() != opponent) {
+                throw new IllegalStateException("scripted opponent does not match the caster's opponent");
+            }
+            choices.removeFirst();
+            if (choices.isEmpty()) opponentChoicesByChooser.remove(chooser);
+            return opponent;
+        }
+
+        private void expectNoOutsideGameChoice() {
+            if (noOutsideGameChoiceExpected) {
+                throw new IllegalStateException("duplicate no-outside-game-choice expectation");
+            }
+            noOutsideGameChoiceExpected = true;
+        }
+
+        private void addManaChoices(List<String> sources) {
