+    private static String projectedCounterName(CounterType counterType) {
+        if (counterType.is(CounterEnumType.P1P1)) return "P1P1";
+        if (counterType.is(CounterEnumType.M1M1)) return "M1M1";
+        if (counterType.is(CounterEnumType.LOYALTY)) return "loyalty";
+        return counterType.getName().toLowerCase(java.util.Locale.ROOT);
+    }
