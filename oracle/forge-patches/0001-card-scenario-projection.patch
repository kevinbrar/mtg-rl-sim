+    private void validateSetup(JsonObject setup) {
+        if (setup == null) throw new IllegalArgumentException("scenario setup is required");
+        for (String player : setup.keySet()) {
+            if (!"P0".equals(player) && !"P1".equals(player)) {
+                throw new IllegalArgumentException("unsupported Forge setup player " + player);
+            }
+            JsonObject playerSetup = setup.getAsJsonObject(player);
+            for (String zone : playerSetup.keySet()) {
+                if (!List.of(
+                        "hand", "library_top", "graveyard", "sideboard", "battlefield", "mana_pool")
+                        .contains(zone)) {
+                    throw new IllegalArgumentException("unsupported Forge setup field " + zone);
+                }
+            }
+        }
+    }
+
+    private void addSetup(Game game, JsonObject scenario, Map<String, Card> labels) {
+        JsonObject setup = scenario.getAsJsonObject("setup");
+        for (int index = 0; index < 2; index++) {
+            Player player = game.getPlayers().get(index);
+            JsonObject playerSetup = setup.getAsJsonObject("P" + index);
+            if (playerSetup == null) continue;
+            addCards(player, playerSetup.getAsJsonArray("hand"), ZoneType.Hand, labels);
+            addCards(player, playerSetup.getAsJsonArray("library_top"), ZoneType.Library, labels);
+            addCards(player, playerSetup.getAsJsonArray("graveyard"), ZoneType.Graveyard, labels);
+            addCards(player, playerSetup.getAsJsonArray("sideboard"), ZoneType.Sideboard, labels);
+            addCards(player, playerSetup.getAsJsonArray("battlefield"), ZoneType.Battlefield, labels);
+            addMana(player, playerSetup.getAsJsonArray("mana_pool"), labels);
+        }
+    }
+
+    private void addCards(Player player, JsonArray values, ZoneType zone, Map<String, Card> labels) {
+        if (values == null) return;
+        for (JsonElement value : values) {
+            JsonObject item = value.isJsonObject() ? value.getAsJsonObject() : null;
+            String cardName = item == null ? value.getAsString() : requiredString(item, "card");
+            Card card = addCardToZone(cardName, player, zone);
+            if (item != null && item.has("label")) {
+                labels.put(requiredString(item, "label"), card);
+            }
+            if (item != null && item.has("tapped")) {
+                card.setTapped(item.get("tapped").getAsBoolean());
+            }
+        }
+    }
+
+    private void addMana(Player player, JsonArray values, Map<String, Card> labels) {
+        if (values == null) return;
+        for (JsonElement value : values) {
+            JsonObject unit = value.getAsJsonObject();
+            if (unit.size() != 2 || !unit.has("color") || !unit.has("source")) {
+                throw new IllegalArgumentException("mana_pool entries need color and source");
+            }
+            String sourceLabel = requiredString(unit, "source");
+            Card source = labels.get(sourceLabel);
+            if (source == null || source.getController() != player || !source.isInPlay()) {
+                throw new IllegalArgumentException("mana_pool source is not on this player's battlefield: "
+                        + sourceLabel);
+            }
+            byte color = switch (requiredString(unit, "color")) {
+                case "W" -> (byte) ManaAtom.WHITE;
+                case "U" -> (byte) ManaAtom.BLUE;
+                case "B" -> (byte) ManaAtom.BLACK;
+                case "R" -> (byte) ManaAtom.RED;
+                case "G" -> (byte) ManaAtom.GREEN;
+                case "C" -> (byte) ManaAtom.COLORLESS;
+                default -> throw new IllegalArgumentException("unsupported mana_pool color");
+            };
+            player.getManaPool().addMana(new Mana(color, source, null, player));
+        }
+    }
+
+    private void loadScript(
+            JsonObject scenario,
+            Map<String, Card> labels,
+            ScriptedController controller0,
+            ScriptedController controller1) {
+        for (JsonElement value : scenario.getAsJsonArray("script")) {
+            JsonObject action = value.getAsJsonObject();
+            String actionName = requiredString(action, "action");
+            if ("choose_outside_game".equals(actionName)) {
+                ScriptedController chooser = controllerFor(action, controller0, controller1);
+                List<String> choices = new ArrayList<>();
+                for (JsonElement label : action.getAsJsonArray("cards")) {
+                    Card card = labels.get(label.getAsString());
+                    if (card == null) {
+                        throw new IllegalArgumentException("unknown sideboard label " + label);
+                    }
+                    choices.add(card.getName());
+                }
+                boolean accept = action.get("accept").getAsBoolean();
+                if (accept && choices.isEmpty()) {
+                    chooser.expectNoOutsideGameChoice();
+                } else {
+                    chooser.addOutsideGameChoice(accept, choices);
+                }
+            } else if ("choose_mana".equals(actionName)) {
+                ScriptedController chooser = controllerFor(action, controller0, controller1);
+                List<String> sources = new ArrayList<>();
+                for (JsonElement source : action.getAsJsonArray("sources")) {
+                    sources.add(source.getAsString());
+                }
+                chooser.addManaChoices(sources);
+            }
+        }
+    }
+
+    private ScriptedController controllerFor(
+            JsonObject action, ScriptedController controller0, ScriptedController controller1) {
+        return switch (requiredString(action, "player")) {
+            case "P0" -> controller0;
+            case "P1" -> controller1;
+            default -> throw new IllegalArgumentException("choice player must be P0 or P1");
+        };
+    }
+
+    private void cast(Player player, String cardName) {
+        Card card = player.getZone(ZoneType.Hand).getCards().stream()
+                .filter(candidate -> candidate.getName().equals(cardName))
+                .findFirst()
+                .orElseThrow(() -> new IllegalArgumentException("card not in hand: " + cardName));
+        SpellAbility spell = card.getSpellAbilities().stream()
+                .filter(SpellAbility::isSpell)
+                .findFirst()
+                .orElseThrow(() -> new IllegalArgumentException("no spell ability: " + cardName));
+        assertTrue(spell.canPlay(), cardName + " should be castable");
+        assertTrue(PlaySpellAbility.playSpellAbility(player.getController(), player, spell));
+    }
+
+    private void resolve(Game game) {
+        int remaining = 30;
+        while ((!game.getStack().isEmpty() || game.getStack().hasSimultaneousStackEntries()
+                || game.getTriggerHandler().getWaitingTriggerCount() > 0) && remaining-- > 0) {
+            if (!game.getStack().isEmpty()) {
+                playUntilStackClear(game);
+            } else if (game.getStack().hasSimultaneousStackEntries()) {
+                game.getPhaseHandler().mainLoopStep();
+            }
+            game.getTriggerHandler().runWaitingTriggers();
+        }
+        assertTrue(game.getStack().isEmpty(), "stack did not clear");
+        assertTrue(!game.getStack().hasSimultaneousStackEntries(), "simultaneous stack did not clear");
+        assertEquals(game.getTriggerHandler().getWaitingTriggerCount(), 0);
+    }
+
+    private JsonObject projection(Game game, Map<String, Card> labels, boolean reached) {
+        JsonObject players = new JsonObject();
+        for (int index = 0; index < 2; index++) {
+            Player player = game.getPlayers().get(index);
+            JsonObject zones = new JsonObject();
+            zones.addProperty("life", player.getLife());
+            zones.add("battlefield", names(player, ZoneType.Battlefield));
+            zones.add("hand", names(player, ZoneType.Hand));
+            zones.add("library", names(player, ZoneType.Library));
+            zones.add("graveyard", names(player, ZoneType.Graveyard));
+            JsonArray sideboard = names(player, ZoneType.Sideboard);
+            if (!sideboard.isEmpty()) zones.add("sideboard", sideboard);
+            players.add("P" + index, zones);
+        }
+        JsonObject projection = new JsonObject();
+        projection.add("players", players);
+        projection.add("battlefield", battlefield(game, labels));
+        projection.add("exile", new JsonArray());
+        projection.add("legal_targets", com.google.gson.JsonNull.INSTANCE);
+        projection.addProperty("reach", reached);
+        return projection;
+    }
+
+    private JsonArray names(Player player, ZoneType zone) {
+        List<String> names = player.getZone(zone).getCards().stream()
+                .map(Card::getName)
+                .sorted()
+                .toList();
+        JsonArray result = new JsonArray();
+        names.forEach(result::add);
+        return result;
+    }
+
+    private JsonArray battlefield(Game game, Map<String, Card> labels) {
+        List<JsonObject> permanents = new ArrayList<>();
+        for (Player player : game.getPlayers()) {
+            for (Card card : player.getZone(ZoneType.Battlefield).getCards()) {
+                JsonObject permanent = new JsonObject();
+                String label = labelForCard(card, labels);
+                if (label == null) permanent.add("label", com.google.gson.JsonNull.INSTANCE);
+                else permanent.addProperty("label", label);
+                permanent.addProperty("name", card.getName());
+                permanent.addProperty("token", card.isToken());
+                permanent.addProperty(
+                        "controller", "P" + game.getPlayers().indexOf(card.getController()));
+                permanent.addProperty("tapped", card.isTapped());
+                permanent.add("types", sortedStrings(card.getType().getCoreTypes().stream()
+                        .map(type -> type.name()).toList()));
+                permanent.add("subtypes", sortedStrings(card.getType().getSubtypes()));
+                permanent.add("colors", colors(card));
+                permanent.addProperty("damage", card.getDamage());
+                permanent.add("counters", new JsonObject());
+                permanent.add(
+                        "power",
+                        card.isCreature()
+                                ? new com.google.gson.JsonPrimitive(card.getNetPower())
+                                : com.google.gson.JsonNull.INSTANCE);
+                permanent.add(
+                        "toughness",
+                        card.isCreature()
+                                ? new com.google.gson.JsonPrimitive(card.getNetToughness())
+                                : com.google.gson.JsonNull.INSTANCE);
+                permanent.add("loyalty", com.google.gson.JsonNull.INSTANCE);
+                permanents.add(permanent);
+            }
+        }
+        permanents.sort(Comparator.comparing(
+                permanent -> permanent.get("label").isJsonNull()
+                        ? "" : permanent.get("label").getAsString()));
+        JsonArray result = new JsonArray();
+        permanents.forEach(result::add);
+        return result;
+    }
+
+    private String labelForCard(Card target, Map<String, Card> labels) {
+        return labels.entrySet().stream()
+                .filter(entry -> entry.getValue() == target)
+                .map(Map.Entry::getKey)
+                .findFirst()
+                .orElse(null);
+    }
+
+    private JsonArray sortedStrings(Iterable<String> values) {
+        List<String> sorted = new ArrayList<>();
+        values.forEach(sorted::add);
+        sorted.sort(String::compareTo);
+        JsonArray result = new JsonArray();
+        sorted.forEach(result::add);
+        return result;
+    }
+
+    private JsonArray colors(Card card) {
+        List<String> colors = new ArrayList<>();
+        if (card.getColor().hasWhite()) colors.add("W");
+        if (card.getColor().hasBlue()) colors.add("U");
+        if (card.getColor().hasBlack()) colors.add("B");
+        if (card.getColor().hasRed()) colors.add("R");
+        if (card.getColor().hasGreen()) colors.add("G");
+        return sortedStrings(colors);
+    }
+
+    private boolean checkReach(JsonObject scenario, Game game) {
+        JsonObject reach = scenario.getAsJsonObject("reach");
+        if (reach == null || !reach.has("all")) return true;
+        for (JsonElement value : reach.getAsJsonArray("all")) {
+            JsonObject assertion = value.getAsJsonObject();
+            int playerIndex = assertion.has("player")
+                    ? Integer.parseInt(assertion.get("player").getAsString().substring(1)) : 0;
+            String zoneName = assertion.has("zone") ? assertion.get("zone").getAsString() : "graveyard";
+            ZoneType zone = switch (zoneName) {
+                case "hand" -> ZoneType.Hand;
+                case "library" -> ZoneType.Library;
+                case "sideboard" -> ZoneType.Sideboard;
+                case "graveyard" -> ZoneType.Graveyard;
+                case "battlefield" -> ZoneType.Battlefield;
+                case "exile" -> ZoneType.Exile;
+                default -> throw new IllegalArgumentException("unsupported Forge reach zone " + zoneName);
+            };
+            String cardName = requiredString(assertion, "card");
+            long count = game.getPlayers().get(playerIndex).getZone(zone).getCards().stream()
+                    .filter(card -> card.getName().equals(cardName)).count();
+            if (assertion.has("count") && count != assertion.get("count").getAsLong()) return false;
+            if (!assertion.has("count") && count == 0) return false;
+        }
+        return true;
+    }
+
+    private static String requiredString(JsonObject value, String key) {
+        if (!value.has(key) || !value.get(key).isJsonPrimitive()
+                || !value.getAsJsonPrimitive(key).isString()
+                || value.get(key).getAsString().isBlank()) {
+            throw new IllegalArgumentException("missing string " + key);
+        }
+        return value.get(key).getAsString();
+    }
