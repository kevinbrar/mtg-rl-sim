+    private boolean checkReach(JsonObject scenario, Game game) {
+        JsonObject reach = scenario.getAsJsonObject("reach");
+        if (reach == null || !reach.has("all")) return true;
+        for (JsonElement value : reach.getAsJsonArray("all")) {
+            JsonObject assertion = value.getAsJsonObject();
+            int playerIndex = assertion.has("player")
+                    ? Integer.parseInt(assertion.get("player").getAsString().substring(1)) : 0;
+            String zoneName = assertion.has("zone") ? assertion.get("zone").getAsString() : "graveyard";
+            ZoneType zone = switch (zoneName) {
+                case "hand" -> ZoneType.Hand;
+                case "library" -> ZoneType.Library;
+                case "sideboard" -> ZoneType.Sideboard;
+                case "graveyard" -> ZoneType.Graveyard;
+                case "battlefield" -> ZoneType.Battlefield;
+                case "exile" -> ZoneType.Exile;
+                default -> throw new IllegalArgumentException("unsupported Forge reach zone " + zoneName);
+            };
+            String cardName = requiredString(assertion, "card");
+            long count = game.getPlayers().get(playerIndex).getZone(zone).getCards().stream()
+                    .filter(card -> card.getName().equals(cardName)).count();
+            if (assertion.has("count") && count != assertion.get("count").getAsLong()) return false;
+            if (!assertion.has("count") && count == 0) return false;
+        }
+        return true;
+    }
+
+    private static String requiredString(JsonObject value, String key) {
+        if (!value.has(key) || !value.get(key).isJsonPrimitive()
+                || !value.getAsJsonPrimitive(key).isString()
+                || value.get(key).getAsString().isBlank()) {
+            throw new IllegalArgumentException("missing string " + key);
+        }
+        return value.get(key).getAsString();
+    }
