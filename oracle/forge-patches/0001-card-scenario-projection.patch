+    private boolean checkReach(JsonObject scenario, Game game, Map<String, Card> labels) {
+        JsonObject reach = scenario.getAsJsonObject("reach");
+        if (reach == null) return true;
+        if (reach.has("life")) {
+            int playerIndex = reach.has("player")
+                    ? Integer.parseInt(reach.get("player").getAsString().substring(1)) : 0;
+            if (game.getPlayers().get(playerIndex).getLife()
+                    != exactInteger(reach.get("life"), "reach.life")) return false;
+        }
+        if (!reach.has("all") && !reach.has("card")) return true;
+        JsonArray assertions = reach.has("all") ? reach.getAsJsonArray("all") : new JsonArray();
+        if (!reach.has("all")) assertions.add(reach);
+        for (JsonElement value : assertions) {
+            if (!value.isJsonObject()) {
+                throw new IllegalArgumentException("Forge reach assertions must be objects");
+            }
+            JsonObject assertion = value.getAsJsonObject();
+            int playerIndex = assertion.has("player")
+                    ? Integer.parseInt(assertion.get("player").getAsString().substring(1)) : 0;
+            if (playerIndex < 0 || playerIndex > 1) {
+                throw new IllegalArgumentException("reach player must be P0 or P1");
+            }
+            String zoneName = assertion.has("zone") ? assertion.get("zone").getAsString() : "graveyard";
+            ZoneType zone = switch (zoneName) {
+                case "hand" -> ZoneType.Hand;
+                case "library" -> ZoneType.Library;
+                case "sideboard" -> ZoneType.Sideboard;
+                case "graveyard" -> ZoneType.Graveyard;
+                case "battlefield" -> ZoneType.Battlefield;
+                case "exile" -> ZoneType.Exile;
+                default -> throw new IllegalArgumentException("unsupported Forge reach zone " + zoneName);
+            };
+            String cardName = requiredString(assertion, "card");
+            String expectedLabel = assertion.has("label")
+                    ? requiredString(assertion, "label") : null;
+            if (expectedLabel != null && zone != ZoneType.Battlefield) {
+                throw new IllegalArgumentException(
+                        "reach.label is only valid for battlefield permanents");
+            }
+            if (expectedLabel != null && !labels.containsKey(expectedLabel)) {
+                throw new IllegalArgumentException("unknown battlefield label " + expectedLabel);
+            }
+            long count = game.getPlayers().get(playerIndex).getZone(zone).getCards().stream()
+                    .filter(card -> projectedName(card).equals(cardName))
+                    .filter(card -> expectedLabel == null
+                            || expectedLabel.equals(labelForCard(card, labels)))
+                    .filter(card -> zone != ZoneType.Battlefield
+                            || matchesReachCharacteristics(card, assertion))
+                    .count();
+            if (assertion.has("count")
+                    && count != exactInteger(assertion.get("count"), "reach.count")) return false;
+            if (!assertion.has("count") && count == 0) return false;
+        }
+        return true;
+    }
+
+    private boolean matchesReachCharacteristics(Card card, JsonObject assertion) {
+        if (assertion.has("token")) {
+            if (!assertion.get("token").isJsonPrimitive()
+                    || !assertion.getAsJsonPrimitive("token").isBoolean()) {
+                throw new IllegalArgumentException("reach.token must be a boolean");
+            }
+            if (card.isToken() != assertion.get("token").getAsBoolean()) return false;
+        }
+        if (assertion.has("types")
+                && !sortedStrings(card.getType().getCoreTypes().stream()
+                        .map(Enum::name).toList())
+                        .equals(sortedJsonStrings(assertion.getAsJsonArray("types")))) return false;
+        if (assertion.has("subtypes")
+                && !sortedStrings(card.getType().getSubtypes())
+                        .equals(sortedJsonStrings(assertion.getAsJsonArray("subtypes")))) return false;
+        if (assertion.has("colors")
+                && !colors(card).equals(sortedJsonStrings(assertion.getAsJsonArray("colors")))) return false;
+        if (assertion.has("tapped")) {
+            if (!assertion.get("tapped").isJsonPrimitive()
+                    || !assertion.getAsJsonPrimitive("tapped").isBoolean()) {
+                throw new IllegalArgumentException("reach.tapped must be a boolean");
+            }
+            if (card.isTapped() != assertion.get("tapped").getAsBoolean()) return false;
+        }
+        if (assertion.has("counters")) {
+            JsonObject expectedCounters = assertion.getAsJsonObject("counters");
+            for (Map.Entry<String, JsonElement> entry : expectedCounters.entrySet()) {
+                CounterType counterType = CounterType.getType(entry.getKey());
+                if (counterType == null) {
+                    throw new IllegalArgumentException("unsupported reach counter " + entry.getKey());
+                }
+                if (card.getCounters(counterType)
+                        != exactInteger(entry.getValue(), "reach.counters." + entry.getKey())) return false;
+            }
+        }
+        return true;
+    }
+
+    private JsonArray sortedJsonStrings(JsonArray values) {
+        List<String> strings = new ArrayList<>();
+        for (JsonElement value : values) {
+            if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isString()) {
+                throw new IllegalArgumentException("Forge reach string values must be strings");
+            }
+            strings.add(value.getAsString());
+        }
+        return sortedStrings(strings);
+    }
+
+    private static String requiredString(JsonObject value, String key) {
+        if (!value.has(key) || !value.get(key).isJsonPrimitive()
+                || !value.getAsJsonPrimitive(key).isString()
+                || value.get(key).getAsString().isBlank()) {
+            throw new IllegalArgumentException("missing string " + key);
+        }
+        return value.get(key).getAsString();
+    }
