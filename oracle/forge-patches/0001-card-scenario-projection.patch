+    private JsonArray sortedStrings(Iterable<String> values) {
+        List<String> sorted = new ArrayList<>();
+        values.forEach(sorted::add);
+        sorted.sort(String::compareTo);
+        JsonArray result = new JsonArray();
+        sorted.forEach(result::add);
