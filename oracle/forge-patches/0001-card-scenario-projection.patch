+            if (ability != null
+                    && "Extrapolate the Impossible".equals(ability.getHostCard().getName())
+                    && origin.contains(ZoneType.Sideboard)) {
+                if (choices.isEmpty()) {
+                    return null;
+                }
+                outsideGameChoiceObserved = true;
+                if (noOutsideGameChoiceExpected) {
+                    throw new IllegalStateException("unexpected Extrapolate outside-game prompt");
