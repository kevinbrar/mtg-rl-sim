+    private static final class ScriptedController extends PlayerControllerForTests {
+        private final Deque<OutsideGameChoice> outsideGameChoices = new ArrayDeque<>();
+        private final Deque<String> manaChoices = new ArrayDeque<>();
+        private final Map<String, Card> labels;
+        private boolean noOutsideGameChoiceExpected;
+        private boolean outsideGameChoiceObserved;
+        private boolean pendingOutsideGameCancellation;
+        private boolean passingPriority;
+        private boolean opponentChoiceConsumed;
+
+        private ScriptedController(
+                Game game, Player player, LobbyPlayer lobbyPlayer, Map<String, Card> labels) {
+            super(game, player, lobbyPlayer);
+            this.labels = labels;
+        }
+
+        private void addOutsideGameChoice(boolean accept, List<String> cards) {
+            outsideGameChoices.addLast(new OutsideGameChoice(accept, cards));
+        }
+
+        private void expectNoOutsideGameChoice() {
+            if (noOutsideGameChoiceExpected) {
+                throw new IllegalStateException("duplicate no-outside-game-choice expectation");
+            }
+            noOutsideGameChoiceExpected = true;
+        }
+
+        private void addManaChoices(List<String> sources) {
+            manaChoices.addAll(sources);
+        }
+
+        private void setPassingPriority(boolean value) {
+            passingPriority = value;
+        }
+
+        private void assertConsumed() {
+            assertTrue(outsideGameChoices.isEmpty(), "unconsumed outside-game choices for " + player.getName());
+            assertTrue(
+                    manaChoices.isEmpty(),
+                    "unconsumed mana choices for " + player.getName() + ": " + manaChoices);
+            assertTrue(!pendingOutsideGameCancellation, "unconsumed outside-game cancellation");
+            if (noOutsideGameChoiceExpected) {
+                assertTrue(!outsideGameChoiceObserved, "unexpected outside-game prompt for " + player.getName());
+                noOutsideGameChoiceExpected = false;
+            }
+        }
+
+        @Override
+        public SpellAbility getAbilityToPlay(Card host, List<SpellAbility> abilities, ITriggerEvent triggerEvent) {
+            if (abilities.size() == 1) return abilities.get(0);
+            throw new IllegalStateException("unscripted getAbilityToPlay: " + host.getName());
+        }
+
+        @Override
+        public List<SpellAbility> chooseSpellAbilityToPlay() {
+            if (!passingPriority) throw new IllegalStateException("unscripted priority choice");
+            return null;
+        }
+
+        @Override
+        public boolean chooseTargetsFor(SpellAbility ability) {
+            throw new IllegalStateException("unscripted targets: " + ability.getHostCard().getName());
+        }
+
+        @Override
+        public List<SpellAbility> orderSimultaneousSa(List<SpellAbility> abilities) {
+            if (abilities.size() != 1) {
+                throw new IllegalStateException("unscripted simultaneous trigger order");
+            }
+            return abilities;
+        }
+
+        @Override
+        public void orderAndPlaySimultaneousSa(List<SpellAbility> abilities) {
+            List<SpellAbility> ordered = orderSimultaneousSa(abilities);
+            for (int index = ordered.size() - 1; index >= 0; index--) {
+                SpellAbility ability = ordered.get(index);
+                if (ability.isTrigger() && !ability.isCopied()) {
+                    PlaySpellAbility.playSpellAbility(this, player, ability);
+                } else {
+                    getGame().getStack().add(ability);
+                }
+            }
+        }
+
+        @Override
+        public boolean playTrigger(Card host, WrappedAbility ability, boolean mandatory) {
+            return PlaySpellAbility.playSpellAbilityNoStack(
+                    this, ability.getActivatingPlayer(), ability, false);
+        }
+
+        @Override
+        public void playSpellAbilityNoStack(SpellAbility ability, boolean mayChooseNewTargets) {
+            PlaySpellAbility.playSpellAbilityNoStack(this, player, ability, !mayChooseNewTargets);
+        }
+
+        @Override
+        public Card chooseSingleCardForZoneChange(
+                ZoneType destination, List<ZoneType> origin, SpellAbility ability, CardCollection choices,
+                DelayedReveal reveal, String selectPrompt, boolean optional, Player decider) {
+            if (ability != null
+                    && "Extrapolate the Impossible".equals(ability.getHostCard().getName())
+                    && origin.contains(ZoneType.Sideboard)) {
+                if (choices.isEmpty()) {
+                    return null;
+                }
+                outsideGameChoiceObserved = true;
+                if (noOutsideGameChoiceExpected) {
+                    throw new IllegalStateException("unexpected Extrapolate outside-game prompt");
+                }
+            }
+            if (outsideGameChoices.isEmpty()) {
+                throw new IllegalStateException("unscripted outside-game card choice: " + selectPrompt);
+            }
+            OutsideGameChoice group = outsideGameChoices.peekFirst();
+            if (!group.accept()) {
+                if (!optional) throw new IllegalStateException("empty choice for mandatory prompt");
+                if (pendingOutsideGameCancellation) {
+                    throw new IllegalStateException("duplicate pending outside-game cancellation");
+                }
+                pendingOutsideGameCancellation = true;
+                return null;
+            }
+            if (group.cards().isEmpty()) {
+                throw new IllegalStateException("accepted outside-game prompt has no scripted card");
+            }
+            String expected = group.cards().remove(0);
+            Card selected = choices.stream()
+                    .filter(card -> card.getName().equals(expected))
+                    .findFirst()
+                    .orElseThrow(() -> new IllegalStateException("scripted card not offered: " + expected));
+            if (group.cards().isEmpty()) outsideGameChoices.removeFirst();
+            return selected;
+        }
