     /** Number of random draws made so far on the current thread's stream. Used by undo to detect that randomness was consumed. */
     public static long callCount() { return random.get().callCount(); }
 
+    public static void withScenarioRngGuard(Runnable scenario) {
+        boolean previous = SCENARIO_RNG_GUARD.get();
+        SCENARIO_RNG_GUARD.set(true);
+        try {
+            scenario.run();
+        } finally {
+            SCENARIO_RNG_GUARD.set(previous);
+        }
+    }
+
+    private static boolean isTokenArtSelection() {
+        int aggregates = -1;
+        int tokenDb = -1;
+        for (StackTraceElement frame : Thread.currentThread().getStackTrace()) {
+            if (aggregates < 0
+                    && "forge.util.Aggregates".equals(frame.getClassName())
+                    && "random".equals(frame.getMethodName())) {
+                aggregates = 1;
+            } else if (aggregates == 1
+                    && tokenDb < 0
+                    && "forge.token.TokenDb".equals(frame.getClassName())
+                    && "getToken".equals(frame.getMethodName())) {
+                tokenDb = 1;
+            } else if (tokenDb == 1
+                    && "forge.game.card.token.TokenInfo".equals(frame.getClassName())
+                    && "getProtoType".equals(frame.getMethodName())) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static String describeCallStack() {
+        final StringBuilder description = new StringBuilder();
+        int included = 0;
+        for (StackTraceElement frame : Thread.currentThread().getStackTrace()) {
+            final String className = frame.getClassName();
+            if (className.startsWith("java.") || className.startsWith("jdk.")
+                    || className.startsWith("forge.util.MyRandom")) {
+                continue;
+            }
+            if (description.length() > 0) description.append(" <- ");
+            description.append(className).append('.').append(frame.getMethodName())
+                    .append(':').append(frame.getLineNumber());
+            if (++included == 5) break;
+        }
+        return description.toString();
+    }
+
