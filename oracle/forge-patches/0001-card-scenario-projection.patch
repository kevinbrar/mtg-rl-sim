+    private void validateSetup(JsonObject setup) {
+        if (setup == null) throw new IllegalArgumentException("scenario setup is required");
+        java.util.Set<String> playerFields = java.util.Set.of(
+                "life", "battlefield", "hand", "library_top", "graveyard", "sideboard",
+                "mana_pool", "exile");
+        java.util.Set<String> cardFields = java.util.Set.of("card", "label");
+        java.util.Set<String> permanentFields = java.util.Set.of("label", "card", "tapped", "counters");
+        java.util.Set<String> manaFields = java.util.Set.of("color", "source");
+        java.util.Set<String> labels = new java.util.LinkedHashSet<>();
+        for (String player : setup.keySet()) {
+            if (!"P0".equals(player) && !"P1".equals(player)) {
+                throw new IllegalArgumentException("unsupported Forge setup player " + player);
+            }
+            if (!setup.get(player).isJsonObject()) {
+                throw new IllegalArgumentException("setup." + player + " must be an object");
+            }
+            JsonObject playerSetup = setup.getAsJsonObject(player);
+            for (String field : playerSetup.keySet()) {
+                if (!playerFields.contains(field)) {
+                    throw new IllegalArgumentException(
+                            "unsupported Forge setup field setup." + player + "." + field);
+                }
+            }
+            if (playerSetup.has("life")) {
+                exactInteger(playerSetup.get("life"), "setup." + player + ".life");
+            }
+            for (String zone : List.of("hand", "library_top", "graveyard", "sideboard", "exile")) {
+                if (!playerSetup.has(zone)) continue;
+                JsonElement values = playerSetup.get(zone);
+                if (!values.isJsonArray()) {
+                    throw new IllegalArgumentException("setup." + player + "." + zone + " must be an array");
+                }
+                JsonArray cards = values.getAsJsonArray();
+                for (int index = 0; index < cards.size(); index++) {
+                    JsonElement value = cards.get(index);
+                    String context = "setup." + player + "." + zone + "[" + index + "]";
+                    if (value.isJsonPrimitive() && value.getAsJsonPrimitive().isString()) {
+                        requiredStringValue(value, context);
+                        continue;
+                    }
+                    if (!value.isJsonObject()) {
+                        throw new IllegalArgumentException(context + " must name a card");
+                    }
+                    JsonObject item = value.getAsJsonObject();
+                    rejectUnknownKeys(item, cardFields, context);
+                    requiredString(item, "card");
+                    if (item.has("label")) addSetupLabel(labels, requiredString(item, "label"));
+                }
+            }
+            java.util.Set<String> battlefieldLabels = new java.util.LinkedHashSet<>();
+            if (playerSetup.has("battlefield")) {
+                JsonElement values = playerSetup.get("battlefield");
+                if (!values.isJsonArray()) {
+                    throw new IllegalArgumentException("setup." + player + ".battlefield must be an array");
+                }
+                JsonArray battlefield = values.getAsJsonArray();
+                for (int index = 0; index < battlefield.size(); index++) {
+                    JsonElement value = battlefield.get(index);
+                    String context = "setup." + player + ".battlefield[" + index + "]";
+                    if (!value.isJsonObject()) {
+                        throw new IllegalArgumentException(context + " must be an object");
+                    }
+                    JsonObject permanent = value.getAsJsonObject();
+                    rejectUnknownKeys(permanent, permanentFields, context);
+                    requiredString(permanent, "card");
+                    String label = requiredString(permanent, "label");
+                    addSetupLabel(labels, label);
+                    battlefieldLabels.add(label);
+                    if (permanent.has("tapped")
+                            && (!permanent.get("tapped").isJsonPrimitive()
+                                    || !permanent.getAsJsonPrimitive("tapped").isBoolean())) {
+                        throw new IllegalArgumentException(context + ".tapped must be a boolean");
+                    }
+                    if (permanent.has("counters")) {
+                        JsonElement countersValue = permanent.get("counters");
+                        if (!countersValue.isJsonObject()) {
+                            throw new IllegalArgumentException(context + ".counters must be an object");
+                        }
+                        for (Map.Entry<String, JsonElement> counter
+                                : countersValue.getAsJsonObject().entrySet()) {
+                            String counterName = counter.getKey();
+                            if (counterName.isBlank()) {
+                                throw new IllegalArgumentException(context + ".counters needs counter names");
+                            }
+                            if (exactInteger(counter.getValue(), context + ".counters." + counterName) < 0) {
+                                throw new IllegalArgumentException(
+                                        context + ".counters." + counterName + " must be non-negative");
+                            }
+                            if (CounterType.getType(counterName) == null) {
+                                throw new IllegalArgumentException(
+                                        context + ".counters." + counterName + " is unsupported");
+                            }
+                        }
+                    }
+                }
+            }
+            if (playerSetup.has("mana_pool")) {
+                JsonElement values = playerSetup.get("mana_pool");
+                if (!values.isJsonArray()) {
+                    throw new IllegalArgumentException("setup." + player + ".mana_pool must be an array");
+                }
+                JsonArray manaPool = values.getAsJsonArray();
+                for (int index = 0; index < manaPool.size(); index++) {
+                    JsonElement value = manaPool.get(index);
+                    String context = "setup." + player + ".mana_pool[" + index + "]";
+                    if (!value.isJsonObject()) {
+                        throw new IllegalArgumentException(context + " needs color and source");
+                    }
+                    JsonObject unit = value.getAsJsonObject();
+                    rejectUnknownKeys(unit, manaFields, context);
+                    if (unit.size() != 2) {
+                        throw new IllegalArgumentException(context + " needs color and source");
+                    }
+                    String color = requiredString(unit, "color");
+                    if (!java.util.Set.of("W", "U", "B", "R", "G", "C").contains(color)) {
+                        throw new IllegalArgumentException(context + ".color is unsupported");
+                    }
+                    String source = requiredString(unit, "source");
+                    if (!battlefieldLabels.contains(source)) {
+                        throw new IllegalArgumentException(
+                                context + ".source must name a card on " + player + "'s battlefield");
+                    }
+                }
+            }
+        }
+    }
+
+    private static void rejectUnknownKeys(
+            JsonObject object, java.util.Set<String> allowed, String context) {
+        for (String key : object.keySet()) {
+            if (!allowed.contains(key)) {
+                throw new IllegalArgumentException(context + "." + key + " is unsupported");
+            }
+        }
+    }
+
+    private static void addSetupLabel(java.util.Set<String> labels, String label) {
+        if (label.startsWith("@")) {
+            throw new IllegalArgumentException("setup label " + label + " uses reserved @ prefix");
+        }
+        if (!labels.add(label)) {
+            throw new IllegalArgumentException("duplicate or empty setup label " + label);
+        }
+    }
+
+    private static String requiredStringValue(JsonElement value, String context) {
+        String card = value.getAsString();
+        if (card.isBlank()) throw new IllegalArgumentException(context + " needs a card");
+        return card;
+    }
+
+    private static int exactInteger(JsonElement value, String context) {
+        if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) {
+            throw new IllegalArgumentException(context + " must be an integer");
+        }
+        try {
+            return value.getAsBigDecimal().intValueExact();
+        } catch (ArithmeticException | NumberFormatException error) {
+            throw new IllegalArgumentException(context + " must be a 32-bit integer", error);
+        }
+    }
