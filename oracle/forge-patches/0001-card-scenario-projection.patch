+    private void loadScript(
+            JsonObject scenario,
+            Map<String, Card> labels,
+            ScriptedController controller0,
+            ScriptedController controller1,
+            Player castingPlayer) {
+        for (JsonElement value : scenario.getAsJsonArray("script")) {
+            JsonObject action = value.getAsJsonObject();
+            if ("cast".equals(action.get("action").getAsString())
+                    && "Extrapolate the Impossible".equals(action.get("card").getAsString())) {
+                Player caster = action.has("player")
+                        ? playerFor(action.get("player").getAsString(), castingPlayer.getGame())
+                        : castingPlayer;
+                if (caster.getOpponents().size() != 1) {
+                    throw new IllegalStateException("ambiguous scripted opponent");
+                }
+                ScriptedController castingController = caster == controller0.getPlayer()
+                        ? controller0 : controller1;
+                castingController.addOpponentChoice(
+                        caster, caster.getOpponents().get(0));
+            }
+        }
+        for (JsonElement value : scenario.getAsJsonArray("script")) {
+            JsonObject action = value.getAsJsonObject();
+            String actionName = requiredString(action, "action");
+            if ("choose_outside_game".equals(actionName)) {
+                ScriptedController chooser = controllerFor(action, controller0, controller1);
+                List<String> choices = new ArrayList<>();
+                for (JsonElement label : action.getAsJsonArray("cards")) {
+                    Card card = labels.get(label.getAsString());
+                    if (card == null) {
+                        throw new IllegalArgumentException("unknown sideboard label " + label);
+                    }
+                    choices.add(card.getName());
+                }
+                boolean accept = action.get("accept").getAsBoolean();
+                if (accept && choices.isEmpty()) {
+                    chooser.expectNoOutsideGameChoice();
+                } else {
+                    chooser.addOutsideGameChoice(accept, choices);
+                }
+            } else if ("choose_mana".equals(actionName)) {
+                ScriptedController chooser = controllerFor(action, controller0, controller1);
+                boolean common = action.has("sources");
+                boolean phaseSpecific = action.has("phase_sources");
+                boolean forgeSpecific = action.has("forge_sources");
+                if (common && (phaseSpecific || forgeSpecific)
+                        || !common && !(phaseSpecific && forgeSpecific)) {
+                    throw new IllegalArgumentException(
+                            "choose_mana needs sources or both phase_sources and forge_sources");
+                }
+                JsonArray sourceValues = action.getAsJsonArray(common ? "sources" : "forge_sources");
+                List<String> sources = new ArrayList<>();
+                for (JsonElement source : sourceValues) {
+                    sources.add(source.getAsString());
+                }
+                chooser.addManaChoices(sources);
+            } else if ("choose_surveil".equals(actionName)) {
+                ScriptedController chooser = controllerFor(action, controller0, controller1);
+                List<String> graveyardLabels = new ArrayList<>();
+                for (JsonElement card : action.getAsJsonArray("cards")) {
+                    String label = card.getAsString();
+                    Card selected = labels.get(label);
+                    if (selected == null || selected.getOwner() != chooser.getPlayer()) {
+                        throw new IllegalArgumentException(
+                                "choose_surveil label must name the chooser's card: " + label);
+                    }
+                    graveyardLabels.add(label);
+                }
+                chooser.addSurveilChoice(graveyardLabels);
+            } else if ("choose_discard".equals(actionName)) {
+                ScriptedController chooser = controllerFor(action, controller0, controller1);
+                List<String> discardLabels = new ArrayList<>();
+                Set<String> uniqueLabels = new LinkedHashSet<>();
+                for (JsonElement card : action.getAsJsonArray("cards")) {
+                    String label = card.getAsString();
+                    Card selected = labels.get(label);
+                    if (selected == null || selected.getOwner() != chooser.getPlayer()) {
+                        throw new IllegalArgumentException(
+                                "choose_discard label must name the chooser's card: " + label);
+                    }
+                    if (!uniqueLabels.add(label)) {
+                        throw new IllegalArgumentException("choose_discard.cards cannot repeat labels");
+                    }
+                    discardLabels.add(label);
+                }
+                chooser.addDiscardChoice(discardLabels);
+            } else if ("trigger_targets".equals(actionName)) {
+                if (!action.has("targets") || !action.get("targets").isJsonArray()) {
+                    throw new IllegalArgumentException("trigger_targets.targets must be an array");
+                }
+                List<String> targetLabels = new ArrayList<>();
+                Set<String> uniqueLabels = new LinkedHashSet<>();
+                for (JsonElement target : action.getAsJsonArray("targets")) {
+                    if (!target.isJsonPrimitive() || !target.getAsJsonPrimitive().isString()) {
+                        throw new IllegalArgumentException("trigger_targets labels must be strings");
+                    }
+                    String label = target.getAsString();
+                    if (!uniqueLabels.add(label)) {
+                        throw new IllegalArgumentException("trigger_targets labels cannot repeat");
+                    }
+                    if (!labels.containsKey(label)) {
+                        throw new IllegalArgumentException("unknown trigger target label " + label);
+                    }
+                    targetLabels.add(label);
+                }
+                if (targetLabels.isEmpty()) {
+                    throw new IllegalArgumentException("trigger_targets requires at least one label");
+                }
+                controller0.addTriggerTargetChoice(targetLabels);
+            } else if ("choose_replacement".equals(actionName)) {
+                ScriptedController chooser = controllerFor(action, controller0, controller1);
+                chooser.addReplacementChoice(requiredString(action, "description"));
+            } else if ("choose_entity".equals(actionName)) {
+                ScriptedController chooser = controllerFor(action, controller0, controller1);
+                chooser.addSingleEntityCardChoice(requiredString(action, "card"));
+            }
+        }
+    }
+
+    private Player playerFor(String player, Game game) {
+        return switch (player) {
+            case "P0" -> game.getPlayers().get(0);
+            case "P1" -> game.getPlayers().get(1);
+            default -> throw new IllegalArgumentException("player must be P0 or P1");
+        };
+    }
+
+    private ScriptedController controllerFor(
+            JsonObject action, ScriptedController controller0, ScriptedController controller1) {
+        return switch (requiredString(action, "player")) {
+            case "P0" -> controller0;
+            case "P1" -> controller1;
+            default -> throw new IllegalArgumentException("choice player must be P0 or P1");
+        };
+    }
+
+    private void cast(Player player, String cardName, Map<String, Card> labels) {
+        if (player.getGame().getPhaseHandler().getPriorityPlayer() != player) {
+            throw new IllegalStateException("scripted caster does not have priority: " + player.getName());
+        }
+        Card card = player.getZone(ZoneType.Hand).getCards().stream()
+                .filter(candidate -> candidate.getName().equals(cardName))
+                .findFirst()
+                .orElseThrow(() -> new IllegalArgumentException("card not in hand: " + cardName));
+        SpellAbility spell = card.getSpellAbilities().stream()
+                .filter(SpellAbility::isSpell)
+                .findFirst()
+                .orElseThrow(() -> new IllegalArgumentException("no spell ability: " + cardName));
+        assertTrue(spell.canPlay(), cardName + " should be castable");
+        ScriptedController controller = (ScriptedController) player.getController();
+        Map<Integer, Integer> manaBefore = controller.hasManaChoices()
+                ? controller.manaSourceCounts() : null;
+        assertTrue(PlaySpellAbility.playSpellAbility(controller, player, spell));
+        if (manaBefore != null) controller.verifyManaSourcesSpent(manaBefore);
+    }
+
+    private void passPriority(JsonObject action, Game game) {
+        Player player = playerFor(requiredString(action, "player"), game);
+        if (game.getPhaseHandler().getPriorityPlayer() != player) {
+            throw new IllegalStateException("scripted player does not have priority to pass");
+        }
+        if (player.getOpponents().size() != 1) {
+            throw new IllegalStateException("ambiguous player to receive priority");
+        }
+        game.getPhaseHandler().setPriority(player.getOpponents().get(0));
+    }
+
+    private void labelPermanent(JsonObject action, Game game, Map<String, Card> labels) {
+        Player player = playerFor(requiredString(action, "player"), game);
+        String cardName = requiredString(action, "card");
+        String label = requiredString(action, "label");
+        if (label.startsWith("@") || labels.containsKey(label)) {
+            throw new IllegalArgumentException("duplicate or reserved script label " + label);
+        }
+        if (!action.has("token") || !action.get("token").isJsonPrimitive()
+                || !action.getAsJsonPrimitive("token").isBoolean()) {
+            throw new IllegalArgumentException("label_permanent.token must be a boolean");
+        }
+        boolean token = action.get("token").getAsBoolean();
+        List<Card> matches = player.getZone(ZoneType.Battlefield).getCards().stream()
+                .filter(card -> projectedName(card).equals(cardName) && card.isToken() == token)
+                .toList();
+        if (matches.size() != 1) {
+            throw new IllegalStateException(
+                    "expected one matching " + cardName + " permanent for " + player.getName()
+                            + ", found " + matches.size());
+        }
+        Card permanent = matches.get(0);
+        String oldLabel = labels.entrySet().stream()
+                .filter(entry -> entry.getValue() == permanent)
+                .map(Map.Entry::getKey)
+                .findFirst()
+                .orElse(null);
+        if (oldLabel != null) {
+            throw new IllegalArgumentException(
+                    "permanent already labeled " + oldLabel + "; cannot assign " + label);
+        }
+        labels.put(label, permanent);
+    }
+
+    private void activate(JsonObject action, Game game, Map<String, Card> labels) {
+        Player player = game.getPhaseHandler().getPriorityPlayer();
+        String sourceLabel = requiredString(action, "source");
+        Card source = labels.get(sourceLabel);
+        if (source == null || source.getZone() == null
+                || source.getZone().getZoneType() != ZoneType.Battlefield
+                        && source.getZone().getZoneType() != ZoneType.Graveyard) {
+            throw new IllegalArgumentException(
+                    "activate source is not on the battlefield or in the graveyard: " + sourceLabel);
+        }
+        Player sourcePlayer = source.getZone().getZoneType() == ZoneType.Graveyard
+                ? source.getOwner() : source.getController();
+        if (sourcePlayer != player) {
+            throw new IllegalStateException("activate source is not controlled by the player with priority");
+        }
+        String requested = normalizeAbilityLabel(requiredString(action, "ability"), source);
+        List<SpellAbility> candidates = source.getSpellAbilities().stream()
+                .filter(SpellAbility::isActivatedAbility)
+                .toList();
+        List<SpellAbility> matches = candidates.stream()
+                .filter(ability -> {
+                    String description = ability.getDescription();
+                    return (description != null
+                            && normalizeAbilityLabel(description, source).equals(requested))
+                            || requested.equals(loyaltyCostLabel(ability));
+                })
+                .toList();
+        if (matches.size() != 1) {
+            throw new IllegalStateException(
+                    "expected one activated ability labeled " + action.get("ability").getAsString()
+                            + " on " + source.getName() + ", found " + matches.size()
+                            + "; source zone=" + source.getZone().getZoneType()
+                            + "; candidates=" + candidates.stream()
+                                    .map(ability -> String.valueOf(ability.getDescription())
+                                            + " [canPlay=" + ability.canPlay() + "]")
+                                    .toList());
+        }
+        SpellAbility ability = matches.get(0);
+        assertTrue(ability.canPlay(), "scripted activation should be legal: " + ability.getDescription());
+        ScriptedController controller = (ScriptedController) player.getController();
+        Map<Integer, Integer> manaBefore = controller.hasManaChoices()
+                ? controller.manaSourceCounts() : null;
+        assertTrue(PlaySpellAbility.playSpellAbility(controller, player, ability));
+        if (manaBefore != null) controller.verifyManaSourcesSpent(manaBefore);
+    }
+
+    private static String loyaltyCostLabel(SpellAbility ability) {
+        List<String> labels = new ArrayList<>();
+        for (CostPart part : ability.getPayCosts().getCostParts()) {
+            if (part instanceof CostRemoveCounter remove
+                    && remove.counter != null
+                    && remove.counter.is(CounterEnumType.LOYALTY)) {
+                labels.add("-" + remove.getAmount());
+            } else if (part instanceof CostPutCounter put
+                    && put.getCounter().is(CounterEnumType.LOYALTY)) {
+                String amount = put.getAmount();
+                labels.add("0".equals(amount) ? amount : "+" + amount);
+            }
+        }
+        return labels.size() == 1 ? labels.get(0) : null;
+    }
+
+    private static String normalizeAbilityLabel(String label, Card host) {
+        String hostName = host.getName();
+        if (hostName != null && !hostName.isBlank()) {
+            label = label.replaceAll(
+                    "(?i)\\b" + java.util.regex.Pattern.quote(hostName) + "\\b", "this");
+        }
+        return label.toLowerCase(java.util.Locale.ROOT)
+                .replace('\u2212', '-')
+                .replace("cardname", "this")
+                .replace("{this}", "this")
+                .replace("this card", "this")
+                .replaceAll("\\s+", " ")
+                .replaceFirst("\\.$", "")
+                .trim();
+    }
+
+    private void resolve(Game game) {
+        int remaining = 30;
+        while ((!game.getStack().isEmpty() || game.getStack().hasSimultaneousStackEntries()
+                || game.getTriggerHandler().getWaitingTriggerCount() > 0) && remaining-- > 0) {
+            if (!game.getStack().isEmpty()) {
+                playUntilStackClear(game);
+            } else if (game.getStack().hasSimultaneousStackEntries()) {
+                game.getPhaseHandler().mainLoopStep();
+            }
+            game.getTriggerHandler().runWaitingTriggers();
+        }
+        assertTrue(game.getStack().isEmpty(), "stack did not clear");
+        assertTrue(!game.getStack().hasSimultaneousStackEntries(), "simultaneous stack did not clear");
+        assertEquals(game.getTriggerHandler().getWaitingTriggerCount(), 0);
+    }
+
+    private JsonObject projection(Game game, Map<String, Card> labels, boolean reached) {
+        JsonObject players = new JsonObject();
+        for (int index = 0; index < 2; index++) {
+            Player player = game.getPlayers().get(index);
+            JsonObject zones = new JsonObject();
+            zones.addProperty("life", player.getLife());
+            zones.add("battlefield", names(player, ZoneType.Battlefield));
+            zones.add("hand", names(player, ZoneType.Hand));
+            zones.add("library", names(player, ZoneType.Library));
+            zones.add("graveyard", names(player, ZoneType.Graveyard));
+            JsonArray sideboard = names(player, ZoneType.Sideboard);
+            if (!sideboard.isEmpty()) zones.add("sideboard", sideboard);
+            players.add("P" + index, zones);
+        }
+        JsonObject projection = new JsonObject();
+        projection.add("players", players);
+        projection.add("battlefield", battlefield(game, labels));
+        List<String> exile = new ArrayList<>();
+        for (Player player : game.getPlayers()) {
+            exile.addAll(player.getZone(ZoneType.Exile).getCards().stream()
+                    .map(CardScenarioProjectionTest::projectedName)
+                    .toList());
+        }
+        exile.sort(Comparator.naturalOrder());
+        projection.add("exile", sortedStrings(exile));
+        projection.add("legal_targets", com.google.gson.JsonNull.INSTANCE);
+        projection.addProperty("reach", reached);
+        return projection;
+    }
+
+    private JsonArray names(Player player, ZoneType zone) {
+        List<String> names = new ArrayList<>(player.getZone(zone).getCards().stream()
+                .map(CardScenarioProjectionTest::projectedName)
+                .toList());
+        if (zone != ZoneType.Library) names.sort(Comparator.naturalOrder());
+        JsonArray result = new JsonArray();
+        names.forEach(result::add);
+        return result;
+    }
+
+    private JsonArray battlefield(Game game, Map<String, Card> labels) {
+        List<JsonObject> permanents = new ArrayList<>();
+        for (Player player : game.getPlayers()) {
+            for (Card card : player.getZone(ZoneType.Battlefield).getCards()) {
+                JsonObject permanent = new JsonObject();
+                String label = labelForCard(card, labels);
+                if (label == null) permanent.add("label", com.google.gson.JsonNull.INSTANCE);
+                else permanent.addProperty("label", label);
+                permanent.addProperty("name", projectedName(card));
+                permanent.addProperty("token", card.isToken());
+                permanent.addProperty(
+                        "controller", "P" + game.getPlayers().indexOf(card.getController()));
+                permanent.addProperty("tapped", card.isTapped());
+                permanent.add("types", sortedStrings(card.getType().getCoreTypes().stream()
+                        .map(type -> type.name()).toList()));
+                permanent.add("subtypes", sortedStrings(card.getType().getSubtypes()));
+                permanent.add("colors", colors(card));
+                permanent.addProperty("damage", card.getDamage());
+                JsonObject counters = new JsonObject();
+                card.getCounters().entrySet().stream()
+                        .sorted(Comparator.comparing(entry -> projectedCounterName(entry.getElement())))
+                        .forEach(entry -> counters.addProperty(
+                                projectedCounterName(entry.getElement()), entry.getCount()));
+                permanent.add("counters", counters);
+                permanent.add(
+                        "power",
+                        card.isCreature()
+                                ? new com.google.gson.JsonPrimitive(card.getNetPower())
+                                : com.google.gson.JsonNull.INSTANCE);
+                permanent.add(
+                        "toughness",
+                        card.isCreature()
+                                ? new com.google.gson.JsonPrimitive(card.getNetToughness())
+                                : com.google.gson.JsonNull.INSTANCE);
+                int loyalty = card.getCounters(CounterEnumType.LOYALTY);
+                if (loyalty == 0) permanent.add("loyalty", com.google.gson.JsonNull.INSTANCE);
+                else permanent.addProperty("loyalty", loyalty);
+                permanents.add(permanent);
+            }
+        }
+        permanents.sort(Comparator.comparing(
+                permanent -> permanent.get("label").isJsonNull()
+                        ? "" : permanent.get("label").getAsString()));
+        JsonArray result = new JsonArray();
+        permanents.forEach(result::add);
+        return result;
