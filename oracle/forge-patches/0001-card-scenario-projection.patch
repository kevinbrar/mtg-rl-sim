+        @Override
+        public Card chooseSingleCardForZoneChange(
+                ZoneType destination, List<ZoneType> origin, SpellAbility ability, CardCollection choices,
+                DelayedReveal reveal, String selectPrompt, boolean optional, Player decider) {
+            if (selectPrompt == null || selectPrompt.isBlank()) {
+                throw failClosed("single-card zone choice needs a prompt");
+            }
+            String prompt = selectPrompt.toLowerCase(java.util.Locale.ROOT);
+            boolean outsideGamePrompt = origin.contains(ZoneType.Sideboard)
+                    && (prompt.contains("sideboard")
+                            || prompt.contains("outside the game")
+                            || prompt.contains("card to put into that player's hand"));
+            if (!outsideGamePrompt) {
+                throw failClosed("unscripted single-card zone choice: " + selectPrompt);
+            }
+            if (choices.isEmpty()) return null;
+            outsideGameChoiceObserved = true;
+            if (noOutsideGameChoiceExpected) {
+                throw failClosed("unexpected outside-game card-choice prompt");
+            }
+            if (outsideGameChoices.isEmpty()) {
+                throw failClosed("unscripted outside-game card choice: " + selectPrompt);
+            }
+            OutsideGameChoice group = outsideGameChoices.peekFirst();
+            if (!group.accept()) {
+                if (!optional) throw failClosed("empty choice for mandatory prompt");
+                if (pendingOutsideGameCancellation) {
+                    throw failClosed("duplicate pending outside-game cancellation");
+                }
+                pendingOutsideGameCancellation = true;
+                return null;
+            }
+            if (group.cards().isEmpty()) {
+                throw failClosed("accepted outside-game prompt has no scripted card");
+            }
+            String expected = group.cards().remove(0);
+            Card selected = choices.stream()
+                    .filter(card -> card.getName().equals(expected))
+                    .findFirst()
+                    .orElseThrow(() -> failClosed("scripted card not offered: " + expected));
+            if (group.cards().isEmpty()) outsideGameChoices.removeFirst();
+            return selected;
