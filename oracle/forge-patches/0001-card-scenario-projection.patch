+    private static final class ScriptedController extends PlayerControllerForTests {
+        private final Deque<OutsideGameChoice> outsideGameChoices = new ArrayDeque<>();
+        private final Deque<ManaScriptPayment> manaChoices = new ArrayDeque<>();
+        private final Map<String, Card> labels;
+        private final Map<Player, Deque<Player>> opponentChoicesByChooser;
+        private boolean noOutsideGameChoiceExpected;
+        private boolean outsideGameChoiceObserved;
+        private boolean pendingOutsideGameCancellation;
+        private boolean passingPriority;
