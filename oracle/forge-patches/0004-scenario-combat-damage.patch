+
+        game.getPhaseHandler().devAdvanceToPhase(PhaseType.COMBAT_DAMAGE, () -> resolve(game));
+        resolve(game);
+        if (game.getPhaseHandler().getPhase() != PhaseType.COMBAT_DAMAGE) {
+            throw new IllegalStateException("attack did not stop at combat damage");
+        }
