+    private void advanceThroughAttack(Game game, boolean throughDamage) {
+        game.getPhaseHandler().devAdvanceToPhase(PhaseType.COMBAT_DECLARE_ATTACKERS, () -> resolve(game));
+        resolve(game);
+        if (!throughDamage) return;
+
+        game.getPhaseHandler().devAdvanceToPhase(PhaseType.COMBAT_DAMAGE, () -> resolve(game));
+        resolve(game);
+        PhaseType phase = game.getPhaseHandler().getPhase();
+        if (phase != PhaseType.COMBAT_DAMAGE && phase != PhaseType.COMBAT_END) {
+            throw new IllegalStateException(
+                    "attack did not stop after combat damage: " + phase);
+        }
+    }
