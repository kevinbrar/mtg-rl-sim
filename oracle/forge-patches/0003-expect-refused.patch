+        private CardCollection maximalGraveyardExileSelection(
+                Iterable<Card> choices, int max, String prompt, SpellAbility ability) {
+            if (expectedRefusalScriptIndex < 0 || max < 0
+                    || !isMonotoneGraveyardExilePayment(ability)) return null;
+            List<Card> candidates = new ArrayList<>();
+            for (Card card : choices) {
+                if (card.getZone() == null || card.getZone().getZoneType() != ZoneType.Graveyard) {
+                    return null;
+                }
+                candidates.add(card);
+            }
+            CardCollection selected = new CardCollection();
+            for (int index = 0; index < Math.min(max, candidates.size()); index++) {
