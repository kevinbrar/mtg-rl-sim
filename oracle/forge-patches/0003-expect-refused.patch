+                ? source.getOwner() : source.getController();
+        if (sourcePlayer != player) {
+            throw new IllegalStateException("activate source is not controlled by the player with priority");
+        }
+        String requested = normalizeAbilityLabel(requiredString(action, "ability"), source);
+        List<SpellAbility> candidates = source.getSpellAbilities().stream()
+                .filter(SpellAbility::isActivatedAbility)
+                .toList();
+        List<SpellAbility> matches = candidates.stream()
+                .filter(ability -> {
+                    String description = ability.getDescription();
+                    return (description != null
+                            && normalizeAbilityLabel(description, source).equals(requested))
+                            || requested.equals(loyaltyCostLabel(ability));
+                })
+                .toList();
+        if (matches.size() != 1) {
+            throw new IllegalStateException(
+                    "expected one activated ability labeled " + action.get("ability").getAsString()
+                            + " on " + source.getName() + ", found " + matches.size());
+        }
+        SpellAbility ability = matches.get(0);
+        ScriptedController controller = (ScriptedController) player.getController();
+        List<String> targets = scriptedTargets(action, labels);
+        JsonObject before = projection(game, labels, false).deepCopy();
+        int manaChoicesBefore = controller.manaChoiceCount();
+        boolean accepted = false;
+        controller.beginExpectedRefusal(scriptIndex);
+        try {
+            if (ability.canPlay()) {
+                if (targets != null) controller.addTriggerTargetChoice(player, targets);
+                accepted = PlaySpellAbility.playSpellAbility(controller, player, ability);
+            }
+            finishExpectedRefusal(scriptIndex, "activate", accepted, before, game, labels, refusals);
+        } finally {
+            controller.endExpectedRefusal();
+        }
+        if (controller.manaChoiceCount() != manaChoicesBefore) {
+            throw new IllegalStateException("refused activation consumed a scripted mana choice");
+        }
+    }
+
+    private void finishExpectedRefusal(
+            int scriptIndex,
+            String kind,
+            boolean accepted,
+            JsonObject before,
+            Game game,
+            Map<String, Card> labels,
+            List<Integer> refusals) {
+        if (accepted) {
+            throw new IllegalStateException("expected refusal but " + kind + " was accepted");
+        }
+        JsonObject after = projection(game, labels, false);
+        if (!before.equals(after)) {
+            throw new IllegalStateException(
+                    "refused action left state changed\nbefore:\n" + before + "\nafter:\n" + after);
+        }
+        refusals.add(scriptIndex);
+    }
