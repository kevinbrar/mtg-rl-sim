+        private boolean isMonotoneGraveyardExilePayment(SpellAbility ability) {
+            if (ability == null || ability.getPayCosts() == null) return false;
+            CostExile cost = ability.getPayCosts().getCostPartByType(CostExile.class);
+            if (cost == null || !cost.from.equals(List.of(ZoneType.Graveyard))) return false;
+            try {
+                if (Integer.parseInt(cost.getAmount()) < 0) return false;
+            } catch (NumberFormatException error) {
+                return false;
+            }
+            String type = cost.getType();
+            if (type.contains("+with") || type.equals("All")) return false;
+
+            boolean paymentFrame = false;
+            for (StackTraceElement frame : Thread.currentThread().getStackTrace()) {
+                String method = frame.getMethodName();
+                if ((frame.getClassName().equals(CostExile.class.getName())
+                                || frame.getClassName().equals("forge.game.cost.CostPartWithList"))
+                        && (method.startsWith("pay") || method.equals("executePayment"))) {
+                    paymentFrame = true;
+                    break;
+                }
+            }
+            return paymentFrame;
+        }
