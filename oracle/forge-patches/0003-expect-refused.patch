+    private boolean expectedRefusal(JsonObject action, int scriptIndex) {
+        if (!action.has("expect")) return false;
+        if (!"refused".equals(requiredString(action, "expect"))) {
+            throw new IllegalArgumentException("script[" + scriptIndex + "].expect must be 'refused'");
+        }
+        String kind = requiredString(action, "action");
+        if (!"cast".equals(kind) && !"activate".equals(kind)) {
+            throw new IllegalArgumentException(
+                    "script[" + scriptIndex + "].expect is only valid for cast or activate");
+        }
+        if (action.has("sacrifice") || action.has("alternative_cost") || action.has("x")) {
+            throw new IllegalArgumentException(
+                    "script[" + scriptIndex + "].expect cannot be combined with choice scripts");
+        }
+        return true;
+    }
+
+    private List<String> scriptedTargets(JsonObject action, Map<String, Card> labels) {
+        if (!action.has("targets")) return null;
+        JsonElement value = action.get("targets");
+        if (!value.isJsonArray()) {
+            throw new IllegalArgumentException("script.targets must be an array");
+        }
+        List<String> targets = new ArrayList<>();
+        Set<String> unique = new LinkedHashSet<>();
+        for (JsonElement targetValue : value.getAsJsonArray()) {
+            if (!targetValue.isJsonPrimitive() || !targetValue.getAsJsonPrimitive().isString()) {
+                throw new IllegalArgumentException("script.targets labels must be strings");
+            }
+            String label = targetValue.getAsString();
+            if (!unique.add(label)) {
+                throw new IllegalArgumentException("script.targets cannot repeat labels");
+            }
+            if (!labels.containsKey(label)) {
+                throw new IllegalArgumentException("unknown target label " + label);
+            }
+            targets.add(label);
+        }
+        return targets;
+    }
+
+    private void castExpectedRefusal(
+            JsonObject action,
+            int scriptIndex,
+            Player player,
+            Game game,
+            Map<String, Card> labels,
+            List<Integer> refusals) {
+        if (game.getPhaseHandler().getPriorityPlayer() != player) {
+            throw new IllegalStateException("scripted caster does not have priority: " + player.getName());
+        }
+        String sourceZone = action.has("from") ? requiredString(action, "from") : "hand";
+        if (!"hand".equals(sourceZone) && !"graveyard".equals(sourceZone)) {
+            throw new IllegalArgumentException("cast.from must be hand or graveyard");
+        }
+        String cardName = requiredString(action, "card");
+        Card card;
+        if ("graveyard".equals(sourceZone)) {
+            card = labels.get(cardName);
+            if (card == null || card.getZone() == null
+                    || card.getZone().getZoneType() != ZoneType.Graveyard
+                    || card.getOwner() != player) {
+                throw new IllegalStateException(
+                        "graveyard cast label must name the caster's card in their graveyard: " + cardName);
+            }
+        } else {
+            card = player.getZone(ZoneType.Hand).getCards().stream()
+                    .filter(candidate -> candidate.getName().equals(cardName))
+                    .findFirst()
+                    .orElseThrow(() -> new IllegalStateException("card not in hand: " + cardName));
+        }
+        List<SpellAbility> spellAbilities = card.getSpellAbilities().stream()
+                .filter(SpellAbility::isSpell)
+                .toList();
+        if (spellAbilities.size() != 1) {
+            throw new IllegalStateException(
+                    "expected exactly one spell ability for " + cardName + ", found "
+                            + spellAbilities.size());
+        }
+        ScriptedController controller = (ScriptedController) player.getController();
+        List<String> targets = scriptedTargets(action, labels);
+        JsonObject before = projection(game, labels, false).deepCopy();
+        int manaChoicesBefore = controller.manaChoiceCount();
+        SpellAbility spell = spellAbilities.get(0);
+        boolean accepted = false;
+        controller.beginExpectedRefusal(scriptIndex);
+        try {
+            if (spell.canPlay()) {
+                if (targets != null) {
+                    if ("graveyard".equals(sourceZone)
+                            && spell.getTargetRestrictions() != null
+                            && spell.getTargetRestrictions().getZone().contains(ZoneType.Graveyard)) {
+                        controller.addGraveyardTargetChoice(targets);
+                    } else {
+                        controller.addTriggerTargetChoice(player, targets);
+                    }
+                }
+                accepted = PlaySpellAbility.playSpellAbility(controller, player, spell);
+            }
+            finishExpectedRefusal(scriptIndex, "cast", accepted, before, game, labels, refusals);
+        } finally {
+            controller.endExpectedRefusal();
+        }
+        if (controller.manaChoiceCount() != manaChoicesBefore) {
+            throw new IllegalStateException("refused cast consumed a scripted mana choice");
+        }
+    }
