+    static String normalizeAbilityText(String text) {
+        String trimmed = text.stripLeading();
+        int flavorEnd = trimmed.startsWith("<i>") ? trimmed.indexOf("</i>") : -1;
+        boolean hasFlavorPrefix = flavorEnd >= 0
+                && trimmed.substring(flavorEnd + 4).stripLeading().startsWith("&mdash;");
+        String normalized = text.replaceAll("(?s)<[^>]*>", "")
+                .replace("&mdash;", "—")
+                .trim();
+        int separator = normalized.indexOf('—');
+        if (hasFlavorPrefix || (separator >= 0 && !normalized.substring(0, separator).contains(":"))) {
+            if (separator >= 0) {
+                normalized = normalized.substring(separator + 1).trim();
+            }
+        }
+        int headEnd = normalized.indexOf(':');
+        if (headEnd < 0) {
+            headEnd = normalized.length();
+        }
+        int selfReference = normalized.indexOf("this ");
+        if (selfReference >= 0 && selfReference < headEnd) {
+            normalized = normalized.substring(0, selfReference) + "~" + normalized.substring(headEnd);
+        }
+        return normalized;
+    }
