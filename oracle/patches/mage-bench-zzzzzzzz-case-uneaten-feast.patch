@@ -0,0 +1,33 @@
+package org.mage.test.player;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+public final class TestPlayerAbilityTextTest {
+
+    @Test
+    public void normalizeAbilityTextRemovesHtmlAndLeadingFlavorWord() {
+        Assert.assertEquals(
+                "Sacrifice ~: Draw a card.",
+                TestPlayer.normalizeAbilityText(
+                        "<i>Solved</i> &mdash; Sacrifice this Case: Draw a card."
+                )
+        );
+    }
+
+    @Test
+    public void normalizeAbilityTextRemovesPlainFlavorWordAndSelfReferenceName() {
+        Assert.assertEquals(
+                "Sacrifice ~: Draw a card.",
+                TestPlayer.normalizeAbilityText("Solved — Sacrifice this Case: Draw a card.")
+        );
+    }
+
+    @Test
+    public void normalizeAbilityTextKeepsUnflavoredAbilityText() {
+        Assert.assertEquals(
+                "{T}: Add {G}.",
+                TestPlayer.normalizeAbilityText("{T}: Add {G}.")
+        );
+    }
+}
