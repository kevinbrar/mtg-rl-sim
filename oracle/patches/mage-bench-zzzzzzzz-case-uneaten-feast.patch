+    public void castPlayableSpellFromGraveyard(UUID sourceId, Game game) {
+        if (sourceId == null) {
+            throw new IllegalArgumentException("graveyard spell source id is required");
+        }
+        Set<Card> graveyardCards = computerPlayer.getGraveyard().getCards(game);
+        Card sourceCard = graveyardCards.stream()
+                .filter(card -> sourceId.equals(card.getId()))
+                .findFirst()
+                .orElseThrow(() -> new IllegalStateException("graveyard spell object is not in the graveyard: " + sourceId));
+        List<UUID> otherSameNameCards = graveyardCards.stream()
+                .filter(card -> card.getName().equals(sourceCard.getName()))
+                .map(Card::getId)
+                .filter(id -> !sourceId.equals(id))
+                .collect(Collectors.toList());
+        List<SpellAbility> matches = computerPlayer.getPlayable(game, true, Zone.GRAVEYARD, false).stream()
+                .filter(SpellAbility.class::isInstance)
+                .map(SpellAbility.class::cast)
+                .filter(ability -> sourceId.equals(ability.getSourceId()))
+                .collect(Collectors.toList());
+        if (matches.isEmpty()) {
+            throw new IllegalStateException("no playable graveyard spell ability for object " + sourceId);
+        }
+        if (!computerPlayer.activateAbility(matches.get(0).copy(), game)) {
+            throw new IllegalStateException("could not cast graveyard spell object " + sourceId);
+        }
+        if (game.getStack().stream().noneMatch(stackObject -> sourceId.equals(stackObject.getSourceId()))) {
+            throw new IllegalStateException("graveyard spell object " + sourceId + " was not put on the stack");
+        }
+        Set<UUID> graveyardIds = computerPlayer.getGraveyard().getCards(game).stream()
+                .map(Card::getId)
+                .collect(Collectors.toSet());
+        for (UUID otherCard : otherSameNameCards) {
+            if (!graveyardIds.contains(otherCard)) {
+                throw new IllegalStateException(
+                        "graveyard cast moved another same-name object out of the graveyard: " + otherCard);
+            }
+        }
+    }
