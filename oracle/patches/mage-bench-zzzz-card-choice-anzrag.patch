+    private boolean makeScenarioCardChoice(
+            Outcome outcome, Target target, Ability source, Game game, Cards fromCards) {
+        if (cardChoiceGroups.isEmpty()) {
+            throw new IllegalStateException("card-choice prompt arrived with an empty choose_cards queue");
+        }
+        List<String> group = cardChoiceGroups.remove(0);
+        int min = target.getMinNumberOfTargets() - target.getSize();
+        int max = target.getMaxNumberOfTargets() - target.getSize();
+        if (group.size() < min) {
+            throw new IllegalStateException("card choice group has " + group.size()
+                    + " cards but the prompt requires at least " + min);
+        }
+        if (group.size() > max) {
+            throw new IllegalStateException("card choice group has " + group.size()
+                    + " cards but the prompt allows at most " + max);
+        }
+
+        UUID abilityControllerId = target.getAffectedAbilityControllerId(this.getId());
+        PossibleTargetsSelector selector = new PossibleTargetsSelector(
+                outcome, target, abilityControllerId, source, game);
+        selector.findNewTargets(fromCards);
+        if (group.isEmpty()) {
+            target.setSkipChoice(true);
+            return false;
+        }
+        for (String label : group) {
+            MageObject selected = selector.getAny().stream()
+                    .filter(MageObject.class::isInstance)
+                    .map(MageObject.class::cast)
+                    .filter(card -> hasObjectTargetNameOrAlias(card, ALIAS_PREFIX + label))
+                    .findFirst()
+                    .orElseThrow(() -> new IllegalStateException(
+                            "card choice label " + label + " is not offered"));
+            target.add(selected.getId(), game);
+        }
+        return target.isChosen(game);
+    }
