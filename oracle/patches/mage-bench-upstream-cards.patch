+
+    public JacePlaneswalkerToken() {
+        super("Jace", "blue Jace planeswalker token with \"-1: Surveil 1\" and \"-3: Draw a card.\"");
+        this.cardType.add(CardType.PLANESWALKER);
+        this.subtype.add(SubType.JACE);
+        this.color.setBlue(true);
