+    private boolean isRottenmouthViperSource(Ability source, Game game) {
+        MageObject sourceObject = source == null ? null : source.getSourceObject(game);
+        return sourceObject != null && sourceObject.getName().equals("Rottenmouth Viper");
+    }
+
+    private Boolean chooseRottenmouthUnlessChoice(String message, Ability source, Game game) {
+        if (!isRottenmouthViperSource(source, game) || message == null) {
+            return null;
+        }
+        boolean sacrificePrompt = message.startsWith("Sacrifices a nonland permanent? (Iteration ");
+        boolean discardPrompt = message.startsWith("Discard a card? (Iteration ");
+        if (!sacrificePrompt && !discardPrompt) {
+            return null;
+        }
+        Matcher matcher = Pattern.compile("\\(Iteration (\\d+) of (\\d+)\\)").matcher(message);
+        if (!matcher.find()) {
+            throw new IllegalStateException("Rottenmouth Viper unless prompt has no iteration");
+        }
+        String iteration = matcher.group(1) + " of " + matcher.group(2);
+        if (pendingRottenmouthDeclineIteration != null) {
+            if (!pendingRottenmouthDeclineIteration.equals(iteration) || sacrificePrompt) {
+                throw new IllegalStateException("Rottenmouth Viper skipped a scripted discard prompt");
+            }
+            pendingRottenmouthDeclineIteration = null;
+            return false;
+        }
+        if (sacrificePrompt && !rottenmouthUnlessChoices.isEmpty()
+                && rottenmouthUnlessChoices.peekFirst().kind() == RottenmouthUnlessKind.DISCARD) {
+            return false;
+        }
+        if (rottenmouthUnlessChoices.isEmpty()) {
+            throw new IllegalStateException("Rottenmouth Viper unless prompt has no unless_choices entry");
+        }
+        RottenmouthUnlessChoice choice = rottenmouthUnlessChoices.removeFirst();
+        if (choice.kind() == RottenmouthUnlessKind.DECLINE) {
+            if (sacrificePrompt && !computerPlayer.getHand().isEmpty()) {
+                pendingRottenmouthDeclineIteration = iteration;
+            }
+            return false;
+        }
+        if (sacrificePrompt && choice.kind() == RottenmouthUnlessKind.SACRIFICE) {
+            if (pendingRottenmouthUnlessSacrificeLabel != null) {
+                throw new IllegalStateException("Rottenmouth Viper sacrifice selection is already pending");
+            }
+            pendingRottenmouthUnlessSacrificeLabel = choice.label();
+            addChoice("@" + choice.label());
+            return true;
+        }
+        if (discardPrompt && choice.kind() == RottenmouthUnlessKind.DISCARD) {
+            if (pendingRottenmouthUnlessDiscardLabel != null) {
+                throw new IllegalStateException("Rottenmouth Viper discard selection is already pending");
+            }
+            pendingRottenmouthUnlessDiscardLabel = choice.label();
+            addCardChoiceGroup(List.of(choice.label()));
+            return true;
+        }
+        throw new IllegalStateException(
+                "Rottenmouth Viper unless choice " + choice.kind() + " does not match the offered prompt");
+    }
