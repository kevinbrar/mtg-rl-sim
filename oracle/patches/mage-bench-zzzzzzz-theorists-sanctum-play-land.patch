index 0000000000..9f12f2d444
--- /dev/null
+++ b/Mage.Tests/src/test/java/org/mage/test/player/TestPlayerCardChoiceQueueTest.java
@@ -0,0 +1,31 @@
+package org.mage.test.player;
+
+import mage.constants.RangeOfInfluence;
+import org.junit.Test;
+
+import java.util.List;
+
+import static org.junit.Assert.assertEquals;
+
+public final class TestPlayerCardChoiceQueueTest {
+
+    @Test
+    public void beholdAnswerPrecedesLaterQueuedCardChoices() {
+        TestPlayer player = new TestPlayer(new TestComputerPlayer("Player", RangeOfInfluence.ONE));
+        player.addCardChoiceGroup(List.of("later-choice"));
+        player.addCardChoiceGroupFirst(List.of("behold-choice"));
+
+        assertEquals(List.of("behold-choice"), player.takeNextCardChoiceGroup());
+        assertEquals(List.of("later-choice"), player.takeNextCardChoiceGroup());
+    }
+
+    @Test
+    public void declineMustMatchTheBeholdPromptSourceAndMessage() {
+        java.util.UUID land = java.util.UUID.randomUUID();
+        java.util.UUID other = java.util.UUID.randomUUID();
+
+        org.junit.Assert.assertTrue(TestPlayer.matchesExpectedBeholdPrompt(land, land, "Behold a Jace?"));
+        org.junit.Assert.assertFalse(TestPlayer.matchesExpectedBeholdPrompt(land, other, "Behold a Jace?"));
+        org.junit.Assert.assertFalse(TestPlayer.matchesExpectedBeholdPrompt(land, land, "Pay 2 life?"));
+    }
+}
