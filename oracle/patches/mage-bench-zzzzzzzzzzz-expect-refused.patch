+    private void scheduleExpectedRefusal(
+            int scriptIndex,
+            String kind,
+            String cardOrSource,
+            String sourceZone,
+            String ability,
+            List<String> targets,
+            int turn,
+            PhaseStep step,
+            TestPlayer actingPlayer) {
+        runCode("attempt expected refusal script[" + scriptIndex + "]", turn, step, actingPlayer,
+                (info, player, game) -> {
+                    if (refusalExecutions.contains(scriptIndex)) {
+                        throw new IllegalStateException(
+                                "refused command would be retried at script[" + scriptIndex + "]");
+                    }
+                    refusalExecutions.add(scriptIndex);
+                    JsonObject before = result().getAsJsonObject("projection").deepCopy();
+                    boolean accepted;
+                    actingPlayer.beginScenarioExpectedRefusal(scriptIndex);
+                    try {
+                        if (kind.equals("cast")) {
+                            Zone zone = sourceZone.equals("graveyard") ? Zone.GRAVEYARD : Zone.HAND;
+                            UUID sourceId;
+                            if (zone == Zone.GRAVEYARD) {
+                                sourceId = labels.get(cardOrSource);
+                                if (sourceId == null) {
+                                    throw new IllegalStateException(
+                                            cardOrSource + " is not a setup label");
+                                }
+                                if (actingPlayer.getGraveyard().getCards(game).stream()
+                                        .noneMatch(candidate -> sourceId.equals(candidate.getId()))) {
+                                    throw new IllegalStateException(
+                                            cardOrSource + " is not in the active player's graveyard");
+                                }
+                            } else {
+                                sourceId = actingPlayer.getHand().getCards(game).stream()
+                                        .filter(candidate -> candidate.getName().equals(cardOrSource))
+                                        .findFirst()
+                                        .orElseThrow(() -> new IllegalStateException(
+                                                cardOrSource + " is not in the active player's hand"))
+                                        .getId();
+                            }
+                            boolean offered =
+                                    actingPlayer.getPlayableObjects(game, zone).containsObject(sourceId);
+                            if (offered) {
+                                targets.forEach(actingPlayer::addTarget);
+                                accepted = actingPlayer.attemptScenarioSpell(sourceId, zone, game);
+                            } else {
+                                accepted = false;
+                            }
+                        } else {
+                            String command = "@" + cardOrSource + " " + ability;
+                            if (!targets.isEmpty()) {
+                                command += "$target=" + String.join("^", targets);
+                            }
+                            accepted = actingPlayer.attemptScenarioActivatedAbility(command, game);
+                        }
+                    } finally {
+                        for (String prompt : actingPlayer.finishScenarioExpectedRefusal()) {
+                            JsonObject costPrompt = new JsonObject();
+                            costPrompt.addProperty("script_index", scriptIndex);
+                            costPrompt.addProperty("prompt", prompt);
+                            refusalCostPrompts.add(costPrompt);
+                        }
+                    }
+                    if (accepted) {
+                        throw new IllegalStateException("expected refusal but " + kind + " was accepted");
+                    }
+                    JsonObject after = result().getAsJsonObject("projection");
+                    if (!before.equals(after)) {
+                        throw new IllegalStateException(
+                                "refused action left state changed\nbefore:\n" + GSON.toJson(before)
+                                        + "\nafter:\n" + GSON.toJson(after));
+                    }
+                    refusals.add(scriptIndex);
+                });
+    }
