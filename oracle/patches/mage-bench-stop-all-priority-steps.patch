+    @Test
+    void optionalBooleanPropertyIsAbsentByDefault() {
+        withSystemProperty("xmage.bridge.stopAtAllPrioritySteps", null, () ->
+            assertThat(BridgeClient.getOptionalBooleanProperty("xmage.bridge.stopAtAllPrioritySteps"))
+                .isNull()
+        );
+    }
+
+    @Test
+    void parsesOptionalBooleanProperty() {
+        withSystemProperty("xmage.bridge.stopAtAllPrioritySteps", "true", () ->
+            assertThat(BridgeClient.getOptionalBooleanProperty("xmage.bridge.stopAtAllPrioritySteps"))
+                .isTrue()
+        );
+        withSystemProperty("xmage.bridge.stopAtAllPrioritySteps", "false", () ->
+            assertThat(BridgeClient.getOptionalBooleanProperty("xmage.bridge.stopAtAllPrioritySteps"))
+                .isFalse()
+        );
+    }
+
+    @Test
+    void rejectsInvalidBooleanProperty() {
+        withSystemProperty("xmage.bridge.stopAtAllPrioritySteps", "yes", () ->
+            assertThatThrownBy(() ->
+                BridgeClient.getOptionalBooleanProperty("xmage.bridge.stopAtAllPrioritySteps")
+            )
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessage("Invalid boolean for -Dxmage.bridge.stopAtAllPrioritySteps: yes")
+        );
+    }
+
+    @Test
+    void enablesEveryPriorityStepForBothTurns() {
+        UserSkipPrioritySteps steps = BridgeClient.createUserSkipPrioritySteps(true);
+
+        for (var turn : List.of(steps.getYourTurn(), steps.getOpponentTurn())) {
+            assertThat(turn.isUpkeep()).isTrue();
+            assertThat(turn.isDraw()).isTrue();
+            assertThat(turn.isMain1()).isTrue();
+            assertThat(turn.isBeforeCombat()).isTrue();
+            assertThat(turn.isEndOfCombat()).isTrue();
+            assertThat(turn.isMain2()).isTrue();
+            assertThat(turn.isEndOfTurn()).isTrue();
+        }
+    }
+
+    @Test
+    void leavesDefaultPriorityStepsWhenDisabled() {
+        UserSkipPrioritySteps steps = BridgeClient.createUserSkipPrioritySteps(false);
+
+        for (var turn : List.of(steps.getYourTurn(), steps.getOpponentTurn())) {
+            assertThat(turn.isUpkeep()).isFalse();
+            assertThat(turn.isDraw()).isFalse();
+            assertThat(turn.isMain1()).isTrue();
+            assertThat(turn.isBeforeCombat()).isFalse();
+            assertThat(turn.isEndOfCombat()).isFalse();
+            assertThat(turn.isMain2()).isTrue();
+            assertThat(turn.isEndOfTurn()).isFalse();
+        }
+    }
