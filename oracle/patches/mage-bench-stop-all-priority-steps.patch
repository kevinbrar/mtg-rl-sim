+    static Boolean getOptionalBooleanProperty(String propertyName) {
+        String value = System.getProperty(propertyName);
+        if (value == null) {
+            return null;
+        }
+        if ("true".equalsIgnoreCase(value)) {
+            return true;
+        }
+        if ("false".equalsIgnoreCase(value)) {
+            return false;
+        }
+        throw new IllegalArgumentException("Invalid boolean for -D" + propertyName + ": " + value);
+    }
+
+    static UserSkipPrioritySteps createUserSkipPrioritySteps(boolean stopAtAllPrioritySteps) {
+        UserSkipPrioritySteps steps = new UserSkipPrioritySteps();
+        if (stopAtAllPrioritySteps) {
+            setAllPrioritySteps(steps.getYourTurn());
+            setAllPrioritySteps(steps.getOpponentTurn());
+        }
+        return steps;
+    }
+
+    private static void setAllPrioritySteps(SkipPrioritySteps steps) {
+        steps.setUpkeep(true);
+        steps.setDraw(true);
+        steps.setMain1(true);
+        steps.setBeforeCombat(true);
+        steps.setEndOfCombat(true);
+        steps.setMain2(true);
+        steps.setEndOfTurn(true);
+    }
+
