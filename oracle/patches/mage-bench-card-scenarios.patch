+package org.mage.test.testapi;
+
+import mage.constants.PhaseStep;
+import mage.constants.Zone;
+import org.junit.Test;
+import org.mage.test.serverside.base.CardTestPlayerBase;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+public final class CardScenarioLibraryOrderTest extends CardTestPlayerBase {
+
+    @Test
+    public void fixtureLibraryTopIsFirstDrawn() {
+        removeAllCardsFromLibrary(playerA);
+        removeAllCardsFromLibrary(playerB);
+        skipInitShuffling();
+        addCard(Zone.LIBRARY, playerA, "Swamp");
+        addCard(Zone.LIBRARY, playerA, "Mountain");
+        addCard(Zone.LIBRARY, playerA, "Forest");
+        addCard(Zone.LIBRARY, playerB, "Swamp");
+        addCard(Zone.LIBRARY, playerB, "Mountain");
+        addCard(Zone.LIBRARY, playerB, "Forest");
+
+        runCode("check ordered library then draw once", 1, PhaseStep.PRECOMBAT_MAIN, playerA,
+                (info, player, game) -> {
+                    assertTrue(player.getHand().getCards(game).isEmpty());
+                    assertEquals("Forest", player.getLibrary().getCards(game).get(0).getName());
+                    assertEquals("Mountain", player.getLibrary().getCards(game).get(1).getName());
+                    assertEquals("Swamp", player.getLibrary().getCards(game).get(2).getName());
+                    player.drawCards(1, null, game);
+                    assertEquals(1, player.getHand().getCards(game).size());
+                    assertEquals("Forest", player.getHand().getCards(game).iterator().next().getName());
+                    assertEquals("Mountain", player.getLibrary().getCards(game).get(0).getName());
+                    assertEquals("Swamp", player.getLibrary().getCards(game).get(1).getName());
+                });
+
+        setStrictChooseMode(true);
+        setStopAt(1, PhaseStep.PRECOMBAT_MAIN);
+        execute();
+    }
+
+    @Test
+    public void tokenNameSuffixIsRemovedOnlyForTokenPermanents() {
+        assertEquals("Rat", CardScenarioProjectionTest.projectedName("Rat Token", true));
+        assertEquals("Rat Token", CardScenarioProjectionTest.projectedName("Rat Token", false));
+        assertEquals("Rat", CardScenarioProjectionTest.projectedName("Rat", true));
+    }
+}
