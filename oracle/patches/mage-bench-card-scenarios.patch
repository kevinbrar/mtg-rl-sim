+@RunWith(Parameterized.class)
+public final class CardScenarioProjectionTest extends CardTestPlayerBase {
+
+    private static final Gson GSON = new GsonBuilder().serializeNulls().create();
+    private static final String RESULT_PREFIX = "CARD_SCENARIO_RESULT:";
+    private final String scenarioName;
+    private final JsonObject scenario;
+    private final Map<String, UUID> labels = new LinkedHashMap<>();
+    private final Map<String, Map<String, Integer>> counters = new LinkedHashMap<>();
+    private JsonArray initialLegalTargets;
+
+    public CardScenarioProjectionTest(String scenarioName, JsonObject scenario) {
+        this.scenarioName = scenarioName;
+        this.scenario = scenario;
+    }
+
+    @Parameterized.Parameters(name = "{0}")
+    public static Collection<Object[]> scenarios() throws IOException {
+        String path = System.getProperty("oracleScenarioSpec");
+        if (path == null || path.isBlank()) {
+            throw new IllegalArgumentException("-DoracleScenarioSpec is required");
+        }
+        JsonObject root;
+        try (var reader = Files.newBufferedReader(Path.of(path))) {
+            root = JsonParser.parseReader(reader).getAsJsonObject();
+        }
+        JsonArray values = root.getAsJsonArray("scenarios");
+        if (values == null || values.isEmpty()) {
+            throw new IllegalArgumentException("scenario spec must contain scenarios");
+        }
+        List<Object[]> result = new ArrayList<>();
+        for (JsonElement value : values) {
+            JsonObject item = value.getAsJsonObject();
+            result.add(new Object[]{requiredString(item, "name"), item});
+        }
+        return result;
+    }
+
+    @Test
+    public void runScenario() {
+        int initialActive = integer(scenario, "active_player", 0);
+        if (initialActive < 0 || initialActive > 1) {
+            throw new IllegalArgumentException("active_player must be 0 or 1");
+        }
+        String stepName = string(scenario, "step", "precombat_main");
+        if (!stepName.equals("precombat_main")) {
+            throw new IllegalArgumentException("unsupported step " + stepName);
+        }
+        PhaseStep step = PhaseStep.PRECOMBAT_MAIN;
+        TestPlayer active = player(initialActive);
+        activePlayer = active;
+        skipInitShuffling();
+        addScenarioSetup();
+        scheduleObjectSetup(active);
+        if (scenario.has("legal_targets_of")) {
+            runCode("capture initial legal targets", 1, step, active, (info, player, game) -> {
+                initialLegalTargets = legalTargets();
+            });
+        }
+        int finalTurn = scheduleScript(initialActive, step);
+        PhaseStep finalStep = finalTurn == 1 ? step : lastStep;
+        setStrictChooseMode(true);
+        player(0).setAutoOrderIdenticalTriggers(true);
+        player(1).setAutoOrderIdenticalTriggers(true);
+        player(0).setStrictTargetQueue(true);
+        player(1).setStrictTargetQueue(true);
+        player(0).setStrictCardChoiceQueue(true);
+        player(1).setStrictCardChoiceQueue(true);
+        setStopAt(finalTurn, finalStep);
+        execute();
+        for (int index = 0; index < 2; index++) {
+            if (!player(index).getTargets().isEmpty()) {
+                throw new IllegalStateException("trigger target group(s) were unconsumed when the script ended: "
+                        + player(index).getTargets());
+            }
+            player(index).assertNoCardChoiceGroups();
+        }
+        System.out.println(RESULT_PREFIX + GSON.toJson(result()));
+    }
+
+    private PhaseStep lastStep = PhaseStep.PRECOMBAT_MAIN;
+
+    private int scheduleScript(int initialActive, PhaseStep step) {
+        int turn = 1;
+        int activeIndex = initialActive;
+        for (JsonElement item : array(scenario, "script")) {
+            JsonObject action = item.getAsJsonObject();
+            String kind = requiredString(action, "action");
+            TestPlayer actingPlayer = player(activeIndex);
+            switch (kind) {
+                case "cast" -> {
+                    String card = requiredString(action, "card");
+                    boolean hasX = action.has("x");
+                    int x = hasX ? exactInteger(action.get("x"), "cast.x") : 0;
+                    if (x < 0) {
+                        throw new IllegalArgumentException("cast.x must be a non-negative integer");
+                    }
+                    runCode("validate X announcement", turn, step, actingPlayer, (info, player, game) -> {
+                        Card spell = actingPlayer.getHand().getCards(game).stream()
+                                .filter(candidate -> candidate.getName().equals(card))
+                                .findFirst()
+                                .orElseThrow(() -> new IllegalStateException(card + " is not in the active player's hand"));
+                        boolean hasXCost = spell.getManaCost().getText().contains("{X}");
+                        if (hasXCost != hasX) {
+                            throw new IllegalStateException(hasXCost
+                                    ? "cast of an X-cost spell requires x"
+                                    : "x is only valid for a spell with an X cost");
+                        }
+                    });
+                    if (hasX) {
+                        runCode("queue X choice", turn, step, actingPlayer,
+                                (info, player, game) -> setChoice(actingPlayer, "X=" + x));
+                    }
+                    List<String> targets = strings(array(action, "targets"));
+                    for (int index = 0; index < targets.size(); index++) {
+                        String label = targets.get(index);
+                        if (!labels.containsKey(label)) {
+                            throw new IllegalArgumentException("unknown target label " + label);
+                        }
+                        targets.set(index, "@" + label);
+                    }
+                    if (targets.isEmpty()) {
+                        castSpell(turn, step, actingPlayer, card);
+                    } else {
+                        castSpell(turn, step, actingPlayer, card, String.join("^", targets));
+                    }
+                    if (hasX) {
+                        runCode("assert X choice was consumed", turn, step, actingPlayer, (info, player, game) -> {
+                            if (!actingPlayer.getChoices().isEmpty()) {
+                                throw new IllegalStateException(
+                                        "cast.x was provided but no X choice prompt consumed it"
+                                );
+                            }
+                        });
+                    }
+                    lastStep = step;
+                }
+                case "trigger_targets" -> {
+                    List<String> targets = strings(array(action, "targets"));
+                    if (targets.isEmpty()) {
+                        throw new IllegalArgumentException("trigger_targets needs at least one target");
+                    }
+                    for (int index = 0; index < targets.size(); index++) {
+                        String label = targets.get(index);
+                        if (!labels.containsKey(label)) {
+                            throw new IllegalArgumentException("unknown target label " + label);
+                        }
+                        targets.set(index, "@" + label);
+                    }
+                    actingPlayer.addTarget(String.join("^", targets));
+                }
+                case "choose_cards" -> {
+                    if (!action.has("cards") || !action.get("cards").isJsonArray()) {
+                        throw new IllegalArgumentException("choose_cards needs cards");
+                    }
+                    List<String> cards = strings(action.getAsJsonArray("cards"));
+                    for (String label : cards) {
+                        if (!labels.containsKey(label)) {
+                            throw new IllegalArgumentException("unknown card label " + label);
+                        }
+                    }
+                    actingPlayer.addCardChoiceGroup(cards);
+                }
+                case "activate" -> {
+                    String source = requiredString(action, "source");
+                    String ability = requiredString(action, "ability");
+                    boolean hasAlternativeCost = action.has("alternative_cost");
+                    boolean acceptAlternativeCost = false;
+                    if (hasAlternativeCost) {
+                        String decision = requiredString(action, "alternative_cost");
+                        if (!decision.equals("accept") && !decision.equals("decline")) {
+                            throw new IllegalArgumentException(
+                                    "activate.alternative_cost must be accept or decline"
+                            );
+                        }
+                        acceptAlternativeCost = decision.equals("accept");
+                    }
+                    if (!labels.containsKey(source)) {
+                        throw new IllegalArgumentException("unknown battlefield label " + source);
+                    }
+                    UUID sourceId = labels.get(source);
+                    String command = "@" + source + " " + ability;
+                    List<String> targets = strings(array(action, "targets"));
+                    for (int index = 0; index < targets.size(); index++) {
+                        String label = targets.get(index);
+                        if (!labels.containsKey(label)) {
+                            throw new IllegalArgumentException("unknown target label " + label);
+                        }
+                        targets.set(index, "@" + label);
+                    }
+                    runCode("require unique activated ability", turn, step, actingPlayer,
+                            (info, player, game) -> actingPlayer.assertUniqueActivatedAbility(game, command));
+                    if (hasAlternativeCost) {
+                        boolean accepted = acceptAlternativeCost;
+                        runCode("queue alternative-cost choice", turn, step, actingPlayer,
+                                (info, player, game) -> setChoice(actingPlayer, accepted));
+                    }
+                    if (targets.isEmpty()) {
+                        activateAbility(turn, step, actingPlayer, command);
+                    } else {
+                        activateAbility(turn, step, actingPlayer, command, targets.toArray(String[]::new));
+                    }
+                    runCode("assert activation committed", turn, step, actingPlayer, (info, player, game) -> {
+                        boolean committed = game.getStack().stream()
+                                .anyMatch(stackObject -> sourceId.equals(stackObject.getSourceId()));
+                        if (!committed) {
+                            throw new IllegalStateException("activated ability did not commit to the stack");
+                        }
+                    });
+                    if (hasAlternativeCost) {
+                        runCode("assert alternative-cost choice was consumed", turn, step, actingPlayer,
+                                (info, player, game) -> {
+                                    if (!actingPlayer.getChoices().isEmpty()) {
+                                        throw new IllegalStateException(
+                                                "activate.alternative_cost was provided but no prompt consumed it"
+                                        );
+                                    }
+                                });
+                    }
+                    lastStep = step;
+                }
+                case "pass_until_resolved" -> {
+                    waitStackResolved(turn, step, actingPlayer);
+                    lastStep = step;
+                }
+                case "end_turn", "next_turn" -> {
+                    turn++;
+                    activeIndex = 1 - activeIndex;
+                    lastStep = PhaseStep.UPKEEP;
+                }
+                default -> throw new IllegalArgumentException("unsupported action " + kind);
+            }
+        }
+        return turn;
+    }
+
+    private void addScenarioSetup() {
+        JsonObject setup = object(scenario, "setup");
+        rejectUnknownKeys(setup, Set.of("P0", "P1"), "setup");
+        for (int index = 0; index < 2; index++) {
+            String playerName = "P" + index;
+            JsonObject playerSetup = object(setup, playerName);
+            TestPlayer player = player(index);
+            getCommands(player).put(Zone.HAND, "clear");
+            getCommands(player).put(Zone.LIBRARY, "clear");
+            setLife(player, integer(playerSetup, "life", 20));
+            rejectUnknownKeys(
+                    playerSetup,
+                    Set.of("life", "battlefield", "hand", "library_top", "graveyard"),
+                    playerName
+            );
+            addBattlefield(playerName, player, array(playerSetup, "battlefield"));
+            addCards(Zone.HAND, player, array(playerSetup, "hand"));
+            List<JsonElement> library = new ArrayList<>();
+            array(playerSetup, "library_top").forEach(library::add);
+            for (int cardIndex = library.size() - 1; cardIndex >= 0; cardIndex--) {
+                addSetupCard(Zone.LIBRARY, player, library.get(cardIndex));
+            }
+            addCards(Zone.GRAVEYARD, player, array(playerSetup, "graveyard"));
+        }
+    }
+
+    private void addBattlefield(String playerName, TestPlayer player, JsonArray permanents) {
+        for (int index = 0; index < permanents.size(); index++) {
+            JsonObject item = permanents.get(index).getAsJsonObject();
+            rejectUnknownKeys(item, Set.of("label", "card", "tapped", "counters", "damage"),
+                    playerName + ".battlefield[" + index + "]");
+            if (item.has("damage")) {
+                throw new IllegalArgumentException(
+                        playerName + ".battlefield[" + index + "].damage is unsupported by the XMage scenario test API"
+                );
+            }
+            String label = requiredString(item, "label");
+            if (labels.containsKey(label)) {
+                throw new IllegalArgumentException("duplicate setup label " + label);
+            }
+            String card = requiredString(item, "card");
+            boolean tapped = bool(item, "tapped", false);
+            addCard(Zone.BATTLEFIELD, player, card + "@" + label, 1, tapped);
+            UUID objectId = player.getAliasByName(label);
+            if (objectId == null) {
+                throw new IllegalArgumentException("XMage did not register setup label " + label);
+            }
+            labels.put(label, objectId);
+            JsonObject cardCounters = object(item, "counters");
+            if (!cardCounters.entrySet().isEmpty()) {
+                Map<String, Integer> parsed = new LinkedHashMap<>();
+                for (Map.Entry<String, JsonElement> counter : cardCounters.entrySet()) {
+                    int count = exactInteger(counter.getValue(), label + ".counters." + counter.getKey());
+                    if (count < 0) {
+                        throw new IllegalArgumentException("counter counts must be non-negative");
+                    }
+                    parsed.put(counter.getKey(), count);
+                }
+                counters.put(label, parsed);
+            }
+        }
+    }
+
+    private void addCards(Zone zone, TestPlayer player, JsonArray cards) {
+        for (JsonElement card : cards) {
+            addSetupCard(zone, player, card);
+        }
+    }
+
+    private void addSetupCard(Zone zone, TestPlayer player, JsonElement item) {
+        String card = cardName(item);
+        if (item.isJsonObject() && item.getAsJsonObject().has("label")) {
+            String label = requiredString(item.getAsJsonObject(), "label");
+            if (labels.containsKey(label)) {
+                throw new IllegalArgumentException("duplicate setup label " + label);
+            }
+            addCard(zone, player, card + "@" + label);
+            UUID objectId = player.getAliasByName(label);
+            if (objectId == null) {
+                throw new IllegalArgumentException("XMage did not register setup label " + label);
+            }
+            labels.put(label, objectId);
+        } else {
+            addCard(zone, player, card);
+        }
+    }
+
+    private void scheduleObjectSetup(TestPlayer active) {
+        if (counters.isEmpty() && !hasTappedFixture()) {
+            return;
+        }
+        runCode("apply scenario permanent fixtures", 1, PhaseStep.UPKEEP, active, (info, player, game) -> {
+            for (Map.Entry<String, Map<String, Integer>> fixture : counters.entrySet()) {
+                Permanent permanent = game.getPermanent(labels.get(fixture.getKey()));
+                if (permanent == null) {
+                    throw new IllegalStateException("missing battlefield permanent " + fixture.getKey());
+                }
+                for (Map.Entry<String, Integer> counter : fixture.getValue().entrySet()) {
+                    CounterType type = CounterType.findByName(counter.getKey());
+                    if (type == null) {
+                        throw new IllegalArgumentException("unsupported counter type " + counter.getKey());
+                    }
+                    Counter value = type.createInstance(counter.getValue());
+                    permanent.getCounters(game).put(type.getName(), value);
+                }
+            }
+            for (Map.Entry<String, JsonElement> playerSetup : object(scenario, "setup").entrySet()) {
+                for (JsonElement element : array(playerSetup.getValue().getAsJsonObject(), "battlefield")) {
+                    JsonObject fixture = element.getAsJsonObject();
+                    if (!bool(fixture, "tapped", false)) {
+                        continue;
+                    }
+                    String label = requiredString(fixture, "label");
+                    Permanent permanent = game.getPermanent(labels.get(label));
+                    if (permanent == null) {
+                        throw new IllegalStateException("missing battlefield permanent " + label);
+                    }
+                    permanent.setTapped(true);
+                }
+            }
+            ((GameImpl) game).applyEffects();
+        });
+    }
+
+    private boolean hasTappedFixture() {
+        for (Map.Entry<String, JsonElement> playerSetup : object(scenario, "setup").entrySet()) {
+            for (JsonElement element : array(playerSetup.getValue().getAsJsonObject(), "battlefield")) {
+                if (bool(element.getAsJsonObject(), "tapped", false)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private JsonObject result() {
+        boolean reached = checkReach();
+        JsonObject projection = new JsonObject();
+        JsonObject players = new JsonObject();
+        players.add("P0", projectPlayer(playerA));
+        players.add("P1", projectPlayer(playerB));
+        projection.add("players", players);
+
+        List<Permanent> permanents = new ArrayList<>(currentGame.getBattlefield().getAllActivePermanents());
+        permanents.sort(Comparator.comparing(permanent -> labelOf(permanent) == null ? "" : labelOf(permanent)));
+        JsonArray battlefield = new JsonArray();
+        for (Permanent permanent : permanents) {
+            JsonObject item = new JsonObject();
+            String label = labelOf(permanent);
+            if (label == null) {
+                item.add("label", JsonNull.INSTANCE);
+            } else {
+                item.addProperty("label", label);
+            }
+            String attachedTo = permanent.getAttachedTo() == null
+                    ? null
+                    : labelOf(currentGame.getPermanent(permanent.getAttachedTo()));
+            if (attachedTo != null) {
+                item.addProperty("attached_to", attachedTo);
+            }
+            boolean token = permanent instanceof PermanentToken;
+            item.addProperty("name", projectedName(permanent.getName(), token));
+            item.addProperty("token", token);
+            item.addProperty("controller", playerName(permanent.getControllerId()));
+            item.addProperty("tapped", permanent.isTapped());
+            item.add("types", strings(permanent.getCardType(currentGame).stream()
+                    .map(type -> normalizeCharacteristic(type.toString()))
+                    .sorted()
+                    .toList()));
+            item.add("subtypes", strings(permanent.getSubtype(currentGame).stream()
+                    .map(subtype -> normalizeCharacteristic(subtype.getDescription()))
+                    .sorted()
+                    .toList()));
+            item.add("colors", strings(colorCodes(permanent.getColor(currentGame))));
+            item.addProperty("damage", permanent.getDamage());
+            JsonObject counterValues = new JsonObject();
+            permanent.getCounters(currentGame).entrySet().stream()
+                    .sorted(Map.Entry.comparingByKey())
+                    .forEach(entry -> counterValues.addProperty(entry.getKey(), entry.getValue().getCount()));
+            item.add("counters", counterValues);
+            if (permanent.isCreature(currentGame)) {
+                addCharacteristic(item, "power", permanent.getPower());
+                addCharacteristic(item, "toughness", permanent.getToughness());
+            } else {
+                item.add("power", JsonNull.INSTANCE);
+                item.add("toughness", JsonNull.INSTANCE);
+            }
+            Counter loyalty = permanent.getCounters(currentGame).get(CounterType.LOYALTY.getName());
+            if (loyalty == null) {
+                item.add("loyalty", JsonNull.INSTANCE);
+            } else {
+                item.addProperty("loyalty", loyalty.getCount());
+            }
+            battlefield.add(item);
+        }
+        projection.add("battlefield", battlefield);
+        List<String> exile = new ArrayList<>();
+        currentGame.getExile().getAllCards(currentGame).forEach(card -> exile.add(card.getName()));
+        exile.sort(String::compareTo);
+        projection.add("exile", strings(exile));
+        JsonArray legalTargets = initialLegalTargets;
+        if (legalTargets == null) {
+            projection.add("legal_targets", JsonNull.INSTANCE);
+        } else {
+            projection.add("legal_targets", legalTargets);
+        }
+        projection.addProperty("reach", reached);
+        JsonObject result = new JsonObject();
+        result.addProperty("scenario", scenarioName);
+        result.add("projection", projection);
+        result.addProperty("reach", reached);
+        return result;
+    }
+
+    private JsonObject projectPlayer(TestPlayer player) {
+        JsonObject result = new JsonObject();
+        result.addProperty("life", player.getLife());
+        List<String> battlefield = new ArrayList<>();
+        for (Permanent permanent : currentGame.getBattlefield().getAllActivePermanents()) {
+            if (permanent.getControllerId().equals(player.getId())) {
+                battlefield.add(projectedName(permanent));
+            }
+        }
+        battlefield.sort(String::compareTo);
+        result.add("battlefield", strings(battlefield));
+        result.add("hand", strings(sortedNames(player.getHand().getCards(currentGame))));
+        result.add("library", strings(names(player.getLibrary().getCards(currentGame))));
+        result.add("graveyard", strings(sortedNames(player.getGraveyard().getCards(currentGame))));
+        return result;
+    }
+
+    private JsonArray legalTargets() {
+        if (!scenario.has("legal_targets_of")) {
+            return null;
+        }
+        String cardName = requiredString(scenario, "legal_targets_of");
+        TestPlayer active = player(integer(scenario, "active_player", 0));
+        Card card = active.getHand().getCards(currentGame).stream()
+                .filter(candidate -> candidate.getName().equals(cardName))
+                .findFirst()
+                .orElseThrow(() -> new IllegalArgumentException(cardName + " is not in the active player's hand"));
+        SpellAbility ability = card.getSpellAbility();
+        if (ability == null || ability.getTargets().size() != 1) {
+            throw new IllegalArgumentException(cardName + " must have exactly one target slot");
+        }
+        ability.setControllerId(active.getId());
+        Target target = ability.getTargets().get(0);
+        List<String> values = new ArrayList<>();
+        for (UUID id : target.possibleTargets(active.getId(), ability, currentGame)) {
+            String label = labelOf(currentGame.getPermanent(id));
+            if (label == null) {
+                throw new IllegalArgumentException("legal target has no setup label: " + id);
+            }
+            values.add(label);
+        }
+        values.sort(String::compareTo);
+        return strings(values);
+    }
+
+    private boolean checkReach() {
+        if (!scenario.has("reach")) {
+            return true;
+        }
+        JsonObject reach = scenario.getAsJsonObject("reach");
+        long expectedCount = reach.has("count") ? reachCount(reach) : -1;
+        String playerName = string(reach, "player", "P0");
+        if (!playerName.equals("P0") && !playerName.equals("P1")) {
+            throw new IllegalArgumentException("reach player must be P0 or P1");
+        }
+        TestPlayer player = player(playerName.equals("P0") ? 0 : 1);
+        String zone = string(reach, "zone", "graveyard");
+        String card = requiredString(reach, "card");
+        List<String> names = switch (zone) {
+            case "hand" -> names(player.getHand().getCards(currentGame));
+            case "library" -> names(player.getLibrary().getCards(currentGame));
+            case "graveyard" -> names(player.getGraveyard().getCards(currentGame));
+            case "battlefield" -> {
+                List<String> values = new ArrayList<>();
+                for (Permanent permanent : currentGame.getBattlefield().getAllActivePermanents()) {
+                    if (permanent.getControllerId().equals(player.getId())) {
+                        values.add(projectedName(permanent));
+                    }
+                }
+                yield values;
+            }
+            default -> throw new IllegalArgumentException("unsupported reach zone " + zone);
+        };
+        if (zone.equals("battlefield") && expectedCount < 0 && !names.contains(card)) {
+            return false;
+        }
+        if (!zone.equals("battlefield")) {
+            long matchingNames = names.stream().filter(card::equals).count();
+            if (expectedCount >= 0 ? matchingNames != expectedCount : matchingNames == 0) {
+                return false;
+            }
+        }
+        if (!zone.equals("battlefield") && reach.has("counters")) {
+            return false;
+        }
+        if (zone.equals("battlefield")) {
+            long matchingPermanents = currentGame.getBattlefield().getAllActivePermanents().stream()
+                    .filter(candidate -> candidate.getControllerId().equals(player.getId()))
+                    .filter(candidate -> projectedName(candidate).equals(card))
+                    .filter(candidate -> matchesReachCharacteristics(reach, candidate))
+                    .count();
+            if (expectedCount >= 0 ? matchingPermanents != expectedCount : matchingPermanents == 0) {
+                return false;
+            }
+        }
+        for (String label : strings(array(reach, "tapped_labels"))) {
+            UUID id = labels.get(label);
+            if (id == null) {
+                throw new IllegalArgumentException("unknown battlefield label " + label);
+            }
+            Permanent permanent = currentGame.getPermanent(id);
+            if (permanent == null || !permanent.isTapped()) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private long reachCount(JsonObject reach) {
+        JsonElement value = reach.get("count");
+        if (value == null || !value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) {
+            throw new IllegalArgumentException("reach.count must be a non-negative integer");
+        }
+        long count = value.getAsLong();
+        if (count < 0 || value.getAsDouble() != count) {
+            throw new IllegalArgumentException("reach.count must be a non-negative integer");
+        }
+        return count;
+    }
+
+    private boolean matchesReachCharacteristics(JsonObject reach, Permanent permanent) {
+        if (!matchesCharacteristicList(reach, "types", permanent.getCardType(currentGame).stream()
+                .map(type -> normalizeCharacteristic(type.toString()))
+                .toList())
+                || !matchesCharacteristicList(reach, "subtypes", permanent.getSubtype(currentGame).stream()
+                .map(subtype -> normalizeCharacteristic(subtype.getDescription()))
+                .toList())
+                || !matchesCharacteristicList(reach, "colors", colorCodes(permanent.getColor(currentGame)))) {
+            return false;
+        }
+        if (reach.has("creature")) {
+            boolean expected = reach.get("creature").getAsBoolean();
+            if (permanent.isCreature(currentGame) != expected) {
+                return false;
+            }
+        }
+        if (reach.has("power")) {
+            if (!characteristicMatches(reach.get("power"), permanent.isCreature(currentGame)
+                    ? permanent.getPower() : null)) {
+                return false;
+            }
+        }
+        if (reach.has("toughness")) {
+            if (!characteristicMatches(reach.get("toughness"), permanent.isCreature(currentGame)
+                    ? permanent.getToughness() : null)) {
+                return false;
+            }
+        }
+        if (reach.has("power_is_null")
+                && reach.get("power_is_null").getAsBoolean()
+                != (!permanent.isCreature(currentGame) || permanent.getPower() == null)) {
+            return false;
+        }
+        if (reach.has("toughness_is_null")
+                && reach.get("toughness_is_null").getAsBoolean()
+                != (!permanent.isCreature(currentGame) || permanent.getToughness() == null)) {
+            return false;
+        }
+        if (reach.has("attached_to")) {
+            String label = reach.get("attached_to").getAsString();
+            UUID id = labels.get(label);
+            if (id == null) {
+                throw new IllegalArgumentException("unknown battlefield label " + label);
+            }
+            if (!id.equals(permanent.getAttachedTo())) {
+                return false;
+            }
+        }
+        if (reach.has("counters")) {
+            if (!reach.get("counters").isJsonObject()) {
+                throw new IllegalArgumentException("reach.counters must be an object");
+            }
+            for (Map.Entry<String, JsonElement> entry : reach.getAsJsonObject("counters").entrySet()) {
+                JsonElement value = entry.getValue();
+                if (!value.isJsonPrimitive() || !value.getAsJsonPrimitive().isNumber()) {
+                    throw new IllegalArgumentException("reach.counters." + entry.getKey()
+                            + " must be a non-negative integer");
+                }
+                long expected = value.getAsLong();
+                if (expected < 0 || value.getAsDouble() != expected) {
+                    throw new IllegalArgumentException("reach.counters." + entry.getKey()
+                            + " must be a non-negative integer");
+                }
+                String counterName = entry.getKey().toLowerCase(Locale.ROOT);
+                Counter actual = permanent.getCounters(currentGame).entrySet().stream()
+                        .filter(counter -> counter.getKey().toLowerCase(Locale.ROOT).equals(counterName))
+                        .map(Map.Entry::getValue)
+                        .findFirst()
+                        .orElse(null);
+                if ((actual == null ? 0 : actual.getCount()) != expected) {
+                    return false;
+                }
+            }
+        }
+        return !reach.has("tapped") || reach.get("tapped").getAsBoolean() == permanent.isTapped();
+    }
+
+    private String labelOf(Permanent permanent) {
+        if (permanent == null) {
+            return null;
+        }
+        for (Map.Entry<String, UUID> label : labels.entrySet()) {
+            if (label.getValue().equals(permanent.getId())) {
+                return label.getKey();
+            }
+        }
+        return null;
+    }
+
+    private String playerName(UUID playerId) {
+        if (playerId.equals(playerA.getId())) {
+            return "P0";
+        }
+        if (playerId.equals(playerB.getId())) {
+            return "P1";
+        }
+        throw new IllegalArgumentException("unknown permanent controller " + playerId);
+    }
+
+    private TestPlayer player(int index) {
+        return index == 0 ? playerA : playerB;
+    }
+
+    private String projectedName(Permanent permanent) {
+        return projectedName(permanent.getName(), permanent instanceof PermanentToken);
+    }
+
+    static String projectedName(String name, boolean token) {
+        if (token && name.endsWith(" Token")) {
+            return name.substring(0, name.length() - " Token".length());
+        }
+        return name;
+    }
+
+    private static void addCharacteristic(JsonObject item, String key, MageInt characteristic) {
+        if (characteristic == null) {
+            item.add(key, JsonNull.INSTANCE);
+        } else {
+            item.addProperty(key, characteristic.getValue());
+        }
+    }
+
+    private static boolean characteristicMatches(JsonElement expected, MageInt actual) {
+        if (actual == null) {
+            return expected.isJsonNull();
+        }
+        return expected.isJsonPrimitive() && expected.getAsInt() == actual.getValue();
+    }
+
+    private static boolean matchesCharacteristicList(JsonObject reach, String key, List<String> actual) {
+        if (!reach.has(key)) {
+            return true;
+        }
+        List<String> expected = strings(reach.getAsJsonArray(key));
+        expected.replaceAll(CardScenarioProjectionTest::normalizeCharacteristic);
+        expected.sort(String::compareTo);
+        List<String> normalizedActual = new ArrayList<>(actual);
+        normalizedActual.sort(String::compareTo);
+        return expected.equals(normalizedActual);
+    }
+
+    private static List<String> colorCodes(ObjectColor color) {
+        List<String> result = new ArrayList<>();
+        if (color.isWhite()) {
+            result.add("W");
+        }
+        if (color.isBlue()) {
+            result.add("U");
+        }
+        if (color.isBlack()) {
+            result.add("B");
+        }
+        if (color.isRed()) {
+            result.add("R");
+        }
+        if (color.isGreen()) {
+            result.add("G");
+        }
+        result.sort(String::compareTo);
+        return result;
+    }
+
+    private static String normalizeCharacteristic(String value) {
+        String[] words = value.trim().toLowerCase(Locale.ROOT).split("\\s+");
+        for (int index = 0; index < words.length; index++) {
+            if (!words[index].isEmpty()) {
+                words[index] = words[index].substring(0, 1).toUpperCase(Locale.ROOT)
+                        + words[index].substring(1);
+            }
+        }
+        return String.join(" ", words);
+    }
+
+    private static void rejectUnknownKeys(JsonObject object, Set<String> allowed, String context) {
+        for (String key : object.keySet()) {
+            if (!allowed.contains(key)) {
+                throw new IllegalArgumentException(context + "." + key + " is unsupported");
+            }
+        }
+    }
+
+    private static JsonObject object(JsonObject parent, String key) {
+        JsonElement value = parent.get(key);
+        return value == null || value.isJsonNull() ? new JsonObject() : value.getAsJsonObject();
+    }
+
+    private static JsonArray array(JsonObject parent, String key) {
+        JsonElement value = parent.get(key);
+        return value == null || value.isJsonNull() ? new JsonArray() : value.getAsJsonArray();
+    }
+
+    private static String cardName(JsonElement value) {
+        if (value.isJsonPrimitive()) {
+            return value.getAsString();
+        }
+        JsonObject card = value.getAsJsonObject();
+        rejectUnknownKeys(card, Set.of("card", "label"), "card setup");
+        return requiredString(card, "card");
+    }
+
+    private static List<String> strings(JsonArray values) {
+        List<String> result = new ArrayList<>();
+        values.forEach(value -> result.add(value.getAsString()));
+        return result;
+    }
+
+    private static JsonArray strings(Collection<String> values) {
+        JsonArray result = new JsonArray();
+        values.forEach(result::add);
+        return result;
+    }
+
+    private static List<String> names(Collection<? extends Card> cards) {
+        List<String> result = new ArrayList<>();
+        cards.forEach(card -> result.add(card.getName()));
+        return result;
+    }
+
+    private static List<String> sortedNames(Collection<? extends Card> cards) {
+        List<String> result = names(cards);
+        result.sort(String::compareTo);
+        return result;
+    }
+
+    private static String requiredString(JsonObject object, String key) {
+        JsonElement value = object.get(key);
+        if (value == null || !value.isJsonPrimitive()) {
+            throw new IllegalArgumentException(key + " is required");
+        }
+        return value.getAsString();
+    }
+
+    private static String string(JsonObject object, String key, String fallback) {
+        JsonElement value = object.get(key);
+        return value == null || value.isJsonNull() ? fallback : value.getAsString();
+    }
+
+    private static int integer(JsonObject object, String key, int fallback) {
+        JsonElement value = object.get(key);
+        return value == null || value.isJsonNull() ? fallback : exactInteger(value, key);
+    }
+
+    private static int exactInteger(JsonElement value, String context) {
+        try {
+            return value.getAsBigDecimal().intValueExact();
+        } catch (ArithmeticException | NumberFormatException error) {
+            throw new IllegalArgumentException(context + " must be an integer", error);
+        }
+    }
+
+    private static boolean bool(JsonObject object, String key, boolean fallback) {
+        JsonElement value = object.get(key);
+        return value == null || value.isJsonNull() ? fallback : value.getAsBoolean();
+    }
+}
