diff --git a/src/magebench/pilot/external.py b/src/magebench/pilot/external.py
new file mode 100644
index 00000000..3263fc44
--- /dev/null
+++ b/src/magebench/pilot/external.py
@@ -0,0 +1,66 @@
+"""Bridge-only pilot for games controlled by an external MCP client."""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+from pathlib import Path
+
+from magebench.common.log import setup_logging
+from magebench.pilot.bridge_transport import build_bridge_launch_args, spawn_bridge_http
+
+
+async def run_external(
+    *,
+    server: str,
+    port: int,
+    username: str,
+    project_root: Path,
+    game_dir: Path,
+    deck_path: Path | None,
+) -> None:
+    launch_args = build_bridge_launch_args(
+        server=server,
+        port=port,
+        username=username,
+        deck_path=deck_path,
+        error_log_path=game_dir / f"{username}_errors.log",
+    )
+    async with spawn_bridge_http(
+        mvn_args=launch_args.mvn_args,
+        project_root=project_root,
+        jvm_args=launch_args.jvm_args,
+        log_file=game_dir / f"{username}_mcp.log",
+        url_file=game_dir / f"{username}_mcp_url.txt",
+    ) as session:
+        await session.initialize()
+        # The orchestrator owns game lifetime and terminates bridge clients
+        # after XMage ends the game.
+        await asyncio.Event().wait()
+
+
+def main() -> int:
+    setup_logging()
+    parser = argparse.ArgumentParser(description="Bridge-only external MCP pilot")
+    parser.add_argument("--server", default="localhost")
+    parser.add_argument("--port", type=int, default=17171)
+    parser.add_argument("--username", required=True)
+    parser.add_argument("--project-root", type=Path, required=True)
+    parser.add_argument("--game-dir", type=Path, required=True)
+    parser.add_argument("--deck", type=Path)
+    args = parser.parse_args()
+    asyncio.run(
+        run_external(
+            server=args.server,
+            port=args.port,
+            username=args.username,
+            project_root=args.project_root.resolve(),
+            game_dir=args.game_dir.resolve(),
+            deck_path=args.deck.resolve() if args.deck else None,
+        )
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/test_external_pilot.py b/tests/test_external_pilot.py
new file mode 100644
index 00000000..f7eb793d
--- /dev/null
+++ b/tests/test_external_pilot.py
@@ -0,0 +1,28 @@
+"""Tests for the bridge-only external player configuration."""
+
+import json
+from pathlib import Path
+
+from magebench.orchestration.config import Config, ExternalPlayer
+
+
+def test_external_player_reserves_bridge_seat(tmp_path: Path) -> None:
+    config_path = tmp_path / "external.json"
+    log_dir = tmp_path / "logs"
+    config_path.write_text(
+        json.dumps(
+            {
+                "deckType": "Constructed - Standard",
+                "logDir": str(log_dir),
+                "players": [{"type": "external", "name": "DiffA", "deck": "decks/green.dck"}],
+            }
+        )
+    )
+    config = Config(config_file=config_path)
+    config.load_config()
+
+    players = json.loads(config.get_players_config_json())["players"]
+
+    assert players == [{"type": "bridge", "name": "DiffA", "deck": "decks/green.dck"}]
+    assert config.external_players == [ExternalPlayer(name="DiffA", deck="decks/green.dck")]
+    assert config.log_dir == log_dir
