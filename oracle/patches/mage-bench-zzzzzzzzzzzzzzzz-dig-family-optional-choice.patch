+    private boolean isLookLibraryAndPickPrompt(Ability source) {
+        return source != null && source.getEffects().stream()
+                .anyMatch(LookLibraryAndPickControllerEffect.class::isInstance);
+    }
+
+    private void validateScenarioOptionalSource(ScenarioOptionalAnswer choice, Ability source) {
+        UUID actualSourceId = source == null ? null : source.getSourceId();
+        if (choice.sourceId() != null && !choice.sourceId().equals(actualSourceId)) {
+            throw new IllegalStateException(
+                    "choose_optional source mismatch: expected " + choice.sourceId()
+                            + ", got " + actualSourceId);
+        }
+    }
+
+    private void consumeScenarioOptionalAnswer(String answer, Ability source) {
+        if (scenarioOptionalAnswers.isEmpty()) {
+            return;
+        }
+        ScenarioOptionalAnswer scripted = scenarioOptionalAnswers.peekFirst();
+        if (!scripted.answer().equals(answer)) {
+            throw new IllegalStateException(
+                    "chooseUse consumed " + answer + " instead of scripted " + scripted.answer());
+        }
+        validateScenarioOptionalSource(scripted, source);
+        scenarioOptionalAnswers.removeFirst();
+    }
+
     private boolean isFirebenderCopyPrompt(Ability source, Game game) {
         MageObject sourceObject = source == null ? null : source.getSourceObject(game);
         return sourceObject != null && sourceObject.getName().equals("Firebender Ascension");
