+    public void castPlayableSpellFromExile(UUID sourceId, Game game) {
+        if (sourceId == null) {
+            throw new IllegalArgumentException("exile spell source id is required");
+        }
+        if (game.getExile().getAllCards(game).stream()
+                .noneMatch(card -> sourceId.equals(card.getId()))) {
+            throw new IllegalStateException("spell object is not in exile: " + sourceId);
+        }
+        List<SpellAbility> matches = computerPlayer.getPlayable(game, true, Zone.EXILED, false).stream()
+                .filter(SpellAbility.class::isInstance)
+                .map(SpellAbility.class::cast)
+                .filter(ability -> sourceId.equals(ability.getSourceId()))
+                .collect(Collectors.toList());
+        if (matches.size() != 1) {
+            throw new IllegalStateException(
+                    "expected exactly one playable exile spell ability for object "
+                            + sourceId + ", found " + matches.size());
+        }
+        if (!computerPlayer.activateAbility(matches.get(0).copy(), game)) {
+            throw new IllegalStateException("could not cast exiled spell object " + sourceId);
+        }
+        if (game.getStack().stream().noneMatch(stackObject -> sourceId.equals(stackObject.getSourceId()))) {
+            throw new IllegalStateException("exiled spell object " + sourceId + " was not put on the stack");
+        }
+        if (game.getExile().getAllCards(game).stream()
+                .anyMatch(card -> sourceId.equals(card.getId()))) {
+            throw new IllegalStateException("exiled spell object " + sourceId + " remained in exile");
+        }
+    }
+
