@@ -0,0 +1,117 @@
+package org.mage.test.serverside;
+
+import mage.cards.repository.CardRepository;
+import mage.cards.repository.ExpansionRepository;
+import mage.server.AuthorizedUserRepository;
+import org.junit.Assert;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.concurrent.TimeUnit;
+
+public final class ConcurrentH2RepositoryInitializationTest {
+
+    @Rule
+    public TemporaryFolder temporaryFolder = new TemporaryFolder();
+
+    @Test
+    public void concurrentRepositoryInitializationAcrossJvmProcesses() throws Exception {
+        String java = Path.of(System.getProperty("java.home"), "bin", "java").toString();
+        String classPath = absoluteClassPath(System.getProperty("surefire.test.class.path"));
+
+        for (int round = 0; round < 5; round++) {
+            Path workingDirectory = temporaryFolder.newFolder("round-" + round).toPath();
+            Path rendezvous = workingDirectory.resolve("rendezvous");
+            Files.createDirectories(rendezvous);
+
+            Process first = startChild(java, classPath, workingDirectory, rendezvous, "first", "second");
+            Process second = startChild(java, classPath, workingDirectory, rendezvous, "second", "first");
+
+            boolean firstFinished = first.waitFor(60, TimeUnit.SECONDS);
+            boolean secondFinished = second.waitFor(60, TimeUnit.SECONDS);
+            if (!firstFinished || !secondFinished) {
+                first.destroyForcibly();
+                second.destroyForcibly();
+                Assert.fail("child JVM timed out in round " + round);
+            }
+            String firstOutput = Files.readString(workingDirectory.resolve("first.log"));
+            String secondOutput = Files.readString(workingDirectory.resolve("second.log"));
+            Assert.assertEquals("round " + round + " first JVM output:\n" + firstOutput, 0, first.exitValue());
+            Assert.assertEquals("round " + round + " second JVM output:\n" + secondOutput, 0, second.exitValue());
+            Assert.assertFalse(firstOutput, firstOutput.contains("already exists"));
+            Assert.assertFalse(secondOutput, secondOutput.contains("already exists"));
+            Assert.assertTrue(firstOutput, firstOutput.contains("repositories initialized"));
+            Assert.assertTrue(secondOutput, secondOutput.contains("repositories initialized"));
+        }
+    }
+
+    private static Process startChild(
+            String java,
+            String classPath,
+            Path workingDirectory,
+            Path rendezvous,
+            String childName,
+            String otherName
+    ) throws IOException {
+        Path output = workingDirectory.resolve(childName + ".log");
+        return new ProcessBuilder(
+                java,
+                "-cp",
+                classPath,
+                Initializer.class.getName(),
+                rendezvous.toString(),
+                childName,
+                otherName
+        )
+                .directory(workingDirectory.toFile())
+                .redirectErrorStream(true)
+                .redirectOutput(output.toFile())
+                .start();
+    }
+
+    private static String absoluteClassPath(String classPath) {
+        if (classPath == null || classPath.isBlank()) {
+            throw new IllegalStateException("Surefire test classpath is unavailable");
+        }
+        String[] entries = classPath.split(java.util.regex.Pattern.quote(File.pathSeparator));
+        StringBuilder result = new StringBuilder();
+        for (String entry : entries) {
+            if (result.length() > 0) {
+                result.append(File.pathSeparator);
+            }
+            result.append(Path.of(entry).toAbsolutePath().normalize());
+        }
+        return result.toString();
+    }
+
+    public static final class Initializer {
+
+        public static void main(String[] args) throws Exception {
+            Path rendezvous = Path.of(args[0]);
+            String childName = args[1];
+            String otherName = args[2];
+            Files.createFile(rendezvous.resolve(childName));
+
+            long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(30);
+            while (!Files.exists(rendezvous.resolve(otherName))) {
+                if (System.nanoTime() >= deadline) {
+                    throw new IllegalStateException("other child JVM did not reach initialization barrier");
+                }
+                Thread.sleep(10);
+            }
+
+            CardRepository.instance.findCard("Forest");
+            if (!ExpansionRepository.instance.instanceInitialized) {
+                throw new IllegalStateException("ExpansionRepository did not initialize");
+            }
+            ExpansionRepository.instance.getAll();
+            AuthorizedUserRepository.getInstance().getByName("initialization-probe");
+            System.out.println("repositories initialized");
+        }
+    }
+}
