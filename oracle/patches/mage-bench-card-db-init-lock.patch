diff --git a/Mage.Tests/src/test/java/org/mage/test/serverside/ConcurrentH2RepositoryInitializationTest.java b/Mage.Tests/src/test/java/org/mage/test/serverside/ConcurrentH2RepositoryInitializationTest.java
