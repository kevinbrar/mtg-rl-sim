+    public static void withH2InitializationLock(String url, H2InitializationBlock initialization) throws SQLException {
+        Path dbPath = getH2FilePath(url);
+        if (dbPath == null || dbPath.getFileName() == null) {
+            throw new IllegalArgumentException("H2 initialization lock requires a file database URL: " + url);
+        }
+        Path dbDirectory = dbPath.toAbsolutePath().normalize().getParent();
+        Path lockPath = dbDirectory.resolve(dbPath.getFileName() + ".init.lock");
+
+        synchronized (H2_INITIALIZATION_MONITOR) {
+            try {
+                Files.createDirectories(dbDirectory);
+                try (FileChannel channel = FileChannel.open(lockPath, StandardOpenOption.CREATE, StandardOpenOption.WRITE);
+                     FileLock lock = channel.lock()) {
+                    initialization.run();
+                }
+            } catch (IOException e) {
+                throw new UncheckedIOException("Failed to lock H2 initialization for " + url, e);
+            }
+        }
+    }
