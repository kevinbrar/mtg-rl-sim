diff --git a/Mage.Tests/src/test/java/org/mage/test/player/TestPlayerFirebenderCopyChoiceTest.java b/Mage.Tests/src/test/java/org/mage/test/player/TestPlayerFirebenderCopyChoiceTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..9ce07a2d6edf3e833885b6ee99f8a1da89d965b4
--- /dev/null
+++ b/Mage.Tests/src/test/java/org/mage/test/player/TestPlayerFirebenderCopyChoiceTest.java
@@ -0,0 +1,61 @@
+package org.mage.test.player;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.List;
+
+public final class TestPlayerFirebenderCopyChoiceTest {
+
+    @Test
+    public void copyPromptRequiresAScriptedChoiceAndConsumesItOnce() {
+        ArrayDeque<TestPlayer.FirebenderCopyChoice> choices = new ArrayDeque<>();
+        Assert.assertThrows(
+                IllegalStateException.class,
+                () -> TestPlayer.takeFirebenderCopyChoice(choices));
+
+        TestPlayer.FirebenderCopyChoice choice = new TestPlayer.FirebenderCopyChoice(
+                true, TestPlayer.CopyTargetMode.CHANGE, List.of("defender-b"));
+        choices.add(choice);
+        Assert.assertEquals(choice, TestPlayer.takeFirebenderCopyChoice(choices));
+        Assert.assertTrue(choices.isEmpty());
+    }
+
+    @Test
+    public void unconsumedCopyChoiceOrTargetDecisionFailsClosed() {
+        ArrayDeque<TestPlayer.FirebenderCopyChoice> choices = new ArrayDeque<>();
+        choices.add(new TestPlayer.FirebenderCopyChoice(
+                false, TestPlayer.CopyTargetMode.NONE, List.of()));
+        Assert.assertThrows(
+                IllegalStateException.class,
+                () -> TestPlayer.assertNoScriptedFirebenderCopyChoices(choices, null, List.of()));
+
+        choices.clear();
+        TestPlayer.FirebenderCopyChoice pending = new TestPlayer.FirebenderCopyChoice(
+                true, TestPlayer.CopyTargetMode.KEEP, List.of());
+        Assert.assertThrows(
+                IllegalStateException.class,
+                () -> TestPlayer.assertNoScriptedFirebenderCopyChoices(choices, pending, List.of()));
+        Assert.assertThrows(
+                IllegalStateException.class,
+                () -> TestPlayer.assertNoScriptedFirebenderCopyChoices(
+                        choices, null, List.of("@defender-b")));
+    }
+
+    @Test
+    public void copyRetargetUsesItsOwnQueueInsteadOfTheOriginalTargetQueue() {
+        TestPlayer.FirebenderCopyChoice choice = new TestPlayer.FirebenderCopyChoice(
+                true, TestPlayer.CopyTargetMode.CHANGE, List.of("defender-b"));
+        List<String> originalTargets = new ArrayList<>(List.of("@defender-a"));
+        List<String> copyTargets = new ArrayList<>(
+                List.of(TestPlayer.firebenderCopyTargetDefinition(choice)));
+
+        Assert.assertEquals(List.of("@defender-b"), TestPlayer.targetDefinitionsForChoose(
+                originalTargets, copyTargets, true, true, 4));
+        Assert.assertEquals(List.of("@defender-a"), TestPlayer.targetDefinitionsForChoose(
+                originalTargets, copyTargets, false, true, 4));
+        Assert.assertEquals(List.of("@defender-a"), originalTargets);
+    }
+}
