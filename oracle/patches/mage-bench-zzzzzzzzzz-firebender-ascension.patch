+package org.mage.test.player;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import java.util.ArrayDeque;
+import java.util.List;
+
+public final class TestPlayerFirebenderCopyChoiceTest {
+
+    @Test
+    public void copyPromptRequiresAScriptedChoiceAndConsumesItOnce() {
+        ArrayDeque<TestPlayer.FirebenderCopyChoice> choices = new ArrayDeque<>();
+        Assert.assertThrows(
+                IllegalStateException.class,
+                () -> TestPlayer.takeFirebenderCopyChoice(choices));
+
+        TestPlayer.FirebenderCopyChoice choice = new TestPlayer.FirebenderCopyChoice(
+                true, TestPlayer.CopyTargetMode.CHANGE, List.of("defender-b"));
+        choices.add(choice);
+        Assert.assertEquals(choice, TestPlayer.takeFirebenderCopyChoice(choices));
+        Assert.assertTrue(choices.isEmpty());
+    }
+
+    @Test
+    public void unconsumedCopyChoiceOrTargetDecisionFailsClosed() {
+        ArrayDeque<TestPlayer.FirebenderCopyChoice> choices = new ArrayDeque<>();
+        choices.add(new TestPlayer.FirebenderCopyChoice(
+                false, TestPlayer.CopyTargetMode.NONE, List.of()));
+        Assert.assertThrows(
+                IllegalStateException.class,
+                () -> TestPlayer.assertNoScriptedFirebenderCopyChoices(choices, null));
+
+        choices.clear();
+        TestPlayer.FirebenderCopyChoice pending = new TestPlayer.FirebenderCopyChoice(
+                true, TestPlayer.CopyTargetMode.KEEP, List.of());
+        Assert.assertThrows(
+                IllegalStateException.class,
+                () -> TestPlayer.assertNoScriptedFirebenderCopyChoices(choices, pending));
+    }
+}
