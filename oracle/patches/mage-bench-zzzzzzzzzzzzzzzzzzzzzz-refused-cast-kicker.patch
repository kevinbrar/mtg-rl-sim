+    /**
+     * Queues the answer of an expected-refusal attempt ahead of the answers scripted for later steps.
+     */
+    public void addRefusalOptionalAnswer(boolean accept) {
+        if (refusalOptionalAnswer != null) {
+            throw new IllegalStateException("an expected-refusal optional answer is already queued");
+        }
+        refusalOptionalAnswer = new ScenarioOptionalAnswer(accept ? "Yes" : "No", null);
+        scenarioOptionalAnswers.addFirst(refusalOptionalAnswer);
+        choices.add(0, refusalOptionalAnswer.answer());
+    }
+
+    /**
+     * Removes the expected-refusal answer when no prompt consumed it: a cast that is not offered asks nothing.
+     */
+    public void finishRefusalOptionalAnswer() {
+        ScenarioOptionalAnswer queued = refusalOptionalAnswer;
+        refusalOptionalAnswer = null;
+        if (queued == null || scenarioOptionalAnswers.peekFirst() != queued) {
+            return;
+        }
+        if (choices.isEmpty() || !choices.get(0).equals(queued.answer())) {
+            throw new IllegalStateException(
+                    "expected-refusal optional answer is not first in the choice queue: " + queued.answer());
+        }
+        scenarioOptionalAnswers.removeFirst();
+        choices.remove(0);
+    }
