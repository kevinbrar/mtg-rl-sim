+
+        var result = handler.chooseAction(
+            null, null, false, null, null, null, null, new String[]{"RED"}, false, null, null
+        );
+
+        assertThat(result.success).isFalse();
+        assertThat(result.error_code).isEqualTo("invalid_mana_plan");
+    }
