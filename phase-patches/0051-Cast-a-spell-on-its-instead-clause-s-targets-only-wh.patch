--- /dev/null
+++ b/crates/engine/tests/integration/instead_target_needs_payable_additional_cost.rs
@@ -0,0 +1,127 @@
+//! CR 601.2b-c + CR 601.2f: when only the targets of a spell's "instead"
+//! clause can be chosen, the spell is cast with the additional cost that
+//! clause reads. If that cost can't be paid with the rest of the total cost,
+//! the spell can't be cast.
+
+use engine::game::casting::can_cast_object_now;
+use engine::game::scenario::{GameScenario, P0, P1};
+use engine::types::identifiers::ObjectId;
+use engine::types::mana::{ManaCost, ManaType, ManaUnit};
+use engine::types::phase::Phase;
+
+const BLOODCHIEFS_THIRST: &str = "Kicker {2}{B} (You may pay an additional {2}{B} as you cast this spell.)\nDestroy target creature or planeswalker with mana value 2 or less. If this spell was kicked, instead destroy target creature or planeswalker.";
+const DIVINE_RESILIENCE: &str = "Kicker {2}{W} (You may pay an additional {2}{W} as you cast this spell.)\nTarget creature you control gains indestructible until end of turn. If this spell was kicked, instead any number of target creatures you control gain indestructible until end of turn.";
+const CRUEL_ALLIANCE: &str = "Teamwork 2 (As an additional cost to cast this spell, you may tap any number of creatures you control with total power 2 or more.)\nExile target creature with mana value 3 or less. If this spell was cast using teamwork, instead exile target creature and you gain 3 life.";
+
+struct Board {
+    mana: usize,
+    opposing_mana_value: u32,
+    /// Power and tapped state of P0's one creature.
+    own_creature: Option<(i32, bool)>,
+}
+
+fn castable(oracle: &str, mana_cost: ManaCost, mana_type: ManaType, board: Board) -> bool {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    scenario.with_mana_pool(
+        P0,
+        (0..board.mana)
+            .map(|_| ManaUnit::new(mana_type, ObjectId(0), false, vec![]))
+            .collect(),
+    );
+    scenario
+        .add_creature(P1, "Opposing", 6, 6)
+        .with_mana_cost(ManaCost::generic(board.opposing_mana_value));
+    // Mana value 4: never a legal target of either base clause.
+    let own = board.own_creature.map(|(power, tapped)| {
+        let id = scenario
+            .add_creature(P0, "Own", power, 4)
+            .with_mana_cost(ManaCost::generic(4))
+            .id();
+        (id, tapped)
+    });
+    let spell = scenario
+        .add_spell_to_hand_from_oracle(P0, "Spell", false, oracle)
+        .with_mana_cost(mana_cost)
+        .id();
+    let mut runner = scenario.build();
+    if let Some((id, tapped)) = own {
+        runner.state_mut().objects.get_mut(&id).unwrap().tapped = tapped;
+    }
+    can_cast_object_now(runner.state(), P0, spell)
+}
+
+fn black(generic: u32) -> ManaCost {
+    ManaCost::Cost {
+        shards: vec![engine::types::mana::ManaCostShard::Black],
+        generic,
+    }
+}
+
+#[test]
+fn kicked_only_target_needs_an_affordable_kicker() {
+    let thirst = |black_mana, opposing_mana_value| {
+        castable(
+            BLOODCHIEFS_THIRST,
+            black(0),
+            ManaType::Black,
+            Board {
+                mana: black_mana,
+                opposing_mana_value,
+                own_creature: None,
+            },
+        )
+    };
+    // {B} + kicker {2}{B} = four mana.
+    assert!(!thirst(1, 5));
+    assert!(!thirst(3, 5));
+    assert!(thirst(4, 5));
+    // The base clause has its own legal target: no kicker needed.
+    assert!(thirst(1, 2));
+}
+
+#[test]
+fn teamwork_only_target_needs_creatures_to_tap() {
+    let alliance = |opposing_mana_value, own_creature| {
+        castable(
+            CRUEL_ALLIANCE,
+            black(2),
+            ManaType::Black,
+            Board {
+                mana: 3,
+                opposing_mana_value,
+                own_creature,
+            },
+        )
+    };
+    assert!(!alliance(6, None));
+    assert!(!alliance(6, Some((1, false))));
+    assert!(!alliance(6, Some((2, true))));
+    assert!(alliance(6, Some((2, false))));
+    // The base clause has its own legal target: no teamwork needed.
+    assert!(alliance(3, None));
+}
+
+/// CR 601.2c: the kicked text takes any number of targets, so with no creature
+/// you control the kicked spell is cast with none, and the unkicked one can't be.
+#[test]
+fn kicked_any_number_of_targets_needs_an_affordable_kicker() {
+    let resilience = |mana| {
+        castable(
+            DIVINE_RESILIENCE,
+            ManaCost::Cost {
+                shards: vec![engine::types::mana::ManaCostShard::White],
+                generic: 0,
+            },
+            ManaType::White,
+            Board {
+                mana,
+                opposing_mana_value: 6,
+                own_creature: None,
+            },
+        )
+    };
+    assert!(!resilience(1));
+    assert!(!resilience(3));
+    assert!(resilience(4));
+}
