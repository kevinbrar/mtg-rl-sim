+/// CR 601.2c: whether a spell's targets can be chosen, and on what terms.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum SpellTargetLegality {
+    /// No legal choice of targets exists.
+    None,
+    /// The targets the spell requires as printed can be chosen.
+    Legal,
+    /// CR 601.2b-c: only the targets of an "instead" clause can be chosen, so
+    /// the spell can be cast only with the additional cost that clause reads.
+    OnlyWithAdditionalCost,
+}
+
+fn spell_target_legality_with_probe(
+    state: &GameState,
+    object_id: ObjectId,
+    player: PlayerId,
+    probe: Option<&PriorityCastProbe>,
+) -> SpellTargetLegality {
     with_flushed_cast_state(state, player, probe, |flushed| {
-        spell_has_legal_targets_in_flushed_state(flushed, object_id, player)
+        spell_target_legality_in_flushed_state(flushed, object_id, player)
     })
 }
 
+fn spell_has_legal_targets_in_flushed_state(
+    state: &GameState,
+    object_id: ObjectId,
+    player: PlayerId,
+) -> bool {
+    spell_target_legality_in_flushed_state(state, object_id, player) != SpellTargetLegality::None
+}
+
+/// CR 601.2b + CR 601.2f: whether an optional additional cost of the spell
+/// (a kicker, or a queued cost such as Teamwork or Bargain) can be paid with
+/// the spell's total cost. A spell whose only legal targets belong to its
+/// "instead" clause can be cast only when one can.
+fn optional_additional_cost_is_payable(
+    state: &GameState,
+    player: PlayerId,
+    prepared: &PreparedSpellCast,
+) -> bool {
+    let pending = castability_pending_cast(prepared, player);
+    let printed = state
+        .objects
+        .get(&prepared.object_id)
+        .and_then(|obj| obj.additional_cost.clone());
+    let queued =
+        casting_costs::build_effective_additional_cost_queue(state, player, prepared.object_id)
+            .into_iter()
+            .map(|instance| instance.cost);
+    printed.into_iter().chain(queued).any(|additional| {
+        let costs = match additional {
+            AdditionalCost::Kicker { costs, .. } => costs,
+            AdditionalCost::Optional { cost, .. } => vec![cost],
+            AdditionalCost::Required(_) | AdditionalCost::Choice(..) => Vec::new(),
+        };
+        costs.into_iter().any(|cost| {
+            casting_costs::additional_cost_declaration_is_offerable(state, player, &pending, cost)
+                .unwrap_or(false)
+        })
+    })
+}
+
+/// The cast a castability check prices an additional cost against.
+fn castability_pending_cast(prepared: &PreparedSpellCast, player: PlayerId) -> PendingCast {
+    let resolved = prepared.ability_def.as_ref().map_or_else(
+        || ResolvedAbility::new(Effect::NoOp, Vec::new(), prepared.object_id, player),
+        |def| build_resolved_from_def(def, prepared.object_id, player),
+    );
+    let mut pending = PendingCast::new(
+        prepared.object_id,
+        prepared.card_id,
+        resolved,
+        prepared.mana_cost.clone(),
+    );
+    pending.base_cost = Some(prepared.base_mana_cost.clone());
+    pending.casting_variant = prepared.casting_variant;
+    pending.cast_timing_permission = prepared.cast_timing_permission;
+    pending.origin_zone = prepared.origin_zone;
+    pending.payment_mode = prepared.payment_mode;
+    pending
+}
