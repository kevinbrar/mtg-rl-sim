+#[test]
+fn march_exile_reduction_pins_maximum_x() {
+    const ORACLE: &str = "As an additional cost to cast this spell, you may exile any number of white cards from your hand. This spell costs {2} less to cast for each card exiled this way.\nExile target artifact, creature, or enchantment with mana value X or less.";
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let march = scenario
+        .add_spell_to_hand_from_oracle(P0, "March of Otherworldly Light", true, ORACLE)
+        .with_mana_cost(ManaCost::Cost {
+            shards: vec![ManaCostShard::X, ManaCostShard::White],
+            generic: 0,
+        })
+        .id();
+    let prior_exiled_white_card = scenario
+        .add_spell_to_exile(P0, "Prior white exile", true)
+        .with_mana_cost(ManaCost::Cost {
+            shards: vec![ManaCostShard::White],
+            generic: 0,
+        })
+        .id();
+    let white_cards: Vec<_> = (0..2)
+        .map(|_| {
+            scenario
+                .add_spell_to_hand_from_oracle(P0, "White card", true, "")
+                .with_mana_cost(ManaCost::Cost {
+                    shards: vec![ManaCostShard::White],
+                    generic: 0,
+                })
+                .id()
+        })
+        .collect();
+    let white_lands: Vec<_> = (0..3)
+        .map(|_| scenario.add_basic_land(P0, ManaColor::White))
+        .collect();
+    scenario.add_creature(P1, "Memnite", 1, 1);
+    let mut runner = scenario.build();
+    let prior_tracked_set_id = engine::types::identifiers::TrackedSetId(
+        runner
+            .state()
+            .tracked_object_sets
+            .keys()
+            .map(|id| id.0)
+            .max()
+            .unwrap_or_default()
+            .max(runner.state().next_tracked_set_id)
+            + 1,
+    );
+    {
+        let state = runner.state_mut();
+        state
+            .tracked_object_sets
+            .insert(prior_tracked_set_id, vec![prior_exiled_white_card]);
+        state.tracked_set_member_causes.insert(
+            prior_tracked_set_id,
+            [(
+                prior_exiled_white_card,
+                engine::types::ability::ThisWayCause::Exiled,
+            )]
+            .into_iter()
+            .collect(),
+        );
+        state.chain_tracked_set_id = Some(prior_tracked_set_id);
+        state.next_tracked_set_id = prior_tracked_set_id.0 + 1;
+    }
+    let card_id = runner.state().objects[&march].card_id;
+    runner
+        .act(GameAction::CastSpell {
+            object_id: march,
+            card_id,
+            targets: vec![],
+            payment_mode: CastPaymentMode::Auto,
+        })
+        .expect("March should begin casting");
+    assert!(matches!(
+        runner.state().waiting_for,
+        WaitingFor::ChooseXValue { max: 6, .. }
+    ));
+    runner
+        .act(GameAction::ChooseX { value: 2 })
+        .expect("announce a payable X after accounting for the exile reduction");
+    let cost_before_selecting_exiles = match &runner.state().waiting_for {
+        WaitingFor::OptionalCostChoice { pending_cast, .. } => pending_cast.cost.clone(),
+        other => panic!("expected optional cost choice, got {other:?}"),
+    };
+    assert!(matches!(
+        runner.state().waiting_for,
+        WaitingFor::OptionalCostChoice { .. }
+    ));
+    runner
+        .act(GameAction::DecideOptionalCost { pay: true })
+        .expect("accept the optional exile cost");
+    assert!(matches!(
+        runner.state().waiting_for,
+        WaitingFor::PayCost {
+            kind: PayCostKind::ExileFromZone { .. },
+            ..
+        }
+    ));
+    let cost_before_new_exile_set_is_published = match &runner.state().waiting_for {
+        WaitingFor::PayCost {
+            resume:
+                CostResume::SpellCost {
+                    spell: pending_cast,
+                    ..
+                },
+            ..
+        } => pending_cast.cost.clone(),
+        other => panic!("expected exile cost choice, got {other:?}"),
+    };
+    assert_eq!(
+        cost_before_new_exile_set_is_published, cost_before_selecting_exiles,
+        "an unrelated prior exile set must not discount the cast before this cost's selection"
+    );
+    runner
+        .act(GameAction::SelectCards { cards: white_cards })
+        .expect("exile both eligible white cards");
+    assert_eq!(
+        tapped_land_count(&runner, &white_lands),
+        1,
+        "the two exiled cards reduce X=2 March's generic cost to {{W}}"
+    );
+    assert!(
+        runner.state().stack.iter().any(|entry| entry.id == march),
+        "March must reach the stack after the exile cost and reduced mana payment"
+    );
+}
