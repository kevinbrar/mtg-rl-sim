+    fn castable(requirement: &str, candidate_count: usize, land_count: usize, expected: bool) {
+        let oracle = format!(
+            "As an additional cost to cast this spell, you may sacrifice {requirement}. This spell costs {{1}} less to cast for each permanent sacrificed this way."
