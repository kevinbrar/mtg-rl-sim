+/// CR 601.2b + CR 601.2f: Preview whether an optional any-number this-way
+/// movement cost can reduce the total enough to make the cast payable.
+fn any_number_this_way_cost_makes_payable(
+    state: &GameState,
+    player: PlayerId,
+    spell_id: ObjectId,
+    cost: &AbilityCost,
+    total: &ManaCost,
+    mut can_pay: impl FnMut(&GameState, &ManaCost) -> bool,
+) -> bool {
+    let Some((movement, cost_filter)) = any_number_this_way_cost_parts(cost) else {
+        return false;
+    };
+    let mut candidates =
+        any_number_this_way_cost_candidates(state, player, spell_id, movement, cost_filter);
+    if matches!(movement, AnyNumberThisWayCostMovement::Exiled(_)) {
+        let capacity =
+            any_number_this_way_cost_reduction_capacity(state, spell_id, movement, &candidates);
+        let mut reduced = total.reduced_by_generic(capacity);
+        if !cost_has_x(&reduced) {
+            super::casting::apply_cost_floor(state, player, spell_id, &mut reduced);
+        }
+        return can_pay(state, &reduced);
+    }
+
+    // CR 601.2g + CR 601.2h: Prefer choices absent from auto-tap's live source
+    // collection, then remove chosen permanents before feasibility so they cannot
+    // supply mana too. This conservative preview may undercount tap-then-sacrifice.
+    let mana_source_ids: HashSet<_> =
+        collect_sorted_auto_tap_source_options(state, player, None, &HashSet::new(), None)
+            .into_iter()
+            .map(|source| source.object_id)
+            .collect();
+    candidates.sort_by_key(|id| mana_source_ids.contains(id));
+    let sacrifice_counts: Vec<usize> = match cost {
+        AbilityCost::Sacrifice(cost) if cost.requirement.is_any_number() => {
+            (1..=candidates.len()).collect()
+        }
+        AbilityCost::Sacrifice(cost) => cost
+            .requirement
+            .fixed_count()
+            .and_then(|count| usize::try_from(count).ok())
+            .filter(|&count| count > 0 && count <= candidates.len())
+            .into_iter()
+            .collect(),
+        _ => Vec::new(),
+    };
+    for count in sacrifice_counts {
+        let chosen = &candidates[..count];
+        let capacity =
+            any_number_this_way_cost_reduction_capacity(state, spell_id, movement, chosen);
+        let mut reduced = total.reduced_by_generic(capacity);
+        if !cost_has_x(&reduced) {
+            super::casting::apply_cost_floor(state, player, spell_id, &mut reduced);
+        }
+        let mut scratch = state.clone();
+        let sacrificed: HashSet<_> = chosen.iter().copied().collect();
+        scratch.battlefield.retain(|id| !sacrificed.contains(id));
+        for id in chosen {
+            if let Some(object) = scratch.objects.get_mut(id) {
+                object.zone = Zone::Graveyard;
+            }
+        }
+        if can_pay(&scratch, &reduced) {
+            return true;
+        }
+    }
+    false
+}
+
+pub(super) fn optional_any_number_this_way_cost_makes_payable(
+    state: &GameState,
+    player: PlayerId,
+    spell_id: ObjectId,
+    total: &ManaCost,
+    can_pay: impl FnMut(&GameState, &ManaCost) -> bool,
+) -> bool {
+    let Some(AdditionalCost::Optional { cost, .. }) = state
+        .objects
+        .get(&spell_id)
+        .and_then(|spell| spell.additional_cost.as_ref())
+    else {
+        return false;
+    };
+    any_number_this_way_cost_makes_payable(state, player, spell_id, cost, total, can_pay)
+}
