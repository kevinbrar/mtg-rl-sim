+            .with_mana_cost(ManaCost::Cost {
+                shards: vec![ManaCostShard::Black],
+                generic: if requirement.starts_with("two") { 2 } else { 1 },
+            })
+            .id();
+        for _ in 0..candidate_count {
+            scenario.add_creature(P0, "Memnite", 1, 1);
+        }
+        let runner = scenario.build();
+        let object = &runner.state().objects[&spell];
+        assert!(
+            matches!(
+                &object.additional_cost,
+                Some(AdditionalCost::Optional {
+                    cost: AbilityCost::Sacrifice(cost),
+                    ..
+                }) if cost.requirement.fixed_count() == Some(if requirement.starts_with("two") { 2 } else { 1 })
+            ),
+            "parser must preserve the fixed sacrifice count: {:?}",
+            object.additional_cost
+        );
+        assert!(
+            object.static_definitions.iter_all().any(|definition| {
+                definition.condition == Some(StaticCondition::AdditionalCostPaid)
+                    && matches!(
+                        definition.mode,
+                        StaticMode::ModifyCost {
+                            mode: CostModifyMode::Reduce,
+                            ..
+                        }
+                    )
+                    && format!("{:?}", definition.mode).contains("Sacrificed")
+            }),
+            "parser must produce an additional-cost-conditioned ModifyCost reduction"
+        );
+        assert_eq!(
+            engine::ai_support::legal_actions(runner.state())
+                .iter()
+                .any(|action| matches!(action, GameAction::CastSpell { object_id, .. } if *object_id == spell)),
+            expected
+        );
+    }
+
+    castable("a nonland permanent", 0, 1, false);
+    castable("a nonland permanent", 1, 1, true);
