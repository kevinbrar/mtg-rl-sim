-    ) && !(matches!(chain.effect, Effect::TargetOnly { .. })
-        && chain.target_choice_timing == TargetChoiceTiming::Resolution)
+    ) && !moved_object_followup
+        && !(matches!(chain.effect, Effect::TargetOnly { .. })
+            && chain.target_choice_timing == TargetChoiceTiming::Resolution)
 }
 
