+#[test]
+fn anzrags_rampage_selects_one_of_two_exiled_creatures_and_returns_it() {
+    let db = shared_card_db().expect("integration card fixture must load");
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    scenario.add_artifact_from_oracle(P1, "Enemy Relic A", "");
+    scenario.add_artifact_from_oracle(P1, "Enemy Relic B", "");
+    let bears = scenario.add_real_card(P0, "Grizzly Bears", Zone::Library, db);
+    let elves = scenario.add_real_card(P0, "Llanowar Elves", Zone::Library, db);
+    scenario.add_real_card(P0, "Forest", Zone::Library, db);
+    scenario.with_mana_pool(
+        P0,
+        [
+            ManaType::Red,
+            ManaType::Red,
+            ManaType::Colorless,
+            ManaType::Colorless,
+            ManaType::Colorless,
+        ]
+        .into_iter()
+        .map(|mana_type| ManaUnit::new(mana_type, ObjectId(0), false, vec![]))
+        .collect(),
+    );
+    let spell = scenario
+        .add_spell_to_hand_from_oracle(P0, "Anzrag's Rampage", false, ORACLE)
+        .with_mana_cost(ManaCost::Cost {
+            shards: vec![ManaCostShard::Red, ManaCostShard::Red],
+            generic: 3,
+        })
+        .id();
+    let mut runner = scenario.build();
+
+    resolve_card_choice(&mut runner, spell, &[bears], &[bears, elves]);
+    assert_eq!(runner.state().objects[&bears].zone, Zone::Battlefield);
+    assert_eq!(runner.state().objects[&elves].zone, Zone::Exile);
+    assert!(
+        runner.state().objects[&bears].has_keyword(&Keyword::Haste),
+        "the selected creature gains haste: {:?}",
+        runner.state().objects[&bears]
+    );
+    assert!(
+        !runner.state().objects[&elves].has_keyword(&Keyword::Haste),
+        "the unselected creature does not gain haste"
+    );
+
+    runner.advance_to_combat();
+    runner
+        .declare_attackers(&[])
+        .expect("declaring no attackers should succeed");
+    runner.advance_to_end_step();
+    runner.advance_until_stack_empty();
+
+    assert_eq!(runner.state().objects[&bears].zone, Zone::Hand);
+    assert_eq!(runner.state().objects[&elves].zone, Zone::Exile);
