+fn target_filter_contains_exiled_by_source(filter: &TargetFilter) -> bool {
+    match filter {
+        TargetFilter::ExiledBySource => true,
+        TargetFilter::And { filters } => {
+            filters.iter().any(target_filter_contains_exiled_by_source)
+        }
+        TargetFilter::Or { filters } => {
+            !filters.is_empty() && filters.iter().all(target_filter_contains_exiled_by_source)
+        }
+        TargetFilter::TrackedSetFiltered { filter, .. } => {
+            target_filter_contains_exiled_by_source(filter)
+        }
+        _ => false,
+    }
+}
+
+fn is_singular_exiled_card_placement(text: &str) -> bool {
+    let lower = text.to_lowercase();
+    let parsed = nom::combinator::all_consuming((
+        tag::<_, _, OracleError<'_>>("put "),
+        alt((tag("a "), tag("an "))),
+        nom::bytes::complete::take_until(" card exiled this way onto "),
+        tag(" card exiled this way onto "),
+        nom::bytes::complete::take_while1(|character| character != '.'),
+        opt(tag(".")),
+    ))
+    .parse(lower.as_str());
+    parsed.is_ok()
+}
+
+/// CR 608.2c-d: A singular "you may put a card exiled this way" is a
+/// resolution-time choice from the preceding exile result, not a mass move.
+/// Reuse the parent-target zone choice and keep its existing follow-up chain
+/// beneath the selected card's single-object zone change.
+fn lower_singular_exiled_card_placement(text: &str, clause: &mut ParsedEffectClause) {
+    if !is_singular_exiled_card_placement(text) {
+        return;
+    }
+
+    let (destination, filter) = match &clause.effect {
+        Effect::ChangeZoneAll {
+            origin: Some(Zone::Exile),
+            destination,
+            target: TargetFilter::TrackedSetFiltered { filter, .. },
+            ..
+        } if target_filter_contains_exiled_by_source(filter) => {
+            (*destination, filter.as_ref().clone())
+        }
+        _ => return,
+    };
+
+    clause.effect = Effect::ChooseFromZone {
+        count: 1,
+        zone: Zone::Exile,
+        additional_zones: Vec::new(),
+        zone_owner: ZoneOwner::Controller,
+        filter: Some(filter),
+        chooser: crate::types::ability::Chooser::Controller.into(),
+        candidate_source: ZoneChoiceCandidateSource::ParentTargets,
+        reciprocal_role: None,
+        gather_role: None,
+        up_to: true,
+        selection: crate::types::ability::CardSelectionMode::Chosen,
+        constraint: None,
+    };
+
+    let continuation = clause.sub_ability.take();
+    let mut change_zone = AbilityDefinition::new(
+        AbilityKind::Spell,
+        Effect::ChangeZone {
+            origin: Some(Zone::Exile),
+            destination,
+            target: TargetFilter::ParentTarget,
+            owner_library: false,
+            enter_transformed: false,
+            enters_under: None,
+            enter_tapped: crate::types::zones::EtbTapState::Unspecified,
+            enters_attacking: false,
+            up_to: false,
+            enter_with_counters: vec![],
+            conditional_enter_with_counters: vec![],
+            face_down_profile: None,
+            enters_modified_if: None,
+        },
+    );
+    change_zone.sub_ability = continuation;
+    clause.sub_ability = Some(Box::new(change_zone));
+}
