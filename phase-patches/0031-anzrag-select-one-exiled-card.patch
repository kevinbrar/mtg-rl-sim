+#[test]
+fn singular_exiled_card_placement_uses_an_up_to_one_zone_choice() {
+    let oracle = "Destroy all artifacts you don't control, then exile the top X cards of your library, where X is the number of artifacts that were put into graveyards from the battlefield this turn. You may put a creature card exiled this way onto the battlefield. It gains haste. Return it to your hand at the beginning of the next end step.";
+    let def = parse_effect_chain(oracle, AbilityKind::Spell);
+    let exile = def
+        .sub_ability
+        .as_deref()
+        .expect("the exile instruction follows the artifact destruction");
+    let choice = exile
+        .sub_ability
+        .as_deref()
+        .expect("the singular placement follows the exile instruction");
+
+    let Effect::ChooseFromZone {
+        count,
+        zone,
+        filter,
+        candidate_source,
+        up_to,
+        ..
+    } = &*choice.effect
+    else {
+        panic!("expected a tracked exile choice, got {:?}", choice.effect);
+    };
+    assert_eq!(*count, 1);
+    assert_eq!(*zone, Zone::Exile);
+    assert!(*up_to);
+    assert_eq!(
+        *candidate_source,
+        crate::types::ability::ZoneChoiceCandidateSource::ParentTargets
+    );
+    let filter = filter.as_ref().expect("the creature filter is preserved");
+    let TargetFilter::And { filters } = filter else {
+        panic!("expected the type and source-exile filters, got {filter:?}");
+    };
+    assert!(filters
+        .iter()
+        .any(|filter| matches!(filter, TargetFilter::ExiledBySource)));
+    assert!(filters.iter().any(|filter| matches!(
+        filter,
+        TargetFilter::Typed(typed)
+            if typed.type_filters.contains(&TypeFilter::Creature)
+    )));
+
+    let change_zone = choice
+        .sub_ability
+        .as_deref()
+        .expect("the selected card is moved by a single-object effect");
+    assert!(matches!(
+        &*change_zone.effect,
+        Effect::ChangeZone {
+            origin: Some(Zone::Exile),
+            destination: Zone::Battlefield,
+            target: TargetFilter::ParentTarget,
+            ..
+        }
+    ));
+
+    let haste = change_zone
+        .sub_ability
+        .as_deref()
+        .expect("the haste grant follows the selected card's zone change");
+    let Effect::GenericEffect {
+        target,
+        static_abilities,
+        ..
+    } = &*haste.effect
+    else {
+        panic!("expected the haste grant, got {:?}", haste.effect);
+    };
+    assert_eq!(target, &Some(TargetFilter::ParentTarget));
+    assert!(static_abilities.iter().any(|static_ability| {
+        static_ability.affected == Some(TargetFilter::ParentTarget)
+            && static_ability.modifications.iter().any(|modification| {
+                matches!(
+                    modification,
+                    ContinuousModification::AddKeyword {
+                        keyword: Keyword::Haste
+                    }
+                )
+            })
+    }));
+
+    let delayed = haste
+        .sub_ability
+        .as_deref()
+        .expect("the delayed return follows the haste grant");
+    let Effect::CreateDelayedTrigger {
+        effect: delayed_effect,
+        ..
+    } = &*delayed.effect
+    else {
+        panic!("expected a delayed trigger, got {:?}", delayed.effect);
+    };
+    assert!(matches!(
+        &*delayed_effect.effect,
+        Effect::Bounce {
+            target: TargetFilter::ParentTarget,
+            ..
+        }
+    ));
+
+    let an = parse_effect_chain(
+        "You may put an artifact card exiled this way onto the battlefield.",
+        AbilityKind::Spell,
+    );
+    assert!(matches!(
+        an.effect.as_ref(),
+        Effect::ChooseFromZone {
+            count: 1,
+            filter: Some(filter),
+            candidate_source:
+                crate::types::ability::ZoneChoiceCandidateSource::ParentTargets,
+            up_to: true,
+            ..
+        } if target_filter_contains_exiled_by_source(filter)
+    ));
+
+    assert!(!is_singular_exiled_card_placement(
+        "put any number of artifact cards exiled this way onto the battlefield."
+    ));
+}
