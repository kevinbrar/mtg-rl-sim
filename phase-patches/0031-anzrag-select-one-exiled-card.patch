+fn resolve_card_choice(
+    runner: &mut GameRunner,
+    spell: ObjectId,
+    selected: &[ObjectId],
+    offered: &[ObjectId],
+) {
+    let outcome = runner.cast(spell).resolve();
+    let WaitingFor::ChooseFromZoneChoice {
+        cards,
+        count,
+        up_to,
+        ..
+    } = outcome.final_waiting_for()
+    else {
+        panic!(
+            "expected the real tracked-exile selection prompt, got {:?}",
+            outcome.final_waiting_for()
+        );
+    };
+    assert_eq!(*count, 1);
+    assert!(*up_to, "the selection may be declined");
+    assert_eq!(cards.len(), offered.len());
+    assert!(
+        offered
+            .iter()
+            .all(|offered_card| cards.contains(offered_card)),
+        "the prompt should offer exactly the expected creatures"
+    );
+    runner
+        .act(GameAction::SelectCards {
+            cards: selected.to_vec(),
+        })
+        .expect("submit the selected exiled card");
+    runner.advance_until_stack_empty();
+    assert!(runner.state().stack.is_empty());
+    assert!(
+        matches!(
+            runner.state().waiting_for,
+            WaitingFor::Priority { player: P0 }
+        ),
+        "resolution should finish at P0 priority, got {:?}",
+        runner.state().waiting_for
+    );
+}
