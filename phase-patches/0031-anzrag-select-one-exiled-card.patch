 fn continuation_forwards_unchosen_complement(chain: &ResolvedAbility) -> bool {
-    use crate::types::ability::{Effect, TargetChoiceTiming};
+    use crate::types::ability::{Effect, TargetChoiceTiming, TargetFilter};
