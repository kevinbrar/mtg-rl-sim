+fn is_singular_exiled_choice(effect: &Effect) -> bool {
+    matches!(
+        effect,
+        Effect::ChooseFromZone {
+            count: 1,
+            zone: Zone::Exile,
+            filter: Some(filter),
+            candidate_source: ZoneChoiceCandidateSource::ParentTargets,
+            selection: CardSelectionMode::Chosen,
+            up_to: true,
+            ..
+        } if super::target_filter_contains_exiled_by_source(filter)
+    )
+}
+
+fn bind_singular_exiled_choice_anaphora(def: &mut AbilityDefinition, ir: &EffectChainIr) {
+    let mut clauses = ir
+        .clauses
+        .iter()
+        .enumerate()
+        .filter(|(_, clause)| is_singular_exiled_choice(&clause.parsed.effect));
+    let mut node = Some(def);
+    while let Some(ability) = node {
+        if is_singular_exiled_choice(ability.effect.as_ref()) {
+            let followup_text = clauses
+                .next()
+                .and_then(|(index, _)| ir.clauses.get(index + 1))
+                .and_then(|clause| clause.source.fragment())
+                .unwrap_or_default()
+                .to_lowercase();
+            if let Some(change_zone) = ability.sub_ability.as_deref_mut() {
+                if matches!(
+                    change_zone.effect.as_ref(),
+                    Effect::ChangeZone {
+                        target: TargetFilter::ParentTarget,
+                        ..
+                    }
+                ) {
+                    if let Some(continuation) = change_zone.sub_ability.as_deref_mut() {
+                        super::rebind_anaphoric_generic_effect_subject_to_parent(
+                            &followup_text,
+                            continuation,
+                        );
+                    }
+                }
+            }
+        }
+        node = ability.sub_ability.as_deref_mut();
     }
 }
 
