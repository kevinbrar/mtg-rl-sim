 /// *and* draws for the same target player).
 /// Falls back to `None` for optional slots; panics for an unsatisfiable
 /// required slot.
+fn validate_explicit_target_slot_count(
+    provided: usize,
+    expected: usize,
+) -> Result<(), EngineError> {
+    if provided == expected {
+        Ok(())
+    } else {
+        Err(EngineError::ActionNotAllowed(format!(
+            "cast.targets has {provided} entries for {expected} target slots"
+        )))
+    }
+}
+
+fn explicit_target_slot_choice(
+    declared: Option<Option<TargetRef>>,
+    legal_targets: &[TargetRef],
+    optional: bool,
+    slot_index: usize,
+) -> Result<Option<TargetRef>, EngineError> {
+    let declared = declared.ok_or_else(|| {
+        EngineError::ActionNotAllowed(format!(
+            "cast.targets is missing entry for target slot {}",
+            slot_index + 1
+        ))
+    })?;
+    match declared {
+        Some(target) if legal_targets.contains(&target) => Ok(Some(target)),
+        Some(target) => Err(EngineError::ActionNotAllowed(format!(
+            "cast.targets entry {target:?} is not legal for target slot {}",
+            slot_index + 1
+        ))),
+        None if optional => Ok(None),
+        None => Err(EngineError::ActionNotAllowed(format!(
+            "cast.targets skips non-optional target slot {}",
+            slot_index + 1
+        ))),
+    }
+}
+
 fn pick_slot_target(
     slot: &crate::types::game_state::TargetSelectionSlot,
     remaining_objects: &mut Vec<ObjectId>,
@@ -4623,6 +4717,94 @@ mod tests {
         assert_eq!(state.players[1].life, 20);
     }
 
+    #[test]
+    fn explicit_target_slots_require_one_legal_target_or_optional_skip_per_slot() {
+        let target = TargetRef::Object(ObjectId(17));
+        assert!(validate_explicit_target_slot_count(2, 2).is_ok());
+        assert!(validate_explicit_target_slot_count(1, 2).is_err());
+        assert!(validate_explicit_target_slot_count(3, 2).is_err());
+        assert!(matches!(
+            explicit_target_slot_choice(
+                Some(Some(target.clone())),
+                std::slice::from_ref(&target),
+                true,
+                0,
+            ),
+            Ok(Some(selected)) if selected == target
+        ));
+        assert!(matches!(
+            explicit_target_slot_choice(Some(None), &[], true, 1),
+            Ok(None)
+        ));
+        assert!(explicit_target_slot_choice(Some(None), &[], false, 1).is_err());
+        assert!(explicit_target_slot_choice(Some(Some(target.clone())), &[], true, 1).is_err());
+    }
+
+    #[test]
+    fn spell_cast_drives_explicit_target_slots_and_collect_evidence_queue() {
+        const ORACLE: &str = "As an additional cost to cast this spell, collect evidence X, where X is the total mana value of the permanents this spell targets.\nDestroy up to one target artifact, up to one target creature, up to one target enchantment, and up to one target planeswalker.";
+
+        let mut scenario = GameScenario::new();
+        scenario.at_phase(Phase::PreCombatMain);
+        let artifact = scenario
+            .add_artifact_from_oracle(P1, "Target Artifact", "")
+            .with_mana_cost(crate::types::mana::ManaCost::generic(1))
+            .id();
+        let creature = scenario
+            .add_creature(P1, "Target Creature", 2, 2)
+            .with_mana_cost(crate::types::mana::ManaCost::generic(2))
+            .id();
+        let enchantment = scenario
+            .add_enchantment_from_oracle(P1, "Target Enchantment", "")
+            .with_mana_cost(crate::types::mana::ManaCost::generic(3))
+            .id();
+        let planeswalker = scenario
+            .add_planeswalker_from_oracle(P1, "Target Planeswalker", "Test", 4, "")
+            .with_mana_cost(crate::types::mana::ManaCost::generic(3))
+            .id();
+        let evidence_one = scenario
+            .add_creature_to_graveyard(P0, "Evidence One", 1, 1)
+            .with_mana_cost(crate::types::mana::ManaCost::generic(1))
+            .id();
+        let evidence_two = scenario
+            .add_creature_to_graveyard(P0, "Evidence Two", 1, 1)
+            .with_mana_cost(crate::types::mana::ManaCost::generic(2))
+            .id();
+        let evidence_four = scenario
+            .add_creature_to_graveyard(P0, "Evidence Four", 1, 1)
+            .with_mana_cost(crate::types::mana::ManaCost::generic(4))
+            .id();
+        let spell = scenario
+            .add_spell_to_hand_from_oracle(P0, "Urgent Necropsy", true, ORACLE)
+            .with_mana_cost(crate::types::mana::ManaCost::generic(0))
+            .id();
+        let mut runner = scenario.build();
+        let mut card_choice_groups =
+            std::collections::VecDeque::from([vec![evidence_one, evidence_two]]);
+
+        let outcome = runner
+            .cast(spell)
+            .target_slot_selections(&[
+                Some(TargetRef::Object(artifact)),
+                Some(TargetRef::Object(creature)),
+                None,
+                None,
+            ])
+            .commit_with_card_choices(&mut card_choice_groups)
+            .expect("valid target slots and evidence should commit")
+            .resolve();
+
+        outcome.assert_zone(&[artifact, creature], Zone::Graveyard);
+        outcome.assert_zone(&[enchantment, planeswalker], Zone::Battlefield);
+        outcome.assert_zone(&[evidence_one, evidence_two], Zone::Exile);
+        outcome.assert_zone(&[evidence_four], Zone::Graveyard);
+        assert!(card_choice_groups.is_empty());
+        assert!(matches!(
+            outcome.final_waiting_for(),
+            WaitingFor::Priority { .. }
+        ));
+    }
+
