-                costs: vec![AbilityCost::Tap, AbilityCost::CollectEvidence { amount: 3 },],
+                costs: vec![
+                    AbilityCost::Tap,
+                    AbilityCost::CollectEvidence {
+                        amount: CollectEvidenceAmount::Fixed(3),
+                    },
+                ],
