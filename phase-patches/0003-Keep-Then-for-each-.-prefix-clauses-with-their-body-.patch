+        tag("then for each "),
         tag("otherwise"),
         tag("if not"),
         tag("the next time "),
@@ -11379,6 +11382,17 @@ mod tests {
         assert_eq!(split_clause_sequence(plain).len(), 2, "{plain}");
     }
 
