diff --git a/crates/engine/tests/integration/explore_rest_pile_stays_in_library_during_choice.rs b/crates/engine/tests/integration/explore_rest_pile_stays_in_library_during_choice.rs
new file mode 100644
index 000000000..9b3ed56cd
--- /dev/null
+++ b/crates/engine/tests/integration/explore_rest_pile_stays_in_library_during_choice.rs
@@ -0,0 +1,190 @@
+//! CR 701.44a + CR 616.1: a card an explore puts into the graveyard stays in
+//! its owner's library until the move happens. While its controller chooses
+//! between two replacement effects for that move, the card is still a library
+//! card and is in the library's list.
+
+use engine::game::scenario::{GameScenario, P0, P1};
+use engine::types::ability::{DigRestOrder, DigRestRemainder};
+use engine::types::actions::GameAction;
+use engine::types::game_state::WaitingFor;
+use engine::types::phase::Phase;
+use engine::types::zones::Zone;
+
+const REST_IN_PEACE: &str = "When this enchantment enters, exile all graveyards.\nIf a card or token would be put into a graveyard from anywhere, exile it instead.";
+
+#[test]
+fn explored_card_is_in_the_library_while_its_graveyard_move_awaits_a_choice() {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    for player in [P0, P1] {
+        scenario
+            .add_creature(player, "Rest in Peace", 0, 0)
+            .as_enchantment()
+            .from_oracle_text(REST_IN_PEACE);
+    }
+    let explorer = scenario.add_creature(P0, "Explorer", 2, 2).id();
+    scenario.add_card_to_library_top(P0, "Below");
+    let top = scenario.add_card_to_library_top(P0, "Top");
+    let spell = scenario
+        .add_spell_to_hand_from_oracle(
+            P0,
+            "Scouting",
+            false,
+            "Target creature you control explores.",
+        )
+        .id();
+    let mut runner = scenario.build();
+    runner.cast(spell).target_object(explorer).resolve();
+
+    let mut seen_choice = false;
+    for _ in 0..20 {
+        match runner.state().waiting_for.clone() {
+            WaitingFor::DigChoice { .. } => {
+                runner
+                    .act(GameAction::SelectCards { cards: vec![] })
+                    .expect("putting the card into the graveyard is legal");
+            }
+            WaitingFor::ReplacementChoice { .. } => {
+                // The spell itself asks the same question later, on its way
+                // to the graveyard; only the first choice is the explored card's.
+                if !seen_choice {
+                    let state = runner.state();
+                    assert_eq!(state.objects[&top].zone, Zone::Library);
+                    assert_eq!(
+                        state.players[0].library.front(),
+                        Some(&top),
+                        "the explored card is still the top card of the library"
+                    );
+                }
+                seen_choice = true;
+                runner
+                    .act(GameAction::ChooseReplacement { index: 0 })
+                    .expect("choosing a replacement is legal");
+            }
+            _ => break,
+        }
+    }
+    assert!(seen_choice, "two replacement effects apply to the move");
+    let state = runner.state();
+    assert_eq!(state.objects[&top].zone, Zone::Exile);
+    assert!(!state.players[0].library.contains(&top));
+    assert_eq!(state.players[0].library.len(), 1);
+    assert_eq!(state.objects[&explorer].power, Some(3));
+}
+
+/// Every object outside the stack and command zone is in exactly one zone
+/// list, and that list agrees with the object's own zone.
+fn zone_faults(state: &engine::types::game_state::GameState) -> Vec<String> {
+    use std::collections::HashSet;
+    let mut lists = vec![
+        (
+            Zone::Battlefield,
+            state.battlefield.iter().copied().collect::<Vec<_>>(),
+        ),
+        (Zone::Exile, state.exile.iter().copied().collect()),
+    ];
+    for player in &state.players {
+        lists.push((Zone::Hand, player.hand.iter().copied().collect()));
+        lists.push((Zone::Library, player.library.iter().copied().collect()));
+        lists.push((Zone::Graveyard, player.graveyard.iter().copied().collect()));
+    }
+    let mut faults = Vec::new();
+    let mut seen = HashSet::new();
+    for (zone, ids) in lists {
+        for id in ids {
+            if !seen.insert(id) {
+                faults.push(format!("{id:?} is in two zone lists"));
+            }
+            if state.objects[&id].zone != zone {
+                faults.push(format!("{id:?} is listed in {zone:?}"));
+            }
+        }
+    }
+    for (id, object) in state.objects.iter() {
+        if !matches!(object.zone, Zone::Stack | Zone::Command) && !seen.contains(id) {
+            faults.push(format!(
+                "{id:?} has zone {:?} but is in no list",
+                object.zone
+            ));
+        }
+    }
+    faults
+}
+
+/// CR 616.1: each card of a multi-card remainder can pause on its own
+/// replacement choice. The cards not yet moved stay in the library, below the
+/// kept cards and in their original order.
+#[test]
+fn multi_card_remainder_stays_in_the_library_while_each_move_awaits_a_choice() {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    for player in [P0, P1] {
+        scenario
+            .add_creature(player, "Rest in Peace", 0, 0)
+            .as_enchantment()
+            .from_oracle_text(REST_IN_PEACE);
+    }
+    let bottom = scenario.add_card_to_library_top(P0, "Bottom");
+    let d = scenario.add_card_to_library_top(P0, "D");
+    let c = scenario.add_card_to_library_top(P0, "C");
+    let b = scenario.add_card_to_library_top(P0, "B");
+    let a = scenario.add_card_to_library_top(P0, "A");
+    let mut runner = scenario.build();
+    // No card text was found that the parser turns into a keep-on-top dig with
+    // a multi-card remainder, so the prompt is set up directly.
+    runner.state_mut().waiting_for = WaitingFor::DigChoice {
+        player: P0,
+        library_owner: P0,
+        cards: vec![a, b, c, d],
+        selectable_cards: vec![a, b, c, d],
+        keep_count: 4,
+        up_to: true,
+        kept_destination: Some(Zone::Library),
+        rest_destination: Some(Zone::Graveyard),
+        rest_remainder: DigRestRemainder::Route,
+        rest_split_top_count: None,
+        rest_order: DigRestOrder::Preserve,
+        source_id: None,
+        enter_tapped: false,
+        enters_attacking: false,
+    };
+
+    let mut choices = 0;
+    for _ in 0..20 {
+        assert_eq!(zone_faults(runner.state()), Vec::<String>::new());
+        match runner.state().waiting_for.clone() {
+            WaitingFor::DigChoice { .. } => {
+                runner
+                    .act(GameAction::SelectCards { cards: vec![c] })
+                    .expect("keeping one card on top is legal");
+            }
+            WaitingFor::ReplacementChoice { .. } => {
+                let library: Vec<_> = runner.state().players[0].library.iter().copied().collect();
+                assert_eq!(library[0], c, "the kept card is on top");
+                let waiting: Vec<_> = [a, b, d]
+                    .into_iter()
+                    .filter(|id| library.contains(id))
+                    .collect();
+                assert_eq!(library[1..], [waiting.as_slice(), &[bottom]].concat());
+                choices += 1;
+                runner
+                    .act(GameAction::ChooseReplacement { index: choices % 2 })
+                    .expect("choosing a replacement is legal");
+            }
+            _ => break,
+        }
+    }
+    assert_eq!(
+        choices, 3,
+        "each of the three cards asks for its replacement"
+    );
+    let state = runner.state();
+    assert_eq!(zone_faults(state), Vec::<String>::new());
+    assert_eq!(
+        state.players[0].library.iter().copied().collect::<Vec<_>>(),
+        vec![c, bottom]
+    );
+    for id in [a, b, d] {
+        assert_eq!(state.objects[&id].zone, Zone::Exile);
+    }
+}
