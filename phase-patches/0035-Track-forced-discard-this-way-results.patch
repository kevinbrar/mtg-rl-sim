--- a/crates/engine/src/types/game_state.rs
+++ b/crates/engine/src/types/game_state.rs
@@ -5909,10 +5909,11 @@ pub enum DiscardBatchCursor {
 pub enum PendingDiscardBatchCompletion {
     #[default]
     Standard,
-    /// A player already selected these cards through `WaitingFor::DiscardChoice`.
-    /// Keep their incarnation references so neither an id-reused object nor a
-    /// later hand card can satisfy the original selection after a pause.
-    DiscardChoice { chosen: Vec<ObjectIncarnationRef> },
+    /// These are the cards completed by the discard instruction, whether
+    /// selected through `WaitingFor::DiscardChoice` or forced by the required
+    /// count. Keep their incarnation references across a replacement pause.
+    #[serde(rename = "DiscardChoice")]
+    DiscardedCards { chosen: Vec<ObjectIncarnationRef> },
 }
 
