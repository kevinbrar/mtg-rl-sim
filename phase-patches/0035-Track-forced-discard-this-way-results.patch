-/// Finish the choice-specific bookkeeping that must precede a discard effect's
-/// terminal marker, whether the selected cards settled synchronously or after
-/// one or more replacement choices.
-pub(crate) fn finalize_discard_choice_completion(
+/// Finish shared bookkeeping before a discard effect's terminal marker,
+/// whether cards were chosen interactively, forced, or settled after a
+/// replacement choice.
+pub(crate) fn finalize_discard_completion(
     state: &mut GameState,
     completion: &PendingDiscardBatchCompletion,
     discard_frame: Option<crate::types::identifiers::DiscardFrameId>,
     events: &[GameEvent],
 ) {
-    let PendingDiscardBatchCompletion::DiscardChoice { chosen } = completion else {
+    let PendingDiscardBatchCompletion::DiscardedCards { chosen } = completion else {
         return;
     };
+    // CR 701.9b + CR 603.12: discard results feed "this way" reflexive
+    // triggers whether a prompt was needed or the required cards were forced.
     // CR 701.9a + CR 702.35a: a chosen card a replacement redirects on its way
     // out of the hand (Rest in Peace, Leyline of the Void, madness → exile) is
     // still discarded, so this completion — the single authority for what the
