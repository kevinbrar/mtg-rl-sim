+use engine::game::engine::EngineError;
+use engine::game::scenario::{GameRunner, GameScenario, P0, P1};
+use engine::types::ability::TargetRef;
+use engine::types::game_state::WaitingFor;
+use engine::types::identifiers::ObjectId;
+use engine::types::mana::ManaCost;
+use engine::types::phase::Phase;
+use engine::types::zones::Zone;
+use std::collections::VecDeque;
+
+const URGENT_NECROPSY: &str = "As an additional cost to cast this spell, collect evidence X, where X is the total mana value of the permanents this spell targets.\nDestroy up to one target artifact, up to one target creature, up to one target enchantment, and up to one target planeswalker.";
+
+struct NecropsyFixture {
+    runner: GameRunner,
+    spell: ObjectId,
+    artifact: ObjectId,
+    creature: ObjectId,
+    enchantment: ObjectId,
+    planeswalker: ObjectId,
+    evidence_one: ObjectId,
+    evidence_two: ObjectId,
+    evidence_four: ObjectId,
+}
+
+fn necropsy_fixture() -> NecropsyFixture {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let artifact = scenario
+        .add_artifact_from_oracle(P1, "Target Artifact", "")
+        .with_mana_cost(ManaCost::generic(1))
+        .id();
+    let creature = scenario
+        .add_creature(P1, "Target Creature", 2, 2)
+        .with_mana_cost(ManaCost::generic(2))
+        .id();
+    let enchantment = scenario
+        .add_enchantment_from_oracle(P1, "Target Enchantment", "")
+        .with_mana_cost(ManaCost::generic(3))
+        .id();
+    let planeswalker = scenario
+        .add_planeswalker_from_oracle(P1, "Target Planeswalker", "Test", 4, "")
+        .with_mana_cost(ManaCost::generic(3))
+        .id();
+    let evidence_one = scenario
+        .add_creature_to_graveyard(P0, "Evidence One", 1, 1)
+        .with_mana_cost(ManaCost::generic(1))
+        .id();
+    let evidence_two = scenario
+        .add_creature_to_graveyard(P0, "Evidence Two", 1, 1)
+        .with_mana_cost(ManaCost::generic(2))
+        .id();
+    let evidence_four = scenario
+        .add_creature_to_graveyard(P0, "Evidence Four", 1, 1)
+        .with_mana_cost(ManaCost::generic(4))
+        .id();
+    let spell = scenario
+        .add_spell_to_hand_from_oracle(P0, "Urgent Necropsy", true, URGENT_NECROPSY)
+        .with_mana_cost(ManaCost::generic(0))
+        .id();
+    NecropsyFixture {
+        runner: scenario.build(),
+        spell,
+        artifact,
+        creature,
+        enchantment,
+        planeswalker,
+        evidence_one,
+        evidence_two,
+        evidence_four,
+    }
+}
+
+fn artifact_spell_fixture(
+    oracle_text: &str,
+) -> (GameRunner, ObjectId, ObjectId, ObjectId, ObjectId) {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let artifact_one = scenario
+        .add_artifact_from_oracle(P1, "Target Artifact One", "")
+        .id();
+    let artifact_two = scenario
+        .add_artifact_from_oracle(P1, "Target Artifact Two", "")
+        .id();
+    let creature = scenario.add_creature(P1, "Not an Artifact", 2, 2).id();
+    let spell = scenario
+        .add_spell_to_hand_from_oracle(P0, "Target Test Spell", true, oracle_text)
+        .with_mana_cost(ManaCost::generic(0))
+        .id();
+    (
+        scenario.build(),
+        spell,
+        artifact_one,
+        artifact_two,
+        creature,
+    )
+}
+
+fn assert_action_not_allowed<T>(result: Result<T, EngineError>, expected: &str) {
+    match result {
+        Err(EngineError::ActionNotAllowed(message)) => assert_eq!(message, expected),
+        Err(error) => panic!("expected ActionNotAllowed, got {error:?}"),
+        Ok(_) => panic!("expected ActionNotAllowed: {expected}"),
+    }
+}
+
+#[test]
+fn spell_cast_rejects_extra_target_slot_entry() {
+    let (mut runner, spell, artifact_one, artifact_two, _) =
+        artifact_spell_fixture("Destroy target artifact.");
+    let selections = [
+        Some(TargetRef::Object(artifact_one)),
+        Some(TargetRef::Object(artifact_two)),
+    ];
+
+    assert_action_not_allowed(
+        runner
+            .cast(spell)
+            .target_slot_selections(&selections)
+            .commit_with_card_choices(&mut VecDeque::new()),
+        "cast.targets has 2 entries for 1 target slots",
+    );
+}
+
+#[test]
+fn spell_cast_rejects_missing_target_slot_entry() {
+    let (mut runner, spell, _, _, _) = artifact_spell_fixture("Destroy target artifact.");
+
+    assert_action_not_allowed(
+        runner
+            .cast(spell)
+            .target_slot_selections(&[])
+            .commit_with_card_choices(&mut VecDeque::new()),
+        "cast.targets has 0 entries for 1 target slots",
+    );
+}
+
+#[test]
+fn spell_cast_rejects_target_objects_with_explicit_slots() {
+    let (mut runner, spell, artifact, _, _) = artifact_spell_fixture("Destroy target artifact.");
+
+    assert_action_not_allowed(
+        runner
+            .cast(spell)
+            .target_objects(&[artifact])
+            .target_slot_selections(&[Some(TargetRef::Object(artifact))])
+            .commit_with_card_choices(&mut VecDeque::new()),
+        "explicit target slot selections cannot be combined with target_objects or target_players",
+    );
+}
+
+#[test]
+fn spell_cast_rejects_target_players_with_explicit_slots() {
+    let (mut runner, spell, artifact, _, _) = artifact_spell_fixture("Destroy target artifact.");
+
+    assert_action_not_allowed(
+        runner
+            .cast(spell)
+            .target_players(&[P1])
+            .target_slot_selections(&[Some(TargetRef::Object(artifact))])
+            .commit_with_card_choices(&mut VecDeque::new()),
+        "explicit target slot selections cannot be combined with target_objects or target_players",
+    );
+}
+
+#[test]
+fn spell_cast_rejects_target_not_legal_for_slot() {
+    let (mut runner, spell, _, _, creature) = artifact_spell_fixture("Destroy target artifact.");
+    let illegal_target = TargetRef::Object(creature);
+
+    assert_action_not_allowed(
+        runner
+            .cast(spell)
+            .target_slot_selections(&[Some(illegal_target)])
+            .commit_with_card_choices(&mut VecDeque::new()),
+        &format!(
+            "cast.targets entry {:?} is not legal for target slot 1",
+            TargetRef::Object(creature)
+        ),
+    );
+}
+
+#[test]
+fn spell_cast_rejects_none_for_non_optional_target_slot() {
+    let (mut runner, spell, _, _, _) = artifact_spell_fixture("Destroy target artifact.");
+
+    assert_action_not_allowed(
+        runner
+            .cast(spell)
+            .target_slot_selections(&[None])
+            .commit_with_card_choices(&mut VecDeque::new()),
+        "cast.targets skips non-optional target slot 1",
+    );
+}
+
+#[test]
+fn spell_cast_accepts_none_for_optional_target_slot() {
+    let (mut runner, spell, artifact_one, artifact_two, _) =
+        artifact_spell_fixture("Destroy up to one target artifact.");
+    let mut card_choice_groups = VecDeque::new();
+
+    let outcome = runner
+        .cast(spell)
+        .target_slot_selections(&[None])
+        .commit_with_card_choices(&mut card_choice_groups)
+        .expect("an optional target slot accepts an explicit None")
+        .resolve();
+
+    outcome.assert_zone(&[artifact_one, artifact_two], Zone::Battlefield);
+    assert!(card_choice_groups.is_empty());
+    assert!(matches!(
+        outcome.final_waiting_for(),
+        WaitingFor::Priority { .. }
+    ));
+}
+
+#[test]
+fn spell_cast_drives_explicit_target_slots_and_collect_evidence_queue() {
+    let mut fixture = necropsy_fixture();
+    let mut card_choice_groups = VecDeque::from([vec![fixture.evidence_one, fixture.evidence_two]]);
+
+    let outcome = fixture
+        .runner
+        .cast(fixture.spell)
+        .target_slot_selections(&[
+            Some(TargetRef::Object(fixture.artifact)),
+            Some(TargetRef::Object(fixture.creature)),
+            None,
+            None,
+        ])
+        .commit_with_card_choices(&mut card_choice_groups)
+        .expect("valid target slots and evidence should commit")
+        .resolve();
+
+    outcome.assert_zone(&[fixture.artifact, fixture.creature], Zone::Graveyard);
+    outcome.assert_zone(
+        &[fixture.enchantment, fixture.planeswalker],
+        Zone::Battlefield,
+    );
+    outcome.assert_zone(&[fixture.evidence_one, fixture.evidence_two], Zone::Exile);
+    outcome.assert_zone(&[fixture.evidence_four], Zone::Graveyard);
+    assert!(card_choice_groups.is_empty());
+    assert!(matches!(
+        outcome.final_waiting_for(),
+        WaitingFor::Priority { .. }
+    ));
+}
+
+#[test]
+fn spell_cast_rejects_empty_collect_evidence_queue() {
+    let mut fixture = necropsy_fixture();
+
+    assert_action_not_allowed(
+        fixture
+            .runner
+            .cast(fixture.spell)
+            .target_slot_selections(&[Some(TargetRef::Object(fixture.artifact)), None, None, None])
+            .commit_with_card_choices(&mut VecDeque::new()),
+        "CollectEvidenceChoice arrived with an empty choose_cards queue",
+    );
+}
+
+#[test]
+fn spell_cast_accepts_empty_collect_evidence_group_at_zero() {
+    let mut fixture = necropsy_fixture();
+    let mut card_choice_groups = VecDeque::from([Vec::new()]);
+
+    let outcome = fixture
+        .runner
+        .cast(fixture.spell)
+        .target_slot_selections(&[None, None, None, None])
+        .commit_with_card_choices(&mut card_choice_groups)
+        .expect("an empty group pays the zero-mana-value evidence choice")
+        .resolve();
+
+    outcome.assert_zone(
+        &[
+            fixture.artifact,
+            fixture.creature,
+            fixture.enchantment,
+            fixture.planeswalker,
+        ],
+        Zone::Battlefield,
+    );
+    outcome.assert_zone(
+        &[
+            fixture.evidence_one,
+            fixture.evidence_two,
+            fixture.evidence_four,
+        ],
+        Zone::Graveyard,
+    );
+    assert!(card_choice_groups.is_empty());
+}
