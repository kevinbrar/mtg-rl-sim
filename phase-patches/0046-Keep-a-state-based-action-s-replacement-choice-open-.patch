--- /dev/null
+++ b/crates/engine/tests/integration/sba_death_replacement_choice_in_combat.rs
@@ -0,0 +1,176 @@
+//! CR 616.1 + CR 704.3: when two replacement effects apply to a creature that
+//! state-based actions destroy after combat damage, the choice between them is
+//! asked before any player receives priority.
+
+use engine::game::combat::AttackTarget;
+use engine::game::scenario::{GameScenario, P0, P1};
+use engine::types::actions::GameAction;
+use engine::types::game_state::WaitingFor;
+use engine::types::phase::Phase;
+use engine::types::zones::Zone;
+
+const REST_IN_PEACE: &str = "When this enchantment enters, exile all graveyards.\nIf a card or token would be put into a graveyard from anywhere, exile it instead.";
+
+#[test]
+fn two_rest_in_peace_ask_before_priority_when_combat_damage_kills_creatures() {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    for player in [P0, P1] {
+        scenario
+            .add_creature(player, "Rest in Peace", 0, 0)
+            .as_enchantment()
+            .from_oracle_text(REST_IN_PEACE);
+    }
+    let attacker = scenario
+        .add_creature(P0, "Attacker", 1, 1)
+        .from_oracle_text(
+            "Whenever this creature deals combat damage to a creature, you gain 1 life.",
+        )
+        .id();
+    let blocker = scenario
+        .add_creature(P1, "Blocker", 1, 1)
+        .from_oracle_text(
+            "Whenever this creature deals combat damage to a creature, you gain 1 life.",
+        )
+        .id();
+    let mut runner = scenario.build();
+
+    let mut seen_choices = 0;
+    for _ in 0..60 {
+        let state = runner.state();
+        if state.objects[&attacker].zone != Zone::Battlefield
+            && state.objects[&blocker].zone != Zone::Battlefield
+            && state.stack.is_empty()
+            && matches!(state.waiting_for, WaitingFor::Priority { .. })
+        {
+            break;
+        }
+        assert!(
+            state.turn_number <= 1 || state.phase != Phase::Cleanup,
+            "the game must not reach cleanup with the deaths undelivered"
+        );
+        match state.waiting_for.clone() {
+            WaitingFor::DeclareAttackers { .. } => {
+                runner
+                    .act(GameAction::DeclareAttackers {
+                        attacks: vec![(attacker, AttackTarget::Player(P1))],
+                        bands: vec![],
+                    })
+                    .expect("attack is legal");
+            }
+            WaitingFor::DeclareBlockers { .. } => {
+                runner
+                    .act(GameAction::DeclareBlockers {
+                        assignments: vec![(blocker, attacker)],
+                    })
+                    .expect("block is legal");
+            }
+            WaitingFor::ReplacementChoice { .. } => {
+                seen_choices += 1;
+                runner
+                    .act(GameAction::ChooseReplacement { index: 0 })
+                    .expect("choosing a replacement is legal");
+            }
+            WaitingFor::Priority { .. } => {
+                assert!(
+                    runner.state().pending_replacement.is_none(),
+                    "no player has priority while a replacement choice is unanswered"
+                );
+                runner.act(GameAction::PassPriority).expect("pass is legal");
+            }
+            other => panic!("unexpected prompt {other:?}"),
+        }
+    }
+
+    let state = runner.state();
+    assert!(seen_choices >= 1, "the replacement choice was asked");
+    assert_eq!(state.objects[&attacker].zone, Zone::Exile);
+    assert_eq!(state.objects[&blocker].zone, Zone::Exile);
+    assert!(state.pending_replacement.is_none());
+    // CR 603.3b: each creature's damage trigger, held while the choices were
+    // open, was put on the stack once and resolved.
+    assert_eq!(state.players[0].life, 21);
+    assert_eq!(state.players[1].life, 21);
+}
+
+/// CR 603.7 + CR 603.3b: a delayed ability that triggered on the combat damage
+/// is put on the stack once after the replacement choices, not lost.
+#[test]
+fn delayed_combat_damage_trigger_survives_the_replacement_choice() {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    for player in [P0, P1] {
+        scenario
+            .add_creature(player, "Rest in Peace", 0, 0)
+            .as_enchantment()
+            .from_oracle_text(REST_IN_PEACE);
+    }
+    let bear = scenario.add_creature(P0, "Insight Bear", 3, 3).id();
+    let attacker = scenario.add_creature(P0, "Attacker", 1, 1).id();
+    let blocker = scenario.add_creature(P1, "Blocker", 1, 1).id();
+    let insight = scenario
+        .add_spell_to_hand_from_oracle(
+            P0,
+            "Hunter's Insight",
+            true,
+            "Choose target creature you control. Whenever that creature deals combat damage to a player or planeswalker this turn, draw that many cards.",
+        )
+        .id();
+    for name in ["A", "B", "C", "D", "E", "F", "G", "H"] {
+        scenario.add_card_to_library_top(P0, name);
+    }
+    let mut runner = scenario.build();
+    runner.cast(insight).target_object(bear).resolve();
+    let hand_before = runner.state().players[0].hand.len();
+
+    let mut seen_choices = 0;
+    for _ in 0..60 {
+        let state = runner.state();
+        if state.phase == Phase::PostCombatMain {
+            break;
+        }
+        match state.waiting_for.clone() {
+            WaitingFor::DeclareAttackers { .. } => {
+                runner
+                    .act(GameAction::DeclareAttackers {
+                        attacks: vec![
+                            (bear, AttackTarget::Player(P1)),
+                            (attacker, AttackTarget::Player(P1)),
+                        ],
+                        bands: vec![],
+                    })
+                    .expect("attack is legal");
+            }
+            WaitingFor::DeclareBlockers { .. } => {
+                runner
+                    .act(GameAction::DeclareBlockers {
+                        assignments: vec![(blocker, attacker)],
+                    })
+                    .expect("block is legal");
+            }
+            WaitingFor::ReplacementChoice { .. } => {
+                seen_choices += 1;
+                assert_eq!(
+                    runner.state().players[0].hand.len(),
+                    hand_before,
+                    "the delayed trigger does not resolve before the choices are made"
+                );
+                runner
+                    .act(GameAction::ChooseReplacement { index: 0 })
+                    .expect("choosing a replacement is legal");
+            }
+            WaitingFor::Priority { .. } => {
+                runner.act(GameAction::PassPriority).expect("pass is legal");
+            }
+            other => panic!("unexpected prompt {other:?}"),
+        }
+    }
+
+    let state = runner.state();
+    // One choice for the resolved Hunter's Insight, one for each dying creature.
+    assert_eq!(seen_choices, 3);
+    assert_eq!(state.players[1].life, 17);
+    assert_eq!(state.objects[&attacker].zone, Zone::Exile);
+    assert_eq!(state.objects[&blocker].zone, Zone::Exile);
+    assert_eq!(state.players[0].hand.len(), hand_before + 3);
+}
