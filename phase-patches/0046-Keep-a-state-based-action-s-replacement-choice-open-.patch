diff --git a/crates/engine/src/game/combat_damage.rs b/crates/engine/src/game/combat_damage.rs
index 5050880ca..d2031f501 100644
--- a/crates/engine/src/game/combat_damage.rs
+++ b/crates/engine/src/game/combat_damage.rs
@@ -95,6 +95,28 @@ fn process_combat_damage_triggers(
     ) {
         return;
     }
+    // CR 616.1 + CR 704.3: a state-based action paused on a choice between
+    // replacement effects (two Rest in Peace on a dying creature). The check
+    // is not complete, so no ability goes on the stack and no player receives
+    // priority yet. CR 603.3b: the abilities that have triggered wait in the
+    // deferred queue and are put on the stack, with those of the remaining
+    // state-based actions, the next time a player would receive priority.
+    // CR 603.2c: this step and the steps before it in the same pass collected
+    // their own ordinary triggers, so the pass's events are claimed from the
+    // post-action collector.
+    if state.pending_replacement.is_some()
+        && matches!(
+            state.waiting_for,
+            crate::types::game_state::WaitingFor::ReplacementChoice { .. }
+        )
+    {
+        state.deferred_triggers.extend(pending);
+        // CR 603.7: delayed abilities that triggered on these events wait in
+        // the same queue; no later scan sees the damage events again.
+        triggers::collect_delayed_trigger_contexts_into_deferred(state, &before_priority_events);
+        triggers::claim_events_for_ordinary_collection(state, all_events, 0);
+        return;
+    }
     // CR 800.4a: If combat-damage SBAs eliminated a player before this
     // collect-only batch is put on the stack, drop triggers controlled by that
     // player before constructing the APNAP ordering pass.
@@ -441,9 +463,11 @@ fn claim_combat_lifelink_batch_events_for_ordinary_collection(
     triggers::claim_events_for_ordinary_collection(state, events, event_start);
 }
 
-/// Returns a terminal or trigger-ordering state produced while combat damage resolves.
+/// Returns a terminal, trigger-ordering or replacement-choice state produced
+/// while combat damage resolves.
 ///
-/// CR 603.3b / CR 704.3: trigger ordering and game-over results are completion
+/// CR 603.3b / CR 704.3 / CR 616.1: trigger ordering, game-over results and a
+/// state-based action's replacement choice are completion
 /// states of the combat-damage resolver, so callers must receive them rather than
 /// replacing them with a fresh priority window.
 fn pending_combat_damage_waiting(state: &GameState) -> Option<WaitingFor> {
@@ -451,6 +475,10 @@ fn pending_combat_damage_waiting(state: &GameState) -> Option<WaitingFor> {
         WaitingFor::OrderTriggers { .. } | WaitingFor::GameOver { .. } => {
             Some(state.waiting_for.clone())
         }
+        // CR 616.1 + CR 704.3: a state-based action's unanswered replacement choice.
+        WaitingFor::ReplacementChoice { .. } if state.pending_replacement.is_some() => {
+            Some(state.waiting_for.clone())
+        }
         _ => None,
     }
 }
@@ -6094,4 +6122,21 @@ mod tests {
         assert_eq!(runner.state().objects[&cadet_2].zone, Zone::Graveyard);
         assert_eq!(combat_damage_steps(&runner), 2);
     }
+
+    /// CR 616.1: only an unanswered replacement choice is a completion state;
+    /// a prompt whose replacement event is already settled is not returned.
+    #[test]
+    fn settled_replacement_choice_is_not_a_combat_damage_completion_state() {
+        let mut state = setup();
+        state.waiting_for = WaitingFor::ReplacementChoice {
+            player: PlayerId(0),
+            candidate_count: 2,
+            candidates: Vec::new(),
+            kind: Default::default(),
+            last_applied_decides: false,
+            remember_identity: None,
+        };
+        assert!(state.pending_replacement.is_none());
+        assert_eq!(pending_combat_damage_waiting(&state), None);
+    }
 }
