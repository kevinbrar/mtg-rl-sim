+++ b/crates/engine/tests/integration/choice_cost_offers_only_payable_branches.rs
@@ -0,0 +1,297 @@
+//! CR 601.2b + CR 601.2h + CR 119.4: a spell with an "A or B" additional cost
+//! lets its caster choose only a branch that can be paid. When exactly one
+//! branch is payable there is no choice to announce and that branch is paid.
+
+use engine::ai_support::candidate_actions;
+use engine::game::scenario::{GameRunner, GameScenario, P0, P1};
+use engine::types::ability::TargetRef;
+use engine::types::actions::GameAction;
+use engine::types::game_state::{CastPaymentMode, StackEntryKind, WaitingFor};
+use engine::types::identifiers::ObjectId;
+use engine::types::mana::{ManaCost, ManaType, ManaUnit};
+use engine::types::phase::Phase;
+use engine::types::zones::Zone;
+
+const DISCARD_OR_LIFE: &str = "As an additional cost to cast this spell, discard a card or pay 3 life.\nDestroy target creature or planeswalker.";
+const BEHOLD_OR_MANA: &str =
+    "As an additional cost to cast this spell, behold a Jace or pay {1}.\nDestroy target creature.";
+
+struct Board {
+    oracle: &'static str,
+    life: i32,
+    black_mana: usize,
+    spare_card_in_hand: bool,
+    jace_on_battlefield: bool,
+}
+
+struct Outcome {
+    /// Answers the engine offered at the "A or B" prompt; empty when it did
+    /// not ask.
+    offered: Vec<bool>,
+    life: i32,
+    hand: usize,
+    floating_mana: usize,
+    additional_cost_paid: bool,
+}
+
+/// Cast the spell at the Bear and answer the "A or B" prompt with `answer`
+/// when the engine asks. Every offered answer is also submitted on a copy of
+/// the game, so an offer the engine then rejects fails the test.
+fn cast(board: &Board, answer: bool) -> Outcome {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    scenario.with_life(P0, board.life);
+    scenario.with_mana_pool(
+        P0,
+        (0..board.black_mana)
+            .map(|_| ManaUnit::new(ManaType::Black, ObjectId(0), false, vec![]))
+            .collect(),
+    );
+    let bear = scenario.add_creature(P1, "Bear", 2, 2).id();
+    if board.spare_card_in_hand {
+        scenario.add_card_to_hand(P0, "Spare");
+    }
+    if board.jace_on_battlefield {
+        scenario
+            .add_creature(P0, "Jace", 0, 0)
+            .as_planeswalker_with_loyalty("Jace", 3);
+    }
+    let spell = scenario
+        .add_spell_to_hand_from_oracle(P0, "Spell", true, board.oracle)
+        .with_mana_cost(ManaCost::generic(1))
+        .id();
+    let mut runner = scenario.build();
+    let card_id = runner.state().objects[&spell].card_id;
+    runner
+        .act(GameAction::CastSpell {
+            object_id: spell,
+            card_id,
+            targets: vec![],
+            payment_mode: CastPaymentMode::Auto,
+        })
+        .expect("cast");
+
+    let mut offered = Vec::new();
+    for _ in 0..16 {
+        match runner.state().waiting_for.clone() {
+            WaitingFor::TargetSelection { .. } => {
+                runner
+                    .act(GameAction::ChooseTarget {
+                        target: Some(TargetRef::Object(bear)),
+                    })
+                    .expect("target the Bear");
+            }
+            WaitingFor::OptionalCostChoice { .. } => {
+                assert!(offered.is_empty(), "the choice is asked once");
+                for candidate in candidate_actions(runner.state()) {
+                    if let GameAction::DecideOptionalCost { pay } = candidate.action {
+                        GameRunner::from_state(runner.state().clone())
+                            .act(GameAction::DecideOptionalCost { pay })
+                            .unwrap_or_else(|error| {
+                                panic!("offered pay={pay} is rejected: {error:?}")
+                            });
+                        offered.push(pay);
+                    }
+                }
+                offered.sort();
+                runner
+                    .act(GameAction::DecideOptionalCost { pay: answer })
+                    .expect("answer the choice");
+            }
+            WaitingFor::PayCost { choices, .. } => {
+                runner
+                    .act(GameAction::SelectCards {
+                        cards: vec![choices[0]],
+                    })
+                    .expect("pick the card for the cost");
+            }
+            WaitingFor::ManaPayment { .. } => {
+                runner.act(GameAction::PassPriority).expect("pay mana");
+            }
+            WaitingFor::Priority { .. } => break,
+            other => panic!("unexpected prompt: {other:?}"),
+        }
+    }
+
+    let state = runner.state();
+    assert_eq!(state.objects[&spell].zone, Zone::Stack, "the spell is cast");
+    let additional_cost_paid = state
+        .stack
+        .iter()
+        .find_map(|entry| match &entry.kind {
+            StackEntryKind::Spell {
+                ability: Some(ability),
+                ..
+            } if entry.id == spell => Some(ability.context.additional_cost_paid),
+            _ => None,
+        })
+        .expect("the spell's stack entry");
+    Outcome {
+        offered,
+        life: state.players[0].life,
+        hand: state.players[0].hand.len(),
+        floating_mana: state.players[0].mana_pool.total(),
+        additional_cost_paid,
+    }
+}
+
+fn discard_or_life(life: i32, spare_card_in_hand: bool) -> Board {
+    Board {
+        oracle: DISCARD_OR_LIFE,
+        life,
+        black_mana: 1,
+        spare_card_in_hand,
+        jace_on_battlefield: false,
+    }
+}
+
+fn behold_or_mana(black_mana: usize, jace_on_battlefield: bool) -> Board {
+    Board {
+        oracle: BEHOLD_OR_MANA,
+        life: 20,
+        black_mana,
+        spare_card_in_hand: false,
+        jace_on_battlefield,
+    }
+}
+
+#[test]
+fn both_branches_payable_asks_and_pays_the_chosen_one() {
+    let discard = cast(&discard_or_life(20, true), true);
+    assert_eq!(discard.offered, vec![false, true]);
+    assert_eq!((discard.life, discard.hand), (20, 0));
+    assert!(discard.additional_cost_paid);
+
+    let life = cast(&discard_or_life(20, true), false);
+    assert_eq!(life.offered, vec![false, true]);
+    assert_eq!((life.life, life.hand), (17, 1));
+    assert!(!life.additional_cost_paid);
+}
+
+#[test]
+fn only_the_first_branch_payable_pays_it_without_asking() {
+    // CR 119.4: a player at 2 life can't pay 3 life.
+    let outcome = cast(&discard_or_life(2, true), false);
+    assert_eq!(outcome.offered, Vec::<bool>::new());
+    assert_eq!((outcome.life, outcome.hand), (2, 0));
+    assert!(outcome.additional_cost_paid);
+}
+
+#[test]
+fn only_the_second_branch_payable_pays_it_without_asking() {
+    let outcome = cast(&discard_or_life(20, false), true);
+    assert_eq!(outcome.offered, Vec::<bool>::new());
+    assert_eq!((outcome.life, outcome.hand), (17, 0));
+    assert!(!outcome.additional_cost_paid);
+}
+
+#[test]
+fn a_mana_branch_that_cannot_be_paid_beside_the_spell_is_not_offered() {
+    // One mana pays the spell's {1}; nothing is left for the "or pay {1}".
+    let outcome = cast(&behold_or_mana(1, true), false);
+    assert_eq!(outcome.offered, Vec::<bool>::new());
+    assert_eq!(outcome.floating_mana, 0);
+    assert!(outcome.additional_cost_paid);
+}
+
+#[test]
+fn a_mana_branch_is_paid_without_asking_when_nothing_can_be_beheld() {
+    let outcome = cast(&behold_or_mana(2, false), true);
+    assert_eq!(outcome.offered, Vec::<bool>::new());
+    assert_eq!(outcome.floating_mana, 0);
+    assert!(!outcome.additional_cost_paid);
+}
+
+#[test]
+fn a_payable_mana_branch_is_offered_beside_a_behold() {
+    let behold = cast(&behold_or_mana(2, true), true);
+    assert_eq!(behold.offered, vec![false, true]);
+    assert_eq!(behold.floating_mana, 1);
+
+    let mana = cast(&behold_or_mana(2, true), false);
+    assert_eq!(mana.offered, vec![false, true]);
+    assert_eq!(mana.floating_mana, 0);
+}
+
+/// A Bear for the spell to destroy, the spell in hand beside a spare card,
+/// and one black mana floating.
+fn driver_board(life: i32) -> (GameRunner, ObjectId, ObjectId, ObjectId) {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    scenario.with_life(P0, life);
+    scenario.with_mana_pool(
+        P0,
+        vec![ManaUnit::new(ManaType::Black, ObjectId(0), false, vec![])],
+    );
+    let bear = scenario.add_creature(P1, "Bear", 2, 2).id();
+    let spare = scenario.add_card_to_hand(P0, "Spare");
+    let spell = scenario
+        .add_spell_to_hand_from_oracle(P0, "Spell", true, DISCARD_OR_LIFE)
+        .with_mana_cost(ManaCost::generic(1))
+        .id();
+    (scenario.build(), bear, spare, spell)
+}
+
+/// The cast driver answers a cost's card selection from the scripted
+/// card-choice queue when no cost object was declared.
+#[test]
+fn cast_driver_pays_a_discard_cost_from_the_card_choice_queue() {
+    let (mut runner, bear, spare, spell) = driver_board(2);
+    let mut groups = std::collections::VecDeque::from([vec![spare]]);
+    let committed = runner
+        .cast(spell)
+        .target_object(bear)
+        .commit_with_card_choices(&mut groups)
+        .expect("cast");
+    assert!(groups.is_empty(), "the group answered the discard");
+    assert_eq!(committed.state().objects[&spare].zone, Zone::Graveyard);
+    assert_eq!(committed.state().players[0].life, 2);
+}
+
+/// A declared cost object answers the selection; the queue is left for the
+/// prompts that follow.
+#[test]
+fn cast_driver_prefers_a_declared_cost_object_over_the_queue() {
+    let (mut runner, bear, spare, spell) = driver_board(2);
+    let mut groups = std::collections::VecDeque::from([vec![bear]]);
+    let committed = runner
+        .cast(spell)
+        .target_object(bear)
+        .pay_cost_with(&[spare])
+        .commit_with_card_choices(&mut groups)
+        .expect("cast");
+    assert_eq!(groups.len(), 1, "the queued group is not consumed");
+    assert_eq!(committed.state().objects[&spare].zone, Zone::Graveyard);
+}
+
+/// CR 119.4 + CR 704.5a: at exactly 3 life the life cost is payable; the
+/// spell is cast and its caster loses before anyone gets priority.
+#[test]
+fn cast_driver_stops_at_a_game_ended_by_the_life_payment() {
+    let (mut runner, bear, _spare, spell) = driver_board(3);
+    let committed = runner
+        .cast(spell)
+        .target_object(bear)
+        .decline_optional()
+        .commit();
+    assert_eq!(committed.state().players[0].life, 0);
+    assert!(matches!(
+        committed.state().waiting_for,
+        WaitingFor::GameOver { .. }
+    ));
+}
+
+/// A queued group naming a card the cost can't take is not its answer: the
+/// group stays queued and the cost selection is left unanswered.
+#[test]
+fn cast_driver_leaves_a_group_the_cost_cannot_take() {
+    let (mut runner, bear, spare, spell) = driver_board(2);
+    let mut groups = std::collections::VecDeque::from([vec![bear]]);
+    let result = runner
+        .cast(spell)
+        .target_object(bear)
+        .commit_with_card_choices(&mut groups);
+    assert!(result.is_err(), "the discard has no scripted answer");
+    assert_eq!(groups.len(), 1);
+    assert_eq!(runner.state().objects[&spare].zone, Zone::Hand);
+}
