+/// CR 601.2b + CR 601.2h: announce a spell's "A or B" additional cost. A
+/// branch that can't be paid beside the costs and reductions already settled
+/// on the cast (a Defiler's answer included) is not a choice; when exactly one
+/// branch is payable it is taken as its answer to the prompt would be.
+fn announce_choice_cost(
+    state: &mut GameState,
+    player: PlayerId,
+    pending: PendingCast,
+    choice: AdditionalCost,
+    events: &mut Vec<GameEvent>,
+) -> Result<WaitingFor, EngineError> {
+    let AdditionalCost::Choice(preferred, fallback) = &choice else {
+        return Ok(make_optional_cost_choice(state, player, choice, 0, pending));
+    };
+    let preferred_payable =
+        additional_cost_declaration_is_offerable(state, player, &pending, preferred.clone())?;
+    let fallback_payable =
+        additional_cost_declaration_is_offerable(state, player, &pending, fallback.clone())?;
+    if preferred_payable != fallback_payable {
+        return handle_decide_additional_cost(
+            state,
+            player,
+            pending,
+            &choice,
+            preferred_payable,
+            events,
+        );
+    }
+    Ok(make_optional_cost_choice(state, player, choice, 0, pending))
+}
