+/// CR 601.3 + CR 611.2a: Case's temporary graveyard-cast permission enables
+/// casting a creature card from its controller's graveyard, but not a
+/// noncreature card there.
+#[test]
+fn case_of_the_uneaten_feast_grants_its_graveyard_cast_permission() {
+    let parsed = parse_oracle_text(
+        CASE_OF_THE_UNEATEN_FEAST_ORACLE,
+        "Case of the Uneaten Feast",
+        &keyword_input(),
+        &["Enchantment".to_string()],
+        &[],
+    );
+    assert!(
+        carries_add_static_mode_graveyard_permission(&parsed),
+        "reach: the Solved ability must carry the graveyard-cast permission"
+    );
+    assert!(
+        !has_swallowed_detector(&parsed, "Optional_YouMay"),
+        "the permission's 'you may' must be represented, not reported as swallowed: {:?}",
+        parsed.parse_warnings
+    );
+
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let case = scenario
+        .add_creature(P0, "Case of the Uneaten Feast", 0, 0)
+        .as_enchantment()
+        .with_subtypes(vec!["Case"])
+        .from_oracle_text(CASE_OF_THE_UNEATEN_FEAST_ORACLE)
+        .id();
+    let creature = scenario
+        .add_creature_to_graveyard(P0, "Graveyard Creature", 2, 2)
+        .with_mana_cost(ManaCost::zero())
+        .id();
+    let noncreature = scenario
+        .add_spell_to_graveyard(P0, "Graveyard Instant", true)
+        .from_oracle_text("You gain 1 life.")
+        .with_mana_cost(ManaCost::zero())
+        .id();
+    let mut runner = scenario.build();
+    // Solved is the activated ability's prerequisite; Case solving has
+    // independent CR 719.3a runtime coverage.
+    runner
+        .state_mut()
+        .objects
+        .get_mut(&case)
+        .expect("Case on the battlefield")
+        .case_state
+        .as_mut()
+        .expect("Case state")
+        .is_solved = true;
+
+    assert!(!offered_to(&runner, P0, creature));
+    let activation = runner.activate(case, 0).resolve();
+    assert!(matches!(
+        activation.final_waiting_for(),
+        WaitingFor::Priority { player: P0 }
+    ));
+    assert!(activation.state().stack.is_empty());
+
+    assert!(
+        offered_to(&runner, P0, creature),
+        "the resolved ability must permit casting the creature from the graveyard"
+    );
+    assert!(
+        !offered_to(&runner, P0, noncreature),
+        "the permission applies only to creature cards"
+    );
+    runner.cast(creature).resolve();
+    assert_eq!(
+        runner.state().objects[&creature].zone,
+        Zone::Battlefield,
+        "the permitted creature spell resolves onto the battlefield"
+    );
+    assert!(runner.state().stack.is_empty());
+    assert!(matches!(
+        &runner.state().waiting_for,
+        WaitingFor::Priority { .. }
+    ));
+}
