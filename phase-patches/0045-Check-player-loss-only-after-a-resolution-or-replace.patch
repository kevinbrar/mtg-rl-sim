diff --git a/crates/engine/tests/integration/as_enters_life_payment_to_zero.rs b/crates/engine/tests/integration/as_enters_life_payment_to_zero.rs
new file mode 100644
index 000000000..4e873f27b
--- /dev/null
+++ b/crates/engine/tests/integration/as_enters_life_payment_to_zero.rs
@@ -0,0 +1,230 @@
+//! CR 119.4 + CR 704.3: a land's "as this land enters ... you may pay 2 life"
+//! payment may take its controller to 0 life. The entry finishes first; the
+//! player loses when state-based actions are next checked.
+
+use engine::game::scenario::{GameScenario, P0, P1};
+use engine::types::actions::GameAction;
+use engine::types::game_state::WaitingFor;
+use engine::types::mana::ManaCost;
+use engine::types::phase::Phase;
+use engine::types::zones::Zone;
+
+const PASSAGE: &str = "As this land enters, choose a basic land type. Then you may pay 2 life. If you don't, it enters tapped.\nThis land is the chosen type.";
+
+fn play_passage_and_pay(
+    life: i32,
+) -> (
+    engine::game::scenario::GameRunner,
+    engine::types::identifiers::ObjectId,
+) {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    scenario.with_life(P0, life);
+    let land = scenario
+        .add_land_to_hand(P0, "Multiversal Passage")
+        .from_oracle_text(PASSAGE)
+        .id();
+    let mut runner = scenario.build();
+    let card_id = runner.state().objects[&land].card_id;
+    runner
+        .act(GameAction::PlayLand {
+            object_id: land,
+            card_id,
+        })
+        .expect("the land play is legal");
+    assert!(
+        matches!(runner.state().waiting_for, WaitingFor::ReplacementChoice { player, .. } if player == P0),
+        "the pay-2-life choice is offered, got {:?}",
+        runner.state().waiting_for
+    );
+    runner
+        .act(GameAction::ChooseReplacement { index: 0 })
+        .expect("paying 2 life is legal at this life total");
+    (runner, land)
+}
+
+#[test]
+fn paying_life_to_zero_as_a_land_enters_finishes_the_entry_then_loses() {
+    let (mut runner, _land) = play_passage_and_pay(2);
+
+    assert_eq!(runner.state().players[0].life, 0);
+    let WaitingFor::NamedChoice {
+        player, options, ..
+    } = runner.state().waiting_for.clone()
+    else {
+        panic!(
+            "the land-type choice must still be asked, got {:?}",
+            runner.state().waiting_for
+        );
+    };
+    assert_eq!(player, P0);
+    assert!(options.iter().any(|option| option == "Swamp"));
+
+    runner
+        .act(GameAction::ChooseOption {
+            choice: "Swamp".to_string(),
+        })
+        .expect("the land-type choice is accepted");
+
+    assert!(
+        matches!(runner.state().waiting_for, WaitingFor::GameOver { winner: Some(winner) } if winner == P1),
+        "P0 loses at 0 life once the entry is complete, got {:?}",
+        runner.state().waiting_for
+    );
+}
+
+#[test]
+fn paying_life_above_zero_as_a_land_enters_keeps_the_game_going() {
+    let (mut runner, land) = play_passage_and_pay(3);
+
+    assert_eq!(runner.state().players[0].life, 1);
+    runner
+        .act(GameAction::ChooseOption {
+            choice: "Swamp".to_string(),
+        })
+        .expect("the land-type choice is accepted");
+
+    assert!(matches!(runner.state().waiting_for, WaitingFor::Priority { player } if player == P0));
+    let object = &runner.state().objects[&land];
+    assert_eq!(object.zone, Zone::Battlefield);
+    assert!(
+        !object.tapped,
+        "the land enters untapped when the life is paid"
+    );
+}
+
+fn cast_free_sorcery(
+    life: i32,
+    text: &str,
+    graveyard_passages: usize,
+) -> engine::game::scenario::GameRunner {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    scenario.with_life(P0, life);
+    for name in ["Library Card A", "Library Card B"] {
+        scenario.add_card_to_library_top(P0, name);
+    }
+    for _ in 0..graveyard_passages {
+        scenario
+            .add_land_to_graveyard(P0, "Multiversal Passage")
+            .from_oracle_text(PASSAGE);
+    }
+    let spell = scenario
+        .add_spell_to_hand_from_oracle(P0, "Test Sorcery", false, text)
+        .with_mana_cost(ManaCost::zero())
+        .id();
+    let mut runner = scenario.build();
+    let card_id = runner.state().objects[&spell].card_id;
+    runner
+        .act(GameAction::CastSpell {
+            object_id: spell,
+            card_id,
+            targets: Vec::new(),
+            payment_mode: Default::default(),
+        })
+        .expect("the sorcery is castable");
+    for _ in 0..4 {
+        if !matches!(runner.state().waiting_for, WaitingFor::Priority { .. })
+            || runner.state().stack.is_empty()
+        {
+            break;
+        }
+        runner
+            .act(GameAction::PassPriority)
+            .expect("passing priority is legal");
+    }
+    runner
+}
+
+/// CR 704.3 + CR 704.4: state-based actions are not checked while a spell
+/// resolves. A spell that takes its controller to 0 life, asks that player
+/// something, and then gains life leaves the player in the game.
+#[test]
+fn zero_life_during_a_resolution_is_not_a_loss_when_the_spell_restores_it() {
+    let mut runner = cast_free_sorcery(2, "You lose 2 life, then scry 1. You gain 5 life.", 0);
+
+    assert_eq!(runner.state().players[0].life, 0);
+    let WaitingFor::ScryChoice { cards, .. } = runner.state().waiting_for.clone() else {
+        panic!(
+            "the scry is still asked at 0 life, got {:?}",
+            runner.state().waiting_for
+        );
+    };
+    runner
+        .act(GameAction::SelectCards { cards })
+        .expect("keeping the card on top is legal");
+
+    assert_eq!(runner.state().players[0].life, 5);
+    assert!(
+        matches!(runner.state().waiting_for, WaitingFor::Priority { player } if player == P0),
+        "the game continues, got {:?}",
+        runner.state().waiting_for
+    );
+}
+
+/// CR 704.3: the loss still happens once the spell has finished resolving.
+#[test]
+fn zero_life_after_a_resolution_with_a_choice_is_a_loss() {
+    let mut runner = cast_free_sorcery(2, "You lose 2 life, then scry 1.", 0);
+
+    assert_eq!(runner.state().players[0].life, 0);
+    let WaitingFor::ScryChoice { cards, .. } = runner.state().waiting_for.clone() else {
+        panic!(
+            "the scry is still asked at 0 life, got {:?}",
+            runner.state().waiting_for
+        );
+    };
+    runner
+        .act(GameAction::SelectCards { cards })
+        .expect("keeping the card on top is legal");
+
+    assert!(
+        matches!(runner.state().waiting_for, WaitingFor::GameOver { winner: Some(winner) } if winner == P1),
+        "P0 loses when the spell has resolved, got {:?}",
+        runner.state().waiting_for
+    );
+}
+
+/// CR 614.1c + CR 704.4: two lands entering during one resolution, the first
+/// paid for at 2 life. The second land's choices and the rest of the spell
+/// still happen, and the life gained keeps the player in the game.
+#[test]
+fn paying_life_to_zero_for_a_land_entering_during_a_resolution_finishes_the_spell() {
+    let mut runner = cast_free_sorcery(
+        2,
+        "Return all land cards from your graveyard to the battlefield. You gain 5 life.",
+        2,
+    );
+    for _ in 0..12 {
+        let action = match runner.state().waiting_for.clone() {
+            WaitingFor::ReplacementChoice { .. } => {
+                // Pay for the first land only.
+                let index = if runner.state().players[0].life >= 2 {
+                    0
+                } else {
+                    1
+                };
+                GameAction::ChooseReplacement { index }
+            }
+            WaitingFor::NamedChoice { .. } => GameAction::ChooseOption {
+                choice: "Swamp".to_string(),
+            },
+            _ => break,
+        };
+        runner.act(action).expect("the entry choice is accepted");
+    }
+
+    assert!(
+        matches!(runner.state().waiting_for, WaitingFor::Priority { player } if player == P0),
+        "the game continues, got {:?}",
+        runner.state().waiting_for
+    );
+    assert_eq!(runner.state().players[0].life, 5);
+    let passages = runner
+        .state()
+        .objects
+        .values()
+        .filter(|object| object.name == "Multiversal Passage" && object.zone == Zone::Battlefield)
+        .count();
+    assert_eq!(passages, 2);
+}
