@@ -0,0 +1,152 @@
+use engine::game::scenario::{GameRunner, GameScenario, P0, P1};
+use engine::types::actions::GameAction;
+use engine::types::game_state::WaitingFor;
+use engine::types::mana::ManaCost;
+use engine::types::phase::Phase;
+use engine::types::zones::Zone;
+
+const ORACLE: &str = "Target player discards two cards. Put up to one land card discarded this way onto the battlefield tapped under your control.";
+
+fn mind_roots(scenario: &mut GameScenario) -> engine::types::ObjectId {
+    scenario
+        .add_spell_to_hand_from_oracle(P0, "Mind Roots", false, ORACLE)
+        .with_mana_cost(ManaCost::zero())
+        .id()
+}
+
+fn resolve_mind_roots(
+    runner: &mut GameRunner,
+    spell: engine::types::ObjectId,
+    discarded: &[engine::types::ObjectId],
+    chosen_land: Option<engine::types::ObjectId>,
+) -> bool {
+    let mut cast = runner.cast(spell).target_player(P1).commit();
+    let mut saw_land_choice = false;
+
+    for _ in 0..32 {
+        if cast.state().stack.is_empty()
+            && matches!(cast.state().waiting_for, WaitingFor::Priority { .. })
+        {
+            break;
+        }
+
+        match cast.state().waiting_for.clone() {
+            WaitingFor::Priority { .. } => cast
+                .act(GameAction::PassPriority)
+                .expect("passing priority must advance Mind Roots"),
+            WaitingFor::DiscardChoice { player, count, .. } => {
+                assert_eq!(player, P1);
+                assert_eq!(count, 2);
+                cast.act(GameAction::SelectCards {
+                    cards: discarded.to_vec(),
+                })
+                .expect("P1's discard choice must succeed");
+            }
+            WaitingFor::EffectZoneChoice {
+                player, cards, count, ..
+            } => {
+                assert_eq!(player, P0);
+                assert_eq!(count, 1);
+                assert_eq!(cards.len(), 1);
+                let selected = chosen_land.into_iter().collect::<Vec<_>>();
+                assert!(selected.iter().all(|card| cards.contains(card)));
+                cast.act(GameAction::SelectCards { cards: selected })
+                    .expect("P0's optional land choice must succeed");
+                saw_land_choice = true;
+            }
+            other => panic!("unexpected Mind Roots resolution state: {other:?}"),
+        }
+    }
+
+    assert!(cast.state().stack.is_empty(), "Mind Roots must finish resolving");
+    assert!(matches!(
+        cast.state().waiting_for,
+        WaitingFor::Priority { .. }
+    ));
+    saw_land_choice
+}
+
+fn scenario() -> GameScenario {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    scenario
+}
+
+#[test]
+fn mind_roots_choice_discard_places_land_tapped_under_its_caster() {
+    let mut scenario = scenario();
+    let spell = mind_roots(&mut scenario);
+    let land = scenario.add_land_to_hand(P1, "Forest").id();
+    let nonland = scenario.add_card_to_hand(P1, "Opt");
+    let third = scenario.add_card_to_hand(P1, "Divination");
+    let mut runner = scenario.build();
+
+    assert!(resolve_mind_roots(
+        &mut runner,
+        spell,
+        &[land, nonland],
+        Some(land)
+    ));
+    let object = &runner.state().objects[&land];
+    assert_eq!(object.zone, Zone::Battlefield);
+    assert_eq!(object.controller, P0);
+    assert!(object.tapped);
+    assert_eq!(runner.state().objects[&third].zone, Zone::Hand);
+}
+
+#[test]
+fn mind_roots_may_decline_the_discarded_land() {
+    let mut scenario = scenario();
+    let spell = mind_roots(&mut scenario);
+    let land = scenario.add_land_to_hand(P1, "Forest").id();
+    let nonland = scenario.add_card_to_hand(P1, "Opt");
+    scenario.add_card_to_hand(P1, "Divination");
+    let mut runner = scenario.build();
+
+    assert!(resolve_mind_roots(
+        &mut runner,
+        spell,
+        &[land, nonland],
+        None
+    ));
+    assert_eq!(runner.state().objects[&land].zone, Zone::Graveyard);
+}
+
+#[test]
+fn mind_roots_forced_discard_places_the_land_without_a_discard_prompt() {
+    let mut scenario = scenario();
+    let spell = mind_roots(&mut scenario);
+    let land = scenario.add_land_to_hand(P1, "Forest").id();
+    let nonland = scenario.add_card_to_hand(P1, "Opt");
+    let mut runner = scenario.build();
+
+    assert!(resolve_mind_roots(
+        &mut runner,
+        spell,
+        &[land, nonland],
+        Some(land)
+    ));
+    let object = &runner.state().objects[&land];
+    assert_eq!(object.zone, Zone::Battlefield);
+    assert_eq!(object.controller, P0);
+    assert!(object.tapped);
+}
+
+#[test]
+fn mind_roots_does_not_prompt_when_no_discarded_land_exists() {
+    let mut scenario = scenario();
+    let spell = mind_roots(&mut scenario);
+    let first = scenario.add_card_to_hand(P1, "Opt");
+    let second = scenario.add_card_to_hand(P1, "Divination");
+    scenario.add_card_to_hand(P1, "Shock");
+    let mut runner = scenario.build();
+
+    assert!(!resolve_mind_roots(
+        &mut runner,
+        spell,
+        &[first, second],
+        None
+    ));
+    assert_eq!(runner.state().objects[&first].zone, Zone::Graveyard);
+    assert_eq!(runner.state().objects[&second].zone, Zone::Graveyard);
+}
