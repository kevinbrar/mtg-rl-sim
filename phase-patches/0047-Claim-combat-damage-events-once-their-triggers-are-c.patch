diff --git a/crates/engine/tests/integration/combat_damage_trigger_beside_delayed_trigger.rs b/crates/engine/tests/integration/combat_damage_trigger_beside_delayed_trigger.rs
new file mode 100644
index 000000000..8d4484300
--- /dev/null
+++ b/crates/engine/tests/integration/combat_damage_trigger_beside_delayed_trigger.rs
@@ -0,0 +1,275 @@
+//! CR 603.2c: an ability triggers once per event. A delayed triggered ability
+//! that triggers on the same combat damage does not make the creature's own
+//! combat damage ability trigger a second time.
+
+use engine::game::combat::AttackTarget;
+use engine::game::scenario::{GameScenario, P0, P1};
+use engine::types::actions::GameAction;
+use engine::types::game_state::WaitingFor;
+use engine::types::identifiers::ObjectId;
+use engine::types::mana::{ManaType, ManaUnit};
+use engine::types::phase::Phase;
+
+const HUNTERS_INSIGHT: &str = "Choose target creature you control. Whenever that creature deals combat damage to a player or planeswalker this turn, draw that many cards.";
+
+fn attack_with_insight_bear(cast_insight: bool, with_trade: bool) -> (i32, usize) {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let bear = scenario
+        .add_creature(P0, "Insight Bear", 3, 3)
+        .from_oracle_text(
+            "Whenever this creature deals combat damage to a player, you gain 1 life.",
+        )
+        .id();
+    let attacker = scenario.add_creature(P0, "Attacker", 1, 1).id();
+    let blocker = scenario.add_creature(P1, "Blocker", 1, 1).id();
+    let insight = scenario
+        .add_spell_to_hand_from_oracle(P0, "Hunter's Insight", true, HUNTERS_INSIGHT)
+        .id();
+    for name in ["A", "B", "C", "D", "E", "F", "G", "H"] {
+        scenario.add_card_to_library_top(P0, name);
+    }
+    let mut runner = scenario.build();
+    if cast_insight {
+        runner.cast(insight).target_object(bear).resolve();
+    }
+    let hand_before = runner.state().players[0].hand.len();
+
+    for _ in 0..60 {
+        let state = runner.state();
+        if state.phase == Phase::PostCombatMain {
+            break;
+        }
+        match state.waiting_for.clone() {
+            WaitingFor::DeclareAttackers { .. } => {
+                let mut attacks = vec![(bear, AttackTarget::Player(P1))];
+                if with_trade {
+                    attacks.push((attacker, AttackTarget::Player(P1)));
+                }
+                runner
+                    .act(GameAction::DeclareAttackers {
+                        attacks,
+                        bands: vec![],
+                    })
+                    .expect("attack is legal");
+            }
+            WaitingFor::DeclareBlockers { .. } => {
+                let assignments = if with_trade {
+                    vec![(blocker, attacker)]
+                } else {
+                    vec![]
+                };
+                runner
+                    .act(GameAction::DeclareBlockers { assignments })
+                    .expect("block is legal");
+            }
+            WaitingFor::OrderTriggers { triggers, .. } => {
+                runner
+                    .act(GameAction::OrderTriggers {
+                        order: (0..triggers.len()).collect(),
+                    })
+                    .expect("ordering is legal");
+            }
+            WaitingFor::Priority { .. } => {
+                runner.act(GameAction::PassPriority).expect("pass is legal");
+            }
+            other => panic!("unexpected prompt {other:?}"),
+        }
+    }
+
+    let state = runner.state();
+    assert_eq!(state.players[1].life, 17);
+    (
+        state.players[0].life,
+        state.players[0].hand.len() - hand_before,
+    )
+}
+
+#[test]
+fn own_trigger_fires_once_without_a_delayed_trigger() {
+    assert_eq!(attack_with_insight_bear(false, false), (21, 0));
+}
+
+#[test]
+fn own_trigger_fires_once_beside_a_delayed_trigger() {
+    assert_eq!(attack_with_insight_bear(true, false), (21, 3));
+}
+
+#[test]
+fn own_trigger_fires_once_beside_a_delayed_trigger_and_a_death() {
+    assert_eq!(attack_with_insight_bear(true, true), (21, 3));
+}
+
+/// CR 603.3b: two different abilities of one controller raise the ordering
+/// prompt without any delayed trigger; each still triggers once.
+#[test]
+fn two_ordinary_triggers_of_one_controller_fire_once_each() {
+    assert_eq!(
+        attack_with_two_ordinary_triggers(0, false, true),
+        (17, 21, 1)
+    );
+}
+
+/// CR 603.3b: life lost to unspent mana as the declare blockers step ends is
+/// an earlier event of the same pass. Its trigger waits and goes on the stack
+/// with the damage batch, whether or not that batch opens an order prompt.
+#[test]
+fn earlier_event_of_the_pass_still_triggers_beside_an_order_prompt() {
+    assert_eq!(
+        attack_with_two_ordinary_triggers(1, false, true),
+        (18, 20, 1)
+    );
+}
+
+/// CR 603.3b: the same with a single combat damage ability, which goes on
+/// the stack without a prompt.
+#[test]
+fn earlier_event_of_the_pass_still_triggers_beside_one_combat_trigger() {
+    assert_eq!(
+        attack_with_two_ordinary_triggers(1, false, false),
+        (18, 20, 0)
+    );
+}
+
+/// CR 603.3b: the earlier event's abilities need an order of their own. Both
+/// order prompts are answered and every ability resolves once.
+#[test]
+fn earlier_event_with_its_own_order_prompt_keeps_the_combat_triggers() {
+    assert_eq!(
+        attack_with_two_ordinary_triggers(2, false, true),
+        (20, 20, 1)
+    );
+    assert_eq!(
+        attack_with_two_ordinary_triggers(2, true, true),
+        (20, 20, 3)
+    );
+}
+
+/// CR 603.7: with two ordinary abilities beside it, the delayed ability still
+/// triggers: 2 cards for the Gainer's damage plus the Drawer's own card.
+#[test]
+fn delayed_trigger_fires_beside_two_ordinary_triggers() {
+    assert_eq!(
+        attack_with_two_ordinary_triggers(0, true, true),
+        (17, 21, 3)
+    );
+}
+
+/// Returns (defender life, attacker life, cards drawn).
+fn attack_with_two_ordinary_triggers(
+    life_loss_observers: usize,
+    cast_insight: bool,
+    drawer_triggers: bool,
+) -> (i32, i32, usize) {
+    let lose_unspent_mana = life_loss_observers > 0;
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    if lose_unspent_mana {
+        scenario.add_creature_from_oracle(
+            P0,
+            "Mana Burner",
+            0,
+            4,
+            "A player losing unspent mana causes that player to lose that much life.",
+        );
+        scenario.add_creature_from_oracle(
+            P1,
+            "Bystander",
+            0,
+            4,
+            "Whenever an opponent loses life, you gain 1 life.",
+        );
+        if life_loss_observers > 1 {
+            scenario.add_creature_from_oracle(
+                P1,
+                "Second Bystander",
+                0,
+                4,
+                "Whenever an opponent loses life, you gain 2 life.",
+            );
+        }
+    }
+    let gainer = scenario
+        .add_creature(P0, "Gainer", 2, 2)
+        .from_oracle_text(
+            "Whenever this creature deals combat damage to a player, you gain 1 life.",
+        )
+        .id();
+    let mut drawer = scenario.add_creature(P0, "Drawer", 1, 1);
+    if drawer_triggers {
+        drawer.from_oracle_text(
+            "Whenever this creature deals combat damage to a player, draw a card.",
+        );
+    }
+    let drawer = drawer.id();
+    for name in ["A", "B", "C", "D"] {
+        scenario.add_card_to_library_top(P0, name);
+    }
+    let insight = scenario
+        .add_spell_to_hand_from_oracle(P0, "Hunter's Insight", true, HUNTERS_INSIGHT)
+        .id();
+    let mut runner = scenario.build();
+    if cast_insight {
+        runner.cast(insight).target_object(gainer).resolve();
+    }
+    let hand_before = runner.state().players[0].hand.len();
+    let mut order_prompts = 0;
+    for _ in 0..60 {
+        let state = runner.state();
+        if state.phase == Phase::PostCombatMain {
+            break;
+        }
+        match state.waiting_for.clone() {
+            WaitingFor::DeclareAttackers { .. } => {
+                runner
+                    .act(GameAction::DeclareAttackers {
+                        attacks: vec![
+                            (gainer, AttackTarget::Player(P1)),
+                            (drawer, AttackTarget::Player(P1)),
+                        ],
+                        bands: vec![],
+                    })
+                    .expect("attack is legal");
+            }
+            WaitingFor::DeclareBlockers { .. } => {
+                if lose_unspent_mana {
+                    runner.state_mut().players[0].mana_pool.add(ManaUnit::new(
+                        ManaType::Red,
+                        ObjectId(9_999),
+                        false,
+                        vec![],
+                    ));
+                }
+                runner
+                    .act(GameAction::DeclareBlockers {
+                        assignments: vec![],
+                    })
+                    .expect("block is legal");
+            }
+            WaitingFor::OrderTriggers { triggers, .. } => {
+                order_prompts += 1;
+                runner
+                    .act(GameAction::OrderTriggers {
+                        order: (0..triggers.len()).collect(),
+                    })
+                    .expect("ordering is legal");
+            }
+            WaitingFor::Priority { .. } => {
+                runner.act(GameAction::PassPriority).expect("pass is legal");
+            }
+            other => panic!("unexpected prompt {other:?}"),
+        }
+    }
+    let state = runner.state();
+    let expected_prompts = if drawer_triggers {
+        life_loss_observers.max(1)
+    } else {
+        0
+    };
+    assert_eq!(order_prompts, expected_prompts);
+    (
+        state.players[1].life,
+        state.players[0].life,
+        state.players[0].hand.len() - hand_before,
+    )
+}
