diff --git a/crates/engine/src/game/combat_damage.rs b/crates/engine/src/game/combat_damage.rs
index 36006b2f4..651961d70 100644
--- a/crates/engine/src/game/combat_damage.rs
+++ b/crates/engine/src/game/combat_damage.rs
@@ -120,12 +120,18 @@ fn process_combat_damage_triggers(
     // player before constructing the APNAP ordering pass.
     pending.retain(|ctx| crate::game::players::is_alive(state, ctx.pending.controller));
 
-    triggers::process_collected_triggers_with_delayed_events(
+    let outcome = triggers::process_collected_triggers_with_delayed_events(
         state,
         pending,
         &before_priority_events,
         all_events,
     );
+    // CR 603.2c: this step collected the ordinary triggers of its events. When
+    // the batch leaves the stack empty (an ordering or target prompt), the
+    // post-action collector would otherwise collect them a second time.
+    if outcome.fired {
+        triggers::claim_events_for_ordinary_collection(state, all_events, 0);
+    }
 }
 
 /// Resolve combat damage with first strike / double strike support (CR 510.1).
