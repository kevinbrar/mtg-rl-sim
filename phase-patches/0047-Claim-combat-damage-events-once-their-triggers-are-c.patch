+/// CR 603.3b on the PAUSED batch: life lost to unspent mana as the declare
+/// blockers step ends happened earlier in the same pass than the combat
+/// damage. Its "whenever an opponent loses life" observer is still waiting
+/// when the batch parks on the CR 616.1 choice, and goes on the stack exactly
+/// once with the resumed batch.
+#[test]
+fn earlier_event_of_the_pass_triggers_once_after_the_resume() {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let lifelinker = add_lifelinker(&mut scenario, P0, "Lifelinker", 3, 3);
+    scenario.add_creature_from_oracle(
+        P0,
+        "Mana Burner",
+        0,
+        4,
+        "A player losing unspent mana causes that player to lose that much life.",
+    );
+    scenario.add_creature_from_oracle(
+        P1,
+        "Bystander",
+        0,
+        4,
+        "Whenever an opponent loses life, you gain 1 life.",
+    );
+    install_competing_life_gain_replacements(&mut scenario, P0);
+    let mut runner = scenario.build();
+
+    for _ in 0..8 {
+        if matches!(
+            runner.state().waiting_for,
+            WaitingFor::DeclareAttackers { .. }
+        ) {
+            break;
+        }
+        runner
+            .act(GameAction::PassPriority)
+            .expect("reach declare attackers");
+    }
+    runner
+        .act(GameAction::DeclareAttackers {
+            attacks: vec![(lifelinker, AttackTarget::Player(P1))],
+            bands: vec![],
+        })
+        .expect("attack is legal");
+    for _ in 0..8 {
+        if matches!(
+            runner.state().waiting_for,
+            WaitingFor::DeclareBlockers { .. }
+        ) {
+            break;
+        }
+        runner
+            .act(GameAction::PassPriority)
+            .expect("reach declare blockers");
+    }
+    runner.state_mut().players[0].mana_pool.add(ManaUnit::new(
+        ManaType::Red,
+        ObjectId(9_999),
+        false,
+        vec![],
+    ));
+    runner
+        .act(GameAction::DeclareBlockers {
+            assignments: vec![],
+        })
+        .expect("block is legal");
+    advance_through_combat_damage(&mut runner);
+
+    assert!(
+        matches!(
+            runner.state().waiting_for,
+            WaitingFor::ReplacementChoice { .. }
+        ),
+        "reach guard: the batch must PARK on the CR 616.1 choice; got {:?}",
+        runner.state().waiting_for
+    );
+    assert_eq!(
+        runner.life(P0),
+        19,
+        "reach guard: the unspent mana cost 1 life before the damage"
+    );
+
+    let (answered, _) = answer_ordering_prompts(&mut runner, DOUBLER);
+    assert!(
+        answered > 0,
+        "reach guard: the CR 616.1 choice was answered"
+    );
+    advance_through_combat_damage(&mut runner);
+
+    // 19 + (3 * 2 + 1) for the controller; 20 - 3 + 1 for the defender.
+    assert_eq!((runner.life(P0), runner.life(P1)), (26, 18));
+}
