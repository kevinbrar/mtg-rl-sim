+#[test]
+fn x_spell_optional_sacrifice_is_not_previewed_through_tap_then_sacrifice() {
+    // The runtime deferred-sacrifice payment does not auto-tap for X costs, so
+    // the preview must not offer an X spell that only tap-then-sacrifice pays.
