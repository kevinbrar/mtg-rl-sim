+    fn deferred_spell_sacrifice_must_still_be_on_the_battlefield_at_commit() {
+        use crate::game::scenario::GameScenario;
+
+        // CR 601.2h: a selected sacrifice that has left the battlefield can no
+        // longer pay the cost.
+        let mut scenario = GameScenario::new();
+        scenario.at_phase(crate::types::Phase::PreCombatMain);
+        let fodder = scenario.add_creature(PlayerId(0), "Memnite", 1, 1).id();
+        let spell_id = scenario
+            .add_spell_to_hand(PlayerId(0), "Sacrifice Spell", true)
+            .id();
+        let mut runner = scenario.build();
+        let ability = ResolvedAbility::new(Effect::NoOp, vec![], spell_id, PlayerId(0));
+        let mut pending = PendingCast::new(
+            spell_id,
+            runner.state().objects[&spell_id].card_id,
+            ability,
+            ManaCost::zero(),
+        );
+        pending.deferred_sacrificed_permanents = vec![DeferredSpellSacrifice::Selected {
+            object_id: fodder,
+            filter: TargetFilter::Any,
+        }];
+        assert!(validate_deferred_spell_sacrifices_at_commit(
+            runner.state(),
+            PlayerId(0),
+            &pending
+        )
+        .is_ok());
+
+        let state = runner.state_mut();
+        state.battlefield.retain(|id| *id != fodder);
+        state.objects.get_mut(&fodder).unwrap().zone = Zone::Graveyard;
+        assert!(validate_deferred_spell_sacrifices_at_commit(
+            runner.state(),
+            PlayerId(0),
+            &pending
+        )
+        .is_err());
+    }
 }
