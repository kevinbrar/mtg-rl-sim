+#[test]
+fn fixed_count_optional_sacrifice_taps_a_chosen_mana_rock_first() {
+    // CR 601.2g + CR 601.2h: Sol Ring taps for {C}{C} and is then one of the
+    // two sacrificed permanents; Swamp + Sol Ring pay the reduced {2}{B}.
+    let oracle = "As an additional cost to cast this spell, you may sacrifice two nonland permanents. This spell costs {1} less to cast for each permanent sacrificed this way.";
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    scenario.add_basic_land(P0, ManaColor::Black);
+    let spell = scenario
+        .add_spell_to_hand_from_oracle(P0, "Fixed Count Spell", true, oracle)
+        .with_mana_cost(ManaCost::Cost {
+            shards: vec![ManaCostShard::Black],
+            generic: 4,
+        })
+        .id();
+    let memnite = scenario.add_creature(P0, "Memnite", 1, 1).id();
+    let sol_ring = scenario
+        .add_artifact_from_oracle(P0, "Sol Ring", "{T}: Add {C}{C}.")
+        .id();
+    let mut runner = scenario.build();
+    assert!(
+        engine::ai_support::legal_actions(runner.state())
+            .iter()
+            .any(|action| matches!(action, GameAction::CastSpell { object_id, .. } if *object_id == spell)),
+        "Sol Ring taps for mana before it is sacrificed"
+    );
+    let card_id = runner.state().objects[&spell].card_id;
+    runner
+        .act(GameAction::CastSpell {
+            object_id: spell,
+            card_id,
+            targets: vec![],
+            payment_mode: CastPaymentMode::Auto,
+        })
+        .expect("begin the cast");
+    runner
+        .act(GameAction::DecideOptionalCost { pay: true })
+        .expect("accept optional sacrifice cost");
+    if matches!(
+        runner.state().waiting_for,
+        WaitingFor::PayCost {
+            kind: PayCostKind::Sacrifice,
+            ..
+        }
+    ) {
+        runner
+            .act(GameAction::SelectCards {
+                cards: vec![memnite, sol_ring],
+            })
+            .expect("sacrifice Memnite and the tapped Sol Ring");
+    }
+    assert!(runner.state().stack.iter().any(|entry| entry.id == spell));
+    for id in [memnite, sol_ring] {
+        assert_eq!(
+            runner.state().objects[&id].zone,
+            engine::types::zones::Zone::Graveyard
+        );
+    }
+    assert_eq!(runner.state().players[P0.0 as usize].mana_pool.total(), 0);
+}
