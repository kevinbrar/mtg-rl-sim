+fn rottenmouth_viper_commit_rejects_a_chosen_sacrifice_that_left_the_battlefield() {
+    // CR 601.2h: a chosen sacrifice that is gone when costs are paid cannot pay
+    // the cost, so the manual payment must not commit the cast.
+    let (mut runner, viper, lands, fodder, _) = build_scenario_with_counts(4, 2, 0, 0);
+    let card_id = runner.state().objects[&viper].card_id;
+    runner
+        .act(GameAction::CastSpell {
+            object_id: viper,
+            card_id,
+            targets: vec![],
+            payment_mode: CastPaymentMode::Manual,
+        })
+        .expect("begin the cast");
+    runner
+        .act(GameAction::DecideOptionalCost { pay: true })
+        .expect("accept optional sacrifice cost");
+    runner
+        .act(GameAction::ChooseX { value: 2 })
+        .expect("choose two sacrifices");
+    runner
+        .act(GameAction::SelectCards {
+            cards: fodder.clone(),
+        })
+        .expect("select both Memnites");
+    assert!(matches!(
+        runner.state().waiting_for,
+        WaitingFor::ManaPayment { .. }
+    ));
+    for land in &lands {
+        let (_, _, grouped) = engine::ai_support::legal_actions_full(runner.state());
+        let action = grouped
+            .get(land)
+            .into_iter()
+            .flatten()
+            .next()
+            .cloned()
+            .expect("the engine offers the Swamp while paying");
+        runner.act(action).expect("tap the Swamp");
+    }
+    // The engine reserves chosen sacrifices, so remove one behind its back.
+    let gone = fodder[0];
+    let state = runner.state_mut();
+    state.battlefield.retain(|id| *id != gone);
+    state.objects.get_mut(&gone).unwrap().zone = engine::types::zones::Zone::Exile;
+
+    let error = runner
+        .act(GameAction::PassPriority)
+        .expect_err("a missing chosen sacrifice must fail the commit");
+    assert!(
+        format!("{error:?}").contains("Deferred sacrifice permanent"),
+        "the commit-time sacrifice validation must be what rejects the payment: {error:?}"
     );
+    assert!(runner.state().battlefield.contains(&fodder[1]));
+}
