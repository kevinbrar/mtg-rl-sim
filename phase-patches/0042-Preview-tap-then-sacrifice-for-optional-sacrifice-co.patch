+/// CR 601.2g + CR 601.2h: Mana abilities are activated before costs are paid,
+/// so a chosen permanent may tap for mana and then be sacrificed. Mirrors
+/// `auto_activate_spell_mana_abilities_before_deferred_sacrifice`: the cast is
+/// payable when the Auto payer covers `reduced` and every chosen permanent is
+/// still a live sacrifice afterwards.
+fn mana_before_sacrifice_pays(
+    state: &GameState,
+    player: PlayerId,
+    spell_id: ObjectId,
+    cost_filter: &TargetFilter,
+    chosen: &[ObjectId],
+    reduced: &ManaCost,
+) -> bool {
+    if cost_has_x(reduced)
+        || !super::casting::can_pay_cost_after_auto_tap(state, player, spell_id, reduced)
+    {
+        return false;
+    }
+    let mut simulated = state.clone();
+    let mut events = Vec::new();
+    let spell_meta = super::casting::build_spell_meta(&simulated, player, spell_id);
+    let spell_ctx = spell_meta.as_ref().map(PaymentContext::Spell);
+    auto_tap_mana_sources_with_context_and_resume(
+        &mut simulated,
+        player,
+        reduced,
+        &mut events,
+        Some(spell_id),
+        spell_ctx.as_ref(),
+        None,
+    );
+    if super::casting::mana_ability_cost_payment_is_paused(&simulated) {
+        return false;
+    }
+    // CR 605.4a: triggered mana abilities from those taps resolve immediately.
+    super::triggers::resolve_tap_mana_triggers_inline(&mut simulated, &mut events, 0);
+    chosen.iter().all(|&id| {
+        validate_deferred_spell_sacrifice_selection(&simulated, player, spell_id, id, cost_filter)
+            .is_ok()
+    }) && super::casting::can_pay_cost_after_auto_tap(&simulated, player, spell_id, reduced)
+}
