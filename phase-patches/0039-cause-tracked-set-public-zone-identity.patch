     b.next_tracked_set_id = a.next_tracked_set_id;
@@ -27653,7 +27663,8 @@ mod tests {
     /// CR 608.2c: an appended tracked set is equalized while the latest non-empty set, the one the
     /// sentinel's fallback reads, keeps its members; a new member or a changed earlier set refuses.
     #[test]
-    fn the_history_cover_admits_appended_tracked_sets_only_while_the_latest_members_stay() {
+    fn mind_roots_discard_placement_history_cover_admits_appended_tracked_sets_only_while_the_latest_members_stay(
+    ) {
         use crate::types::identifiers::TrackedSetId;
         let with_sets = |sets: &[(u64, &[u64])]| {
             let mut state = GameState::new_two_player(42);
@@ -30615,4 +30626,43 @@ mod tests {
             ReplacementDefinition::new(ReplacementEvent::DamageDone).runtime_execute(id);
         assert!(live_history_reads(&state).reads(HistoryMember::PlayerTurnsTaken));
     }
+
+    #[test]
+    fn mind_roots_discard_placement_all_reads_exclude_member_incarnations() {
+        assert!(
+            !HistoryReads::ALL.reads(HistoryMember::TrackedSetMemberIncarnations),
+            "cause-tracked filters are the only reader of member incarnations"
+        );
+    }
+
+    #[test]
+    fn mind_roots_discard_placement_history_cover_requires_growth() {
+        let state = GameState::new_two_player(42);
+        assert!(!history_covers(&state, &state));
+    }
+
+    #[test]
+    fn mind_roots_discard_placement_history_cover_accepts_unread_lki_for_gone_object() {
+        let prior = GameState::new_two_player(42);
+        let id = ObjectId(900);
+        let departed = crate::game::game_object::GameObject::new(
+            id,
+            crate::types::identifiers::CardId(900),
+            PlayerId(0),
+            "Departed".into(),
+            crate::types::zones::Zone::Battlefield,
+        );
+        let mut current = prior.clone();
+        current
+            .lki_cache
+            .insert(id, departed.snapshot_public_characteristics());
+
+        assert!(!prior.objects.contains_key(&id));
+        assert!(!current.objects.contains_key(&id));
+        assert!(last_known_records_grow_unread(&prior, &current));
+        assert!(
+            history_covers(&prior, &current),
+            "unread last-known records for gone objects do not prevent history coverage"
+        );
+    }
 }
