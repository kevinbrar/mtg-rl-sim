+
+#[test]
+fn mind_roots_does_not_follow_a_discard_replaced_into_a_hidden_zone() {
+    let mut scenario = scenario();
+    let spell = mind_roots(&mut scenario);
+    let land = scenario.add_land_to_hand(P1, "Forest").id();
+    let library = scenario
+        .add_artifact_from_oracle(P1, "Library of Leng", LIBRARY_OF_LENG_ORACLE)
+        .id();
+    let mut runner = scenario.build();
+    let mut cast = runner.cast(spell).target_player(P1).commit();
+    let mut chose_library_replacement = false;
+
+    for _ in 0..32 {
+        if cast.state().stack.is_empty()
+            && matches!(cast.state().waiting_for, WaitingFor::Priority { .. })
+        {
+            break;
+        }
+
+        match cast.state().waiting_for.clone() {
+            WaitingFor::Priority { .. } => {
+                cast.act(GameAction::PassPriority)
+                    .expect("passing priority must advance Mind Roots");
+            }
+            WaitingFor::ReplacementChoice {
+                player, candidates, ..
+            } => {
+                assert_eq!(player, P1);
+                let index = candidates
+                    .iter()
+                    .position(|candidate| candidate.description != "Decline")
+                    .expect("Library of Leng must offer its replacement");
+                cast.act(GameAction::ChooseReplacement { index })
+                    .expect("choosing Library of Leng must succeed");
+                chose_library_replacement = true;
+            }
+            choice @ WaitingFor::EffectZoneChoice { .. } => panic!(
+                "hidden-library member must not produce a Mind Roots placement choice: {choice:?}; land={:?}",
+                cast.state()
+                    .objects
+                    .get(&land)
+                    .map(|object| (object.zone, object.incarnation)),
+            ),
+            other => panic!("unexpected Mind Roots resolution state: {other:?}"),
+        }
+    }
+
+    assert!(chose_library_replacement);
+    assert!(
+        cast.state().stack.is_empty(),
+        "Mind Roots must finish resolving"
+    );
+    assert!(matches!(
+        cast.state().waiting_for,
+        WaitingFor::Priority { .. }
+    ));
+    assert_eq!(cast.state().objects[&land].zone, Zone::Library);
+    assert_eq!(cast.state().objects[&library].zone, Zone::Battlefield);
+    assert!(!cast.state().battlefield.contains(&land));
+}
