+    #[test]
+    fn mind_roots_discard_placement_tracks_only_current_public_objects() {
+        let mut state = crate::types::game_state::GameState::new_two_player(42);
+        let public = crate::game::zones::create_object(
+            &mut state,
+            crate::types::identifiers::CardId(1),
+            crate::types::player::PlayerId(0),
+            "Public discard".to_string(),
+            crate::types::zones::Zone::Graveyard,
+        );
+        let hidden = crate::game::zones::create_object(
+            &mut state,
+            crate::types::identifiers::CardId(2),
+            crate::types::player::PlayerId(0),
+            "Hidden discard".to_string(),
+            crate::types::zones::Zone::Library,
+        );
+        let stale = crate::game::zones::create_object(
+            &mut state,
+            crate::types::identifiers::CardId(3),
+            crate::types::player::PlayerId(0),
+            "New incarnation".to_string(),
+            crate::types::zones::Zone::Graveyard,
+        );
+        let set_id = crate::types::identifiers::TrackedSetId(7);
+        state
+            .tracked_object_sets
+            .insert(set_id, vec![public, hidden, stale]);
+        let mut causes = im::HashMap::new();
+        let mut incarnations = im::HashMap::new();
+        for id in [public, hidden, stale] {
+            causes.insert(id, crate::types::ability::ThisWayCause::Discarded);
+            incarnations.insert(id, state.objects[&id].incarnation);
+        }
+        state.tracked_set_member_causes.insert(set_id, causes);
+        state
+            .tracked_set_member_incarnations
+            .insert(set_id, incarnations);
+        state.objects.get_mut(&stale).unwrap().incarnation += 1;
+
+        let filter = crate::types::ability::TargetFilter::TrackedSetFiltered {
+            id: set_id,
+            filter: Box::new(crate::types::ability::TargetFilter::Any),
+            caused_by: Some(crate::types::ability::ThisWayCause::Discarded),
+        };
+        let ability = crate::types::ability::ResolvedAbility::new(
+            crate::types::ability::Effect::NoOp,
+            vec![],
+            crate::types::identifiers::ObjectId(999),
+            crate::types::player::PlayerId(0),
+        );
+
+        assert_eq!(
+            super::resolved_object_ids_for_filter(&state, &ability, &filter),
+            vec![public]
+        );
+    }
