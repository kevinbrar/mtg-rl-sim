+    #[test]
+    fn mind_roots_discard_placement_filter_rejects_hidden_and_stale_members() {
+        use crate::types::identifiers::TrackedSetId;
+        let mut state = setup();
+        let public = add_creature(&mut state, PlayerId(0), "Public Member");
+        let hidden = create_object(
+            &mut state,
+            CardId(2),
+            PlayerId(0),
+            "Hidden Member".to_string(),
+            Zone::Library,
+        );
+        let stale = add_creature(&mut state, PlayerId(0), "Stale Member");
+        let set = TrackedSetId(1);
+        let members = vec![public, hidden, stale];
+        state.tracked_object_sets.insert(set, members.clone());
+        state.tracked_set_member_causes.insert(
+            set,
+            members
+                .iter()
+                .map(|member| (*member, ThisWayCause::Discarded))
+                .collect(),
+        );
+        state.tracked_set_member_incarnations.insert(
+            set,
+            members
+                .iter()
+                .map(|member| (*member, state.objects[member].incarnation))
+                .collect(),
+        );
+        state.objects.get_mut(&stale).unwrap().incarnation += 1;
+        let filter = TargetFilter::TrackedSetFiltered {
+            id: set,
+            filter: Box::new(TargetFilter::Any),
+            caused_by: Some(ThisWayCause::Discarded),
+        };
+
+        assert!(matches_target_filter(
+            &state,
+            public,
+            &filter,
+            ObjectId(100)
+        ));
+        assert!(!matches_target_filter(
+            &state,
+            hidden,
+            &filter,
+            ObjectId(100)
+        ));
+        assert!(!matches_target_filter(
+            &state,
+            stale,
+            &filter,
+            ObjectId(100)
+        ));
+    }
+
