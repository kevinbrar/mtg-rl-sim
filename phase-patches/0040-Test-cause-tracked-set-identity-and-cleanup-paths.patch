diff --git a/crates/engine/src/analysis/resource.rs b/crates/engine/src/analysis/resource.rs
index 2bfe9c8a9..16324ecf2 100644
--- a/crates/engine/src/analysis/resource.rs
+++ b/crates/engine/src/analysis/resource.rs
@@ -30665,4 +30665,61 @@ mod tests {
             "unread last-known records for gone objects do not prevent history coverage"
         );
     }
+
+    #[test]
+    fn mind_roots_discard_placement_growth_compares_member_incarnations_at_the_window_floor() {
+        use crate::types::ability::{TargetFilter, ThisWayCause};
+        use crate::types::identifiers::TrackedSetId;
+
+        let mut prior = GameState::new_two_player(42);
+        let member = live_graveyard_object(&mut prior, "Member", 10);
+        let existing_set = TrackedSetId(1);
+        prior.tracked_object_sets.insert(existing_set, vec![member]);
+        prior.tracked_set_member_causes.insert(
+            existing_set,
+            [(member, ThisWayCause::Exiled)].into_iter().collect(),
+        );
+        prior
+            .tracked_set_member_incarnations
+            .insert(existing_set, [(member, 9)].into_iter().collect());
+        prior.next_tracked_set_id = 2;
+        prior
+            .delayed_triggers
+            .push(delayed_on(TargetFilter::TrackedSetFiltered {
+                id: existing_set,
+                filter: Box::new(TargetFilter::Any),
+                caused_by: Some(ThisWayCause::Exiled),
+            }));
+        assert!(
+            live_history_reads(&prior).reads(HistoryMember::TrackedSetMemberIncarnations),
+            "the delayed cause-filtered reader keeps member-incarnation state material"
+        );
+
+        let mut changed_existing_member = prior.clone();
+        changed_existing_member
+            .tracked_set_member_incarnations
+            .get_mut(&existing_set)
+            .unwrap()
+            .insert(member, 10);
+        assert!(
+            !eq_except_growable(&prior, &changed_existing_member, &HashSet::new()),
+            "a change to a set below the growth window remains material"
+        );
+
+        let mut grown = prior.clone();
+        let new_set = TrackedSetId(2);
+        grown.tracked_object_sets.insert(new_set, vec![member]);
+        grown.tracked_set_member_causes.insert(
+            new_set,
+            [(member, ThisWayCause::Exiled)].into_iter().collect(),
+        );
+        grown
+            .tracked_set_member_incarnations
+            .insert(new_set, [(member, 10)].into_iter().collect());
+        grown.next_tracked_set_id = 3;
+        assert!(
+            eq_except_growable(&prior, &grown, &HashSet::new()),
+            "a set allocated at the window floor is growth and is stripped before comparison"
+        );
+    }
 }
