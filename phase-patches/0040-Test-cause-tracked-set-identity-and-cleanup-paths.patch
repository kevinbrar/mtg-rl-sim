@@ -11365,6 +11365,70 @@ mod tests {
         let (mut state, ability) = with_gear(attached_to_it);
         assert_eq!(live_entry_counters(&mut state, &ability), vec![0, 0]);
     }
+
+    #[test]
+    fn mind_roots_discard_placement_token_consumes_member_incarnation_snapshots() {
+        use crate::types::ability::{QuantityRef, ThisWayCause, TokenAttackDestination};
+        use crate::types::identifiers::TrackedSetId;
+
+        let mut state = GameState::new_two_player(42);
+        let source = create_object(
+            &mut state,
+            CardId(1),
+            PlayerId(0),
+            "Token Maker".to_string(),
+            Zone::Battlefield,
+        );
+        let member = create_object(
+            &mut state,
+            CardId(2),
+            PlayerId(0),
+            "Exiled Member".to_string(),
+            Zone::Exile,
+        );
+        let set = TrackedSetId(1);
+        state.tracked_object_sets.insert(set, vec![member]);
+        state
+            .tracked_set_member_causes
+            .insert(set, [(member, ThisWayCause::Exiled)].into_iter().collect());
+        state.tracked_set_member_incarnations.insert(
+            set,
+            [(member, state.objects[&member].incarnation)]
+                .into_iter()
+                .collect(),
+        );
+        state.next_tracked_set_id = 2;
+        let ability = ResolvedAbility::new(
+            Effect::Token {
+                name: "Goblin".to_string(),
+                power: PtValue::Fixed(1),
+                toughness: PtValue::Fixed(1),
+                types: vec!["Creature".to_string(), "Goblin".to_string()],
+                colors: vec![ManaColor::Red],
+                keywords: vec![],
+                tapped: false,
+                count: QuantityExpr::Ref {
+                    qty: QuantityRef::TrackedSetSize,
+                },
+                owner: TargetFilter::Controller,
+                attach_to: None,
+                enters_attacking: false,
+                attack_destination: TokenAttackDestination::ControllerChooses,
+                supertypes: vec![],
+                static_abilities: vec![],
+                enter_with_counters: vec![],
+            },
+            vec![],
+            source,
+            PlayerId(0),
+        );
+        let mut events = Vec::new();
+        resolve_with_host_override(&mut state, &ability, &mut events, None).unwrap();
+
+        assert_eq!(state.last_created_token_ids.len(), 1);
+        assert!(!state.tracked_object_sets.contains_key(&set));
+        assert!(!state.tracked_set_member_incarnations.contains_key(&set));
+    }
 }
 
