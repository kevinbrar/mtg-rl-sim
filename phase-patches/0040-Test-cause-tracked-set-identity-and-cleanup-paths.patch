+    #[test]
+    fn mind_roots_discard_placement_game_state_equality_compares_member_incarnations() {
+        use crate::types::ability::ThisWayCause;
+        use crate::types::identifiers::TrackedSetId;
+
+        let mut prior = GameState::new_two_player(42);
+        let member = crate::game::zones::create_object(
+            &mut prior,
+            CardId(1),
+            PlayerId(0),
+            "Member".to_string(),
+            Zone::Graveyard,
+        );
+        let set = TrackedSetId(1);
+        prior.tracked_object_sets.insert(set, vec![member]);
+        prior.tracked_set_member_causes.insert(
+            set,
+            [(member, ThisWayCause::Discarded)].into_iter().collect(),
+        );
+        prior.next_tracked_set_id = 2;
+        let mut current = prior.clone();
+        current.tracked_set_member_incarnations.insert(
+            set,
+            [(member, current.objects[&member].incarnation)]
+                .into_iter()
+                .collect(),
+        );
+
+        assert_ne!(
+            prior, current,
+            "otherwise identical states differ when a cause-tracked member identity is recorded"
+        );
+    }
+
+    #[test]
+    fn mind_roots_discard_placement_loop_normalization_ranks_member_incarnations() {
+        use crate::types::ability::{
+            Effect, QuantityExpr, ResolvedAbility, TargetFilter, ThisWayCause,
+        };
+        use crate::types::identifiers::TrackedSetId;
+
+        fn state_with_incarnation(
+            current_incarnation: u64,
+            snapshot_incarnation: u64,
+        ) -> GameState {
+            let mut state = GameState::new_two_player(7);
+            let member = crate::game::zones::create_object(
+                &mut state,
+                CardId(1),
+                PlayerId(0),
+                "Member".to_string(),
+                Zone::Graveyard,
+            );
+            state.objects.get_mut(&member).unwrap().incarnation = current_incarnation;
+            let set = TrackedSetId(1);
+            state.tracked_object_sets.insert(set, vec![member]);
+            state.tracked_set_member_causes.insert(
+                set,
+                [(member, ThisWayCause::Discarded)].into_iter().collect(),
+            );
+            state
+                .tracked_set_member_incarnations
+                .insert(set, [(member, snapshot_incarnation)].into_iter().collect());
+            state.next_tracked_set_id = 2;
+
+            let ability = ResolvedAbility::new(
+                Effect::Draw {
+                    count: QuantityExpr::Fixed { value: 1 },
+                    target: TargetFilter::TrackedSetFiltered {
+                        id: set,
+                        filter: Box::new(TargetFilter::Any),
+                        caused_by: Some(ThisWayCause::Discarded),
+                    },
+                },
+                vec![],
+                ObjectId(5),
+                PlayerId(0),
+            );
+            state.stack.push_back(StackEntry {
+                id: ObjectId(20),
+                source_id: ObjectId(5),
+                controller: PlayerId(0),
+                kind: StackEntryKind::TriggeredAbility {
+                    source_id: ObjectId(5),
+                    ability: Box::new(ability),
+                    condition: None,
+                    trigger_event: None,
+                    description: None,
+                    source_name: String::new(),
+                    subject_match_count: None,
+                    die_result: None,
+                    provenance: None,
+                },
+            });
+            state
+        }
+
+        let prior = state_with_incarnation(10, 9);
+        let current = state_with_incarnation(100, 99);
+        assert!(crate::analysis::resource::live_history_reads(&prior)
+            .reads(crate::analysis::resource::HistoryMember::TrackedSetMemberIncarnations));
+        assert_ne!(prior, current);
+        assert_eq!(
+            prior.normalize_for_loop(),
+            current.normalize_for_loop(),
+            "monotone incarnation numbers are canonicalized by their relative identity"
+        );
+    }
+
     /// CR 104.4b: a replacement-paused counted cost move keeps its earlier
     /// action fragments' events in `PendingCostMoveResume::Cast`. Those events
     /// can name an LKI incarnation, so the loop-state normalization must visit
