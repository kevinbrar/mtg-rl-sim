 3 files changed, 55 insertions(+), 15 deletions(-)

diff --git a/crates/engine/tests/integration/extrapolate_the_impossible.rs b/crates/engine/tests/integration/extrapolate_the_impossible.rs
index 656d2e11b..3ac73bbec 100644
--- a/crates/engine/tests/integration/extrapolate_the_impossible.rs
+++ b/crates/engine/tests/integration/extrapolate_the_impossible.rs
@@ -41,16 +41,18 @@ fn setup(sideboard: Vec<DeckEntry>) -> (GameRunner, engine::types::identifiers::
 }
 
 fn resolve_extrapolate(runner: &mut GameRunner, spell: engine::types::identifiers::ObjectId) {
-    runner.cast(spell).resolve();
+    runner.cast(spell).commit().stop_at_optional().resolve();
+    assert!(
+        matches!(
+            runner.state().waiting_for,
+            WaitingFor::OptionalEffectChoice { .. }
+        ),
+        "the spell's You may must be offered before revealing"
+    );
+    runner
+        .act(GameAction::DecideOptionalEffect { accept: true })
+        .expect("accept the optional reveal");
     runner.advance_until_stack_empty();
-    if matches!(
-        runner.state().waiting_for,
-        WaitingFor::OptionalEffectChoice { .. }
-    ) {
-        runner
-            .act(GameAction::DecideOptionalEffect { accept: true })
-            .expect("accept the optional reveal");
-    }
 }
 
 #[test]
