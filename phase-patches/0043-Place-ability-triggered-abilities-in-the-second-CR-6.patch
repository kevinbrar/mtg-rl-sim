@@ -4630,6 +4630,30 @@ fn apnap_rank(order: &[PlayerId], controller: PlayerId) -> usize {
         .unwrap_or(order.len())
 }
 
+/// CR 603.3b: the part of the two-part stack-placement process a triggered
+/// ability belongs to. Abilities whose trigger condition isn't another ability
+/// triggering are placed first; all remaining abilities are placed second, so
+/// they sit above every first-part ability regardless of controller.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+enum StackPlacementPart {
+    First,
+    Remaining,
+}
+
+/// CR 603.3b: classify a pending trigger by whether its trigger condition is
+/// another ability triggering.
+fn stack_placement_part(ctx: &PendingTriggerContext) -> StackPlacementPart {
+    let trigger_event = ctx
+        .pending
+        .trigger_event
+        .as_ref()
+        .or_else(|| ctx.trigger_events.first());
+    match trigger_event {
+        Some(GameEvent::AbilityTriggered { .. }) => StackPlacementPart::Remaining,
+        _ => StackPlacementPart::First,
+    }
+}
+
 fn trigger_apnap_rank(state: &GameState, controller: PlayerId) -> usize {
     if state.format_config.topology().has_shared_team_turns() {
         super::topology::apnap_team_rank(state, controller)
@@ -7497,6 +7521,7 @@ fn collect_pending_triggers_with_collection(
     // preserving the real trigger controller on each pending trigger.
     pending.sort_by_key(|t| {
         (
+            stack_placement_part(t),
             trigger_apnap_rank(state, t.pending.controller),
             t.pending.timestamp,
         )
@@ -8722,6 +8747,7 @@ fn normalize_deferred_trigger_order(state: &GameState, pending: &mut [PendingTri
             Some(ctx.pending.timestamp)
         };
         (
+            stack_placement_part(ctx),
             trigger_apnap_rank(state, ctx.pending.controller),
             collection_order,
         )
@@ -8879,9 +8905,13 @@ fn begin_trigger_ordering(
     // trigger. Deliberately not updated by a triggered-mana context: an echo
     // group is invisible to CR 603.3b grouping, while an ordinary group of a
     // different controller still ends the previous controller's APNAP run.
-    let mut last_ordinary_group: Option<(PlayerId, usize)> = None;
+    //
+    // CR 603.3b: a controller orders the abilities of each placement part
+    // separately, so a part boundary also ends the run.
+    let mut last_ordinary_group: Option<(PlayerId, StackPlacementPart, usize)> = None;
     for ctx in pending {
         let controller = trigger_order_controller(state, ctx.pending.controller);
+        let part = stack_placement_part(&ctx);
         let trigger_event = ctx
             .pending
             .trigger_event
@@ -8890,8 +8920,8 @@ fn begin_trigger_ordering(
         let is_triggered_mana =
             super::mana_abilities::is_triggered_mana_ability(&ctx.pending.ability, trigger_event);
         if !is_triggered_mana {
-            if let Some((group_controller, index)) = last_ordinary_group {
-                if group_controller == controller {
+            if let Some((group_controller, group_part, index)) = last_ordinary_group {
+                if group_controller == controller && group_part == part {
                     groups[index].triggers.push(ctx);
                     continue;
                 }
@@ -8903,7 +8933,7 @@ fn begin_trigger_ordering(
             ordered: is_triggered_mana,
         });
         if !is_triggered_mana {
-            last_ordinary_group = Some((controller, groups.len() - 1));
+            last_ordinary_group = Some((controller, part, groups.len() - 1));
         }
     }
 
@@ -16175,6 +16205,7 @@ fn collect_pending_and_delayed_triggers_reporting_terminalized(
     contexts.extend(delayed_pending);
     contexts.sort_by_key(|ctx| {
         (
+            stack_placement_part(ctx),
             trigger_apnap_rank(state, ctx.pending.controller),
             ctx.pending.timestamp,
         )
