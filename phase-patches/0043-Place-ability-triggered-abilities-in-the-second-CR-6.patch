+/// CR 603.3b: the part of the two-part stack-placement process a triggered
+/// ability belongs to. Abilities whose trigger condition isn't another ability
+/// triggering are placed first; all remaining abilities are placed second, so
+/// they sit above every first-part ability regardless of controller.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+enum StackPlacementPart {
+    First,
+    Remaining,
+}
+
+/// CR 603.3b: classify a pending trigger by whether its trigger condition is
+/// another ability triggering.
+fn stack_placement_part(ctx: &PendingTriggerContext) -> StackPlacementPart {
+    let trigger_event = ctx
+        .pending
+        .trigger_event
+        .as_ref()
+        .or_else(|| ctx.trigger_events.first());
+    match trigger_event {
+        Some(GameEvent::AbilityTriggered { .. }) => StackPlacementPart::Remaining,
+        _ => StackPlacementPart::First,
+    }
+}
+
 fn trigger_apnap_rank(state: &GameState, controller: PlayerId) -> usize {
     if state.format_config.topology().has_shared_team_turns() {
