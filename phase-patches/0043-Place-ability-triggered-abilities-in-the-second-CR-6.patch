+    /// CR 603.3b: a controller chooses one order per placement part, so the
+    /// parked remainders of both parts keep their chosen orders, and abilities
+    /// triggered by another ability triggering stay after every other trigger.
+    #[test]
+    fn deferred_drain_keeps_chosen_order_remainders_of_both_placement_parts() {
+        let context = |source: u64, timestamp: u32, ability_triggered: bool| {
+            let controller = PlayerId(0);
+            let trigger_event = ability_triggered.then(|| GameEvent::AbilityTriggered {
+                trigger_instance: ObjectId(100 + source),
+                source: ObjectId(50),
+                controller,
+                cause: Box::new(GameEvent::AttackersDeclared {
+                    attacker_ids: vec![ObjectId(50)],
+                    defending_player: PlayerId(1),
+                    attacks: Vec::new(),
+                    declaration_records: Vec::new(),
+                }),
+            });
+            PendingTriggerContext::single(PendingTrigger {
+                source_id: ObjectId(source),
+                controller,
+                condition: None,
+                ability: Box::new(ResolvedAbility::new(
+                    Effect::Draw {
+                        count: QuantityExpr::Fixed { value: 1 },
+                        target: TargetFilter::Controller,
+                    },
+                    Vec::new(),
+                    ObjectId(source),
+                    controller,
+                )),
+                timestamp,
+                target_constraints: Vec::new(),
+                distribute: None,
+                trigger_event,
+                modal: None,
+                mode_abilities: Vec::new(),
+                description: None,
+                may_trigger_origin: None,
+                subject_match_count: None,
+                die_result: None,
+                provenance: None,
+            })
+        };
+        let sources = |pending: &[PendingTriggerContext]| -> Vec<u64> {
+            pending.iter().map(|ctx| ctx.pending.source_id.0).collect()
+        };
+        let mut state = setup();
+        state.active_player = PlayerId(0);
+        // Both chosen orders deliberately disagree with timestamp order.
+        let first = [
+            context(1, 5, false),
+            context(2, 9, false),
+            context(3, 1, false),
+        ];
+        let second = [context(4, 8, true), context(5, 2, true)];
+        let unmarked = state.clone();
+        state.set_trigger_order_template(build_ephemeral_order_template(PlayerId(0), &first));
+        state.set_trigger_order_template(build_ephemeral_order_template(PlayerId(0), &second));
+
+        let queue = || {
+            vec![
+                second[0].clone(),
+                first[1].clone(),
+                second[1].clone(),
+                first[2].clone(),
+            ]
+        };
+        let mut remainder = queue();
+        normalize_deferred_trigger_order(&state, &mut remainder);
+        assert_eq!(sources(&remainder), vec![2, 3, 4, 5]);
+
+        // Without chosen orders each part is normalized to timestamp order.
+        let mut fresh = queue();
+        normalize_deferred_trigger_order(&unmarked, &mut fresh);
+        assert_eq!(sources(&fresh), vec![3, 2, 5, 4]);
+
+        // A part whose queue is not a chosen remainder is normalized on its own.
+        let mut mixed = vec![
+            first[0].clone(),
+            first[2].clone(),
+            second[0].clone(),
+            second[1].clone(),
+        ];
+        normalize_deferred_trigger_order(&state, &mut mixed);
+        assert_eq!(sources(&mixed), vec![3, 1, 4, 5]);
+    }
 }
 
