+#[test]
+fn shadow_kin_milled_card_exile_remains_unimplemented() {
+    fn collect<'a>(
+        def: &'a crate::types::ability::AbilityDefinition,
+        out: &mut Vec<&'a crate::types::ability::AbilityDefinition>,
+    ) {
+        out.push(def);
+        if let Some(sub) = def.sub_ability.as_deref() {
+            collect(sub, out);
+        }
+    }
+
+    let parsed = crate::parser::oracle::parse_oracle_text(
+        "Flash\nAt the beginning of your upkeep, each player mills three cards. You may exile a \
+         creature card from among the cards milled this way. If you do, this creature becomes a \
+         copy of that card, except it has this ability.",
+        "Shadow Kin",
+        &[],
+        &["Creature".to_string()],
+        &["Shapeshifter".to_string()],
+    );
+    assert!(
+        parsed.parse_warnings.is_empty(),
+        "the existing partial lowering must not swallow clauses: {:?}",
+        parsed.parse_warnings
+    );
+
+    let execute = parsed.triggers[0]
+        .execute
+        .as_deref()
+        .expect("Shadow Kin's upkeep trigger must have an effect");
+    let mut chain = Vec::new();
+    collect(execute, &mut chain);
+    assert_eq!(chain.len(), 3, "unexpected trigger chain: {chain:#?}");
+    assert!(matches!(&*chain[0].effect, Effect::Mill { .. }));
+    assert!(
+        matches!(
+            &*chain[1].effect,
+            Effect::Unimplemented { name, description }
+                if name == "unparsed_verb_arguments"
+                    && description.as_deref()
+                        == Some("exile a creature card from among the cards milled this way")
+        ),
+        "the milled-card clause should remain at its prior unsupported lowering: {:#?}",
+        chain[1].effect
+    );
+    assert!(chain[1].optional, "preserve the printed may");
+    assert!(matches!(&*chain[2].effect, Effect::BecomeCopy { .. }));
+    assert!(
+        !chain.iter().any(|def| matches!(
+            &*def.effect,
+            Effect::ChangeZone {
+                destination: Zone::Hand | Zone::Exile,
+                ..
+            }
+        )),
+        "the unsupported clause must not move milled cards: {chain:#?}"
+    );
+}
