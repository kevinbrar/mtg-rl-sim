+#[test]
+fn parse_optional_exile_from_dig_routes_random_library_remainder() {
+    let def = parse_effect_chain(
+        "Look at the top five cards of your library. You may exile a creature card from among them. Put the rest on the bottom of your library in a random order.",
+        AbilityKind::Spell,
+    );
+    let Effect::Dig {
+        count,
+        keep_count,
+        up_to,
+        destination,
+        rest_destination,
+        rest_order,
+        ..
+    } = def.effect.as_ref()
+    else {
+        panic!("expected a Dig effect, got {:?}", def.effect);
+    };
+    assert_eq!(*count, QuantityExpr::Fixed { value: 5 });
+    assert_eq!(*keep_count, Some(1));
+    assert!(*up_to);
+    assert_eq!(*destination, Some(Zone::Exile));
+    assert_eq!(*rest_destination, Some(Zone::Library));
+    assert_eq!(*rest_order, DigRestOrder::Random);
+    assert!(
+        def.sub_ability.is_none(),
+        "the exile selection and random remainder belong to the Dig effect"
+    );
+}
