diff --git a/crates/engine/tests/integration/dig_family_optional_exile.rs b/crates/engine/tests/integration/dig_family_optional_exile.rs
new file mode 100644
index 000000000..d3379f4bb
--- /dev/null
+++ b/crates/engine/tests/integration/dig_family_optional_exile.rs
@@ -0,0 +1,310 @@
+//! Regression coverage for optional exile picks from looked-at cards.
+
+use engine::game::scenario::{GameScenario, P0};
+use engine::types::actions::GameAction;
+use engine::types::game_state::WaitingFor;
+use engine::types::identifiers::ObjectId;
+use engine::types::keywords::Keyword;
+use engine::types::mana::{ManaCost, ManaCostShard, ManaType, ManaUnit};
+use engine::types::phase::Phase;
+use engine::types::zones::Zone;
+
+use super::rules::run_combat;
+
+const FERAL_ORACLE: &str = "Look at the top five cards of your library. You may exile a creature \
+card from among them. Put the rest on the bottom of your library in a random order. You may cast \
+the exiled card this turn.";
+
+const MAKE_YOUR_OWN_LUCK_ORACLE: &str = "Look at the top three cards of your library. You may \
+exile a nonland card from among them. If you do, it becomes plotted. Put the rest into your hand. \
+(You may cast it as a sorcery on a later turn without paying its mana cost.)";
+
+const KEY_ORACLE: &str = "Whenever equipped creature deals combat damage to a player, look at that \
+many cards from the top of your library. You may exile a nonland card from among them. Put the rest \
+on the bottom of your library in a random order. You may cast the exiled card without paying its \
+mana cost. Equip {3}{U}";
+
+const DURNAN_ORACLE: &str = "Whenever Durnan attacks, look at the top four cards of your library. \
+You may exile a creature card from among them. Put the rest on the bottom of your library in any \
+order. For as long as that card remains exiled, you may cast it. That spell has undaunted. (It costs \
+{1} less to cast for each opponent.)";
+
+#[test]
+fn feral_encounter_offers_only_creatures_and_randomly_bottoms_the_rest() {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let spell = scenario
+        .add_spell_to_hand_from_oracle(P0, "Feral Encounter", false, FERAL_ORACLE)
+        .id();
+    let creature = scenario
+        .add_spell_to_library_top(P0, "Grizzly Bears", false)
+        .as_creature()
+        .id();
+    let other = [
+        scenario.add_spell_to_library_top(P0, "Opt", true).id(),
+        scenario
+            .add_spell_to_library_top(P0, "Divination", false)
+            .id(),
+        scenario
+            .add_spell_to_library_top(P0, "Anticipate", true)
+            .id(),
+        scenario.add_spell_to_library_top(P0, "Consider", true).id(),
+    ];
+    let mut runner = scenario.build();
+
+    let outcome = runner.cast(spell).resolve();
+    match outcome.final_waiting_for() {
+        WaitingFor::DigChoice {
+            selectable_cards,
+            keep_count,
+            up_to,
+            kept_destination,
+            rest_destination,
+            rest_order,
+            ..
+        } => {
+            assert_eq!(selectable_cards, &[creature]);
+            assert_eq!(*keep_count, 1);
+            assert!(*up_to);
+            assert_eq!(*kept_destination, Some(Zone::Exile));
+            assert_eq!(*rest_destination, Some(Zone::Library));
+            assert_eq!(*rest_order, engine::types::ability::DigRestOrder::Random);
+        }
+        other => panic!("expected a filtered DigChoice, got {other:?}"),
+    }
+
+    runner
+        .act(GameAction::SelectCards {
+            cards: vec![creature],
+        })
+        .expect("selecting the offered creature must succeed");
+    runner.advance_until_stack_empty();
+
+    let state = runner.state();
+    assert_eq!(state.objects[&creature].zone, Zone::Exile);
+    assert!(other
+        .iter()
+        .all(|id| state.objects[id].zone == Zone::Library));
+    assert!(
+        matches!(state.waiting_for, WaitingFor::Priority { player } if player == P0),
+        "random order must not prompt"
+    );
+}
+
+#[test]
+fn make_your_own_luck_decline_puts_every_revealed_card_into_hand() {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let spell = scenario
+        .add_spell_to_hand_from_oracle(P0, "Make Your Own Luck", false, MAKE_YOUR_OWN_LUCK_ORACLE)
+        .id();
+    let cards = [
+        scenario.add_spell_to_library_top(P0, "Opt", true).id(),
+        scenario
+            .add_spell_to_library_top(P0, "Divination", false)
+            .id(),
+        scenario
+            .add_spell_to_library_top(P0, "Anticipate", true)
+            .id(),
+    ];
+    let mut runner = scenario.build();
+
+    let outcome = runner.cast(spell).resolve();
+    assert!(
+        matches!(outcome.final_waiting_for(), WaitingFor::DigChoice { .. }),
+        "optional exile must be represented by the card-choice group"
+    );
+    runner
+        .act(GameAction::SelectCards { cards: vec![] })
+        .expect("an empty DigChoice selection declines the optional exile");
+    runner.advance_until_stack_empty();
+
+    let state = runner.state();
+    assert!(cards.iter().all(|id| state.objects[id].zone == Zone::Hand));
+    assert!(state.players[0].library.is_empty());
+    assert!(matches!(
+        state.waiting_for,
+        WaitingFor::Priority { player } if player == P0
+    ));
+}
+
+#[test]
+fn key_optional_exile_uses_dig_choice_before_the_cast_decision() {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let attacker = scenario.add_creature(P0, "Vault Bearer", 3, 3).id();
+    let key = scenario
+        .add_creature(P0, "The Key to the Vault", 0, 0)
+        .as_artifact()
+        .with_subtypes(vec!["Equipment"])
+        .from_oracle_text(KEY_ORACLE)
+        .id();
+    let picked = scenario.add_spell_to_library_top(P0, "Opt", true).id();
+    let rest_a = scenario
+        .add_spell_to_library_top(P0, "Divination", false)
+        .id();
+    let rest_b = scenario.add_land_to_library_top(P0, "Island").id();
+    let mut runner = scenario.build();
+    engine::game::effects::attach::attach_to(runner.state_mut(), key, attacker);
+    engine::game::layers::evaluate_layers(runner.state_mut());
+
+    run_combat(&mut runner, vec![attacker], vec![]);
+    runner.advance_until_stack_empty();
+    assert!(
+        matches!(runner.state().waiting_for, WaitingFor::DigChoice { .. }),
+        "Key's optional exile must use DigChoice, not a separate yes/no prompt"
+    );
+    runner
+        .act(GameAction::SelectCards {
+            cards: vec![picked],
+        })
+        .expect("selecting the offered nonland card must succeed");
+    runner.advance_until_stack_empty();
+
+    let state = runner.state();
+    assert_eq!(state.objects[&picked].zone, Zone::Exile);
+    assert_eq!(state.objects[&rest_a].zone, Zone::Library);
+    assert_eq!(state.objects[&rest_b].zone, Zone::Library);
+    assert!(
+        matches!(state.waiting_for, WaitingFor::OptionalEffectChoice { .. }),
+        "the next optional prompt should be the separate cast decision"
+    );
+}
+
+#[test]
+fn key_declining_optional_exile_does_not_offer_a_cast_decision() {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let attacker = scenario.add_creature(P0, "Vault Bearer", 3, 3).id();
+    let key = scenario
+        .add_creature(P0, "The Key to the Vault", 0, 0)
+        .as_artifact()
+        .with_subtypes(vec!["Equipment"])
+        .from_oracle_text(KEY_ORACLE)
+        .id();
+    let cards = [
+        scenario.add_spell_to_library_top(P0, "Opt", true).id(),
+        scenario
+            .add_spell_to_library_top(P0, "Divination", false)
+            .id(),
+        scenario.add_land_to_library_top(P0, "Island").id(),
+    ];
+    let mut runner = scenario.build();
+    engine::game::effects::attach::attach_to(runner.state_mut(), key, attacker);
+    engine::game::layers::evaluate_layers(runner.state_mut());
+
+    run_combat(&mut runner, vec![attacker], vec![]);
+    runner.advance_until_stack_empty();
+    assert!(matches!(
+        runner.state().waiting_for,
+        WaitingFor::DigChoice { .. }
+    ));
+    runner
+        .act(GameAction::SelectCards { cards: vec![] })
+        .expect("an empty selection declines the optional exile");
+    runner.advance_until_stack_empty();
+
+    let state = runner.state();
+    assert!(cards
+        .iter()
+        .all(|id| state.objects[id].zone == Zone::Library));
+    let optional_frame = state.active_optional_effect_frame().map(|frame| {
+        (
+            &frame.ability.effect,
+            frame.ability.parent_target_missing_reason,
+        )
+    });
+    assert!(
+        matches!(
+            state.waiting_for,
+            WaitingFor::Priority { player } if player == P0
+        ),
+        "expected priority after declining Key's exile choice, got {:?} with frame {:?}",
+        state.waiting_for,
+        optional_frame
+    );
+}
+
+#[test]
+fn durnan_exiled_creature_has_cast_permission_but_undaunted_applies_to_durnan() {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let durnan = scenario
+        .add_creature(P0, "Durnan of the Yawning Portal", 3, 3)
+        .from_oracle_text(DURNAN_ORACLE)
+        .id();
+    let exiled_creature = scenario
+        .add_spell_to_library_top(P0, "Grizzly Bears", false)
+        .as_creature()
+        .with_mana_cost(ManaCost::Cost {
+            shards: vec![ManaCostShard::Green],
+            generic: 1,
+        })
+        .id();
+    let mut runner = scenario.build();
+
+    run_combat(&mut runner, vec![durnan], vec![]);
+    runner.advance_until_stack_empty();
+    assert!(matches!(
+        runner.state().waiting_for,
+        WaitingFor::DigChoice { .. }
+    ));
+    runner
+        .act(GameAction::SelectCards {
+            cards: vec![exiled_creature],
+        })
+        .expect("selecting Durnan's creature card must succeed");
+    if let WaitingFor::DigBottomOrder { cards, .. } = runner.state().waiting_for.clone() {
+        runner
+            .act(GameAction::SelectCards { cards })
+            .expect("ordering Durnan's remaining cards must succeed");
+    }
+    runner.advance_until_stack_empty();
+    assert_eq!(runner.state().objects[&exiled_creature].zone, Zone::Exile);
+
+    if matches!(runner.state().waiting_for, WaitingFor::Priority { .. }) {
+        runner.pass_both_players();
+    }
+    if matches!(
+        runner.state().waiting_for,
+        WaitingFor::DeclareBlockers { .. }
+    ) {
+        runner
+            .act(GameAction::DeclareBlockers {
+                assignments: vec![],
+            })
+            .expect("the opponent has no blockers");
+    }
+    if matches!(runner.state().waiting_for, WaitingFor::Priority { .. }) {
+        runner.pass_both_players();
+    }
+    runner.advance_to_phase(Phase::PostCombatMain);
+    assert_eq!(runner.state().phase, Phase::PostCombatMain);
+    runner.state_mut().add_mana_to_pool(
+        P0,
+        ManaUnit::new(ManaType::Green, ObjectId(0), false, vec![]),
+    );
+    let underfunded = runner.cast(exiled_creature).try_resolve();
+    assert!(
+        underfunded.is_err(),
+        "Durnan's parsed Undaunted grant currently does not reduce the spell's generic cost"
+    );
+    runner.state_mut().add_mana_to_pool(
+        P0,
+        ManaUnit::new(ManaType::Green, ObjectId(0), false, vec![]),
+    );
+    runner
+        .cast(exiled_creature)
+        .try_resolve()
+        .expect("the exile permission must allow casting the creature for its full cost");
+    assert_eq!(
+        runner.state().objects[&exiled_creature].zone,
+        Zone::Battlefield
+    );
+    assert!(
+        runner.state().objects[&durnan]
+            .keywords
+            .contains(&Keyword::Undaunted),
+        "the current parser applies Durnan's Undaunted grant to Durnan"
+    );
+}
