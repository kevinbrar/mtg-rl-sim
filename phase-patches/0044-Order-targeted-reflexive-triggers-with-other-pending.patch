@@ -0,0 +1,157 @@
+//! Inti, Seneschal of the Sun: the reflexive "when you do" ability and the
+//! "whenever you discard" ability trigger during the same resolution, so their
+//! controller orders them (CR 603.3b, CR 603.12).
+
+use engine::game::combat::AttackTarget;
+use engine::game::scenario::{GameRunner, GameScenario, P0, P1};
+use engine::types::ability::TargetRef;
+use engine::types::actions::GameAction;
+use engine::types::counter::CounterType;
+use engine::types::game_state::WaitingFor;
+use engine::types::identifiers::ObjectId;
+use engine::types::phase::Phase;
+use engine::types::zones::Zone;
+
+const INTI_ORACLE: &str = "Whenever you attack, you may discard a card. When you do, put a +1/+1 counter on target attacking creature. It gains trample until end of turn.\n\
+Whenever you discard one or more cards, exile the top card of your library. You may play that card until your next end step.";
+
+const DISCARD_ABILITY: &str = "Whenever you discard one or more cards, exile the top card of your library. You may play that card until your next end step.";
+
+struct Board {
+    runner: GameRunner,
+    inti: ObjectId,
+    other: ObjectId,
+    top_card: ObjectId,
+}
+
+/// Inti and a second creature attack, the attack trigger resolves and the
+/// optional discard is accepted.
+fn attack_and_discard() -> Board {
+    let mut scenario = GameScenario::new();
+    scenario.at_phase(Phase::PreCombatMain);
+    let inti = scenario
+        .add_creature_from_oracle(P0, "Inti, Seneschal of the Sun", 2, 2, INTI_ORACLE)
+        .id();
+    let other = scenario.add_creature(P0, "Attacker", 2, 2).id();
+    scenario.add_card_to_hand(P0, "Fodder");
+    let top_card = scenario.add_card_to_library_top(P0, "Top Card");
+    let mut runner = scenario.build();
+    runner.advance_to_combat();
+    runner
+        .declare_attackers(&[
+            (inti, AttackTarget::Player(P1)),
+            (other, AttackTarget::Player(P1)),
+        ])
+        .expect("attacker declaration succeeds");
+    runner.pass_both_players();
+    runner
+        .act(GameAction::DecideOptionalEffect { accept: true })
+        .expect("accepting the discard succeeds");
+    Board {
+        runner,
+        inti,
+        other,
+        top_card,
+    }
+}
+
+/// Index of the discard ability in the order prompt; the other entry is the
+/// reflexive ability.
+fn discard_index(runner: &GameRunner) -> usize {
+    let WaitingFor::OrderTriggers { player, triggers } = runner.state().waiting_for.clone() else {
+        panic!(
+            "the reflexive and discard abilities must be ordered; got {:?}",
+            runner.state().waiting_for
+        );
+    };
+    assert_eq!(player, P0);
+    assert_eq!(triggers.len(), 2);
+    assert!(runner.state().stack.is_empty());
+    let index = triggers
+        .iter()
+        .position(|trigger| trigger.description == DISCARD_ABILITY)
+        .expect("the discard ability is in the prompt");
+    assert_ne!(triggers[1 - index].description, DISCARD_ABILITY);
+    index
+}
+
+fn counters(runner: &GameRunner, id: ObjectId) -> u32 {
+    runner.state().objects[&id]
+        .counters
+        .get(&CounterType::Plus1Plus1)
+        .copied()
+        .unwrap_or(0)
+}
+
+fn zone(runner: &GameRunner, id: ObjectId) -> Zone {
+    runner.state().objects[&id].zone
+}
+
+fn choose_target(runner: &mut GameRunner, target: ObjectId) {
+    assert!(
+        matches!(
+            runner.state().waiting_for,
+            WaitingFor::TriggerTargetSelection { .. }
+        ),
+        "the reflexive ability chooses its target as it is put on the stack; got {:?}",
+        runner.state().waiting_for
+    );
+    runner
+        .act(GameAction::ChooseTarget {
+            target: Some(TargetRef::Object(target)),
+        })
+        .expect("target choice succeeds");
+}
+
+#[test]
+fn reflexive_ability_can_be_placed_above_the_discard_ability() {
+    let Board {
+        mut runner,
+        inti,
+        other,
+        top_card,
+    } = attack_and_discard();
+    let discard = discard_index(&runner);
+    // First placed resolves last (CR 405.3): the discard ability goes first.
+    runner
+        .act(GameAction::OrderTriggers {
+            order: vec![discard, 1 - discard],
+        })
+        .expect("ordering succeeds");
+    choose_target(&mut runner, other);
+    assert_eq!(runner.state().stack.len(), 2);
+
+    // Resolve only the top ability: the counter is placed, nothing is exiled yet.
+    runner.pass_both_players();
+    assert_eq!(counters(&runner, other), 1);
+    assert_eq!(counters(&runner, inti), 0);
+    assert_eq!(zone(&runner, top_card), Zone::Library);
+    runner.pass_both_players();
+    assert_eq!(zone(&runner, top_card), Zone::Exile);
+}
+
+#[test]
+fn discard_ability_can_be_placed_above_the_reflexive_ability() {
+    let Board {
+        mut runner,
+        inti,
+        other,
+        top_card,
+    } = attack_and_discard();
+    let discard = discard_index(&runner);
+    runner
+        .act(GameAction::OrderTriggers {
+            order: vec![1 - discard, discard],
+        })
+        .expect("ordering succeeds");
+    choose_target(&mut runner, inti);
+    assert_eq!(runner.state().stack.len(), 2);
+
+    // Resolve only the top ability: the card is exiled, no counter yet.
+    runner.pass_both_players();
+    assert_eq!(zone(&runner, top_card), Zone::Exile);
+    assert_eq!(counters(&runner, inti), 0);
+    runner.pass_both_players();
+    assert_eq!(counters(&runner, inti), 1);
+    assert_eq!(counters(&runner, other), 0);
+}
